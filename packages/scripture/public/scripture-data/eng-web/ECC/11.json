{"verses":[{"number":1,"text":"Cast|strong=\"H7971\"your|strong=\"H5921\"bread|strong=\"H3899\"on|strong=\"H5921\"the|strong=\"H6440\"waters|strong=\"H4325\";  \nfor|strong=\"H3588\"you|strong=\"H3588\"shall|strong=\"H3117\"find|strong=\"H4672\"it|strong=\"H5921\"after|strong=\"H5921\"many|strong=\"H7230\"days|strong=\"H3117\".   \n"},{"number":2,"text":"Give|strong=\"H5414\"a|strong=\"H3068\"portion|strong=\"H2506\"to|strong=\"H1961\"seven|strong=\"H7651\", yes|strong=\"H3588\", even|strong=\"H1571\"to|strong=\"H1961\"eight|strong=\"H8083\";  \nfor|strong=\"H3588\"you|strong=\"H3588\"don’t know|strong=\"H3045\"what|strong=\"H4100\"evil|strong=\"H7451\"will|strong=\"H1961\"be|strong=\"H1961\"on|strong=\"H5921\"the|strong=\"H5921\"earth.   \n"},{"number":3,"text":"If the|strong=\"H5921\"clouds|strong=\"H5645\"are|strong=\"H8033\"full|strong=\"H4390\"of|strong=\"H4390\"rain|strong=\"H1653\", they|strong=\"H8033\"empty|strong=\"H7324\"themselves|strong=\"H4390\"on|strong=\"H5921\"the|strong=\"H5921\"earth;  \nand|strong=\"H6086\"if a|strong=\"H3068\"tree|strong=\"H6086\"falls|strong=\"H5307\"toward|strong=\"H5921\"the|strong=\"H5921\"south|strong=\"H1864\", or|strong=\"H6086\"toward|strong=\"H5921\"the|strong=\"H5921\"north|strong=\"H6828\",  \nin|strong=\"H5921\"the|strong=\"H5921\"place|strong=\"H4725\"where|strong=\"H8033\"the|strong=\"H5921\"tree|strong=\"H6086\"falls|strong=\"H5307\", there|strong=\"H8033\"shall|strong=\"H6828\"it|strong=\"H5921\"be|strong=\"H1933\".   \n"},{"number":4,"text":"He|strong=\"H3808\"who|strong=\"H8104\"observes|strong=\"H8104\"the|strong=\"H7200\"wind|strong=\"H7307\"won’t sow|strong=\"H2232\";  \nand|strong=\"H7200\"he|strong=\"H3808\"who|strong=\"H8104\"regards|strong=\"H8104\"the|strong=\"H7200\"clouds|strong=\"H5645\"won’t reap|strong=\"H7114\".   \n"},{"number":5,"text":"As|strong=\"H6213\"you|strong=\"H3605\"don’t know|strong=\"H3045\"what|strong=\"H4100\"is|strong=\"H4100\"the|strong=\"H3605\"way|strong=\"H1870\"of|strong=\"H1870\"the|strong=\"H3605\"wind|strong=\"H7307\",  \nnor|strong=\"H3808\"how|strong=\"H4100\"the|strong=\"H3605\"bones|strong=\"H6106\"grow in|strong=\"H6213\"the|strong=\"H3605\"womb of|strong=\"H1870\"her|strong=\"H3605\"who|strong=\"H3605\"is|strong=\"H4100\"with|strong=\"H6213\"child|strong=\"H4392\";  \neven|strong=\"H3808\"so|strong=\"H6213\"you|strong=\"H3605\"don’t know|strong=\"H3045\"the|strong=\"H3605\"work|strong=\"H4639\"of|strong=\"H1870\"God|strong=\"H3808\"who|strong=\"H3605\"does|strong=\"H6213\"all|strong=\"H3605\".   \n"},{"number":6,"text":"In|strong=\"H3027\"the|strong=\"H3588\"morning|strong=\"H1242\"sow|strong=\"H2232\"your|strong=\"H3045\"seed|strong=\"H2233\",  \nand|strong=\"H3027\"in|strong=\"H3027\"the|strong=\"H3588\"evening|strong=\"H6153\"don’t withhold|strong=\"H3240\"your|strong=\"H3045\"hand|strong=\"H3027\";  \nfor|strong=\"H3588\"you|strong=\"H3588\"don’t know|strong=\"H3045\"which|strong=\"H2088\"will|strong=\"H3027\"prosper|strong=\"H3787\", whether|strong=\"H3045\"this|strong=\"H2088\"or|strong=\"H2896\"that|strong=\"H3588\",  \nor|strong=\"H2896\"whether|strong=\"H3045\"they|strong=\"H3588\"both|strong=\"H8147\"will|strong=\"H3027\"be|strong=\"H3027\"equally good|strong=\"H2896\".   \n"},{"number":7,"text":"Truly the|strong=\"H7200\"light is|strong=\"H2896\"sweet|strong=\"H4966\",  \nand|strong=\"H5869\"it|strong=\"H7200\"is|strong=\"H2896\"a|strong=\"H3068\"pleasant|strong=\"H2896\"thing|strong=\"H2896\"for|strong=\"H5869\"the|strong=\"H7200\"eyes|strong=\"H5869\"to|strong=\"H7200\"see|strong=\"H7200\"the|strong=\"H7200\"sun|strong=\"H8121\".   \n"},{"number":8,"text":"Yes|strong=\"H3588\", if|strong=\"H3588\"a|strong=\"H3068\"man|strong=\"H3605\"lives|strong=\"H2421\"many|strong=\"H7235\"years|strong=\"H8141\", let|strong=\"H8055\"him|strong=\"H3605\"rejoice|strong=\"H8055\"in|strong=\"H8141\"them|strong=\"H8055\"all|strong=\"H3605\";  \nbut|strong=\"H3588\"let|strong=\"H8055\"him|strong=\"H3605\"remember|strong=\"H2142\"the|strong=\"H3605\"days|strong=\"H3117\"of|strong=\"H3117\"darkness|strong=\"H2822\", for|strong=\"H3588\"they|strong=\"H3588\"shall|strong=\"H3117\"be|strong=\"H1961\"many|strong=\"H7235\".  \nAll|strong=\"H3605\"that|strong=\"H3588\"comes|strong=\"H1961\"is|strong=\"H3117\"vanity|strong=\"H1892\".   \n"},{"number":9,"text":"Rejoice|strong=\"H8055\", young|strong=\"H3117\"man|strong=\"H3605\", in|strong=\"H5921\"your|strong=\"H3605\"youth|strong=\"H3208\",  \nand|strong=\"H1980\"let|strong=\"H8055\"your|strong=\"H3605\"heart|strong=\"H3820\"cheer|strong=\"H3190\"you|strong=\"H3588\"in|strong=\"H5921\"the|strong=\"H3605\"days|strong=\"H3117\"of|strong=\"H3117\"your|strong=\"H3605\"youth|strong=\"H3208\",  \nand|strong=\"H1980\"walk|strong=\"H1980\"in|strong=\"H5921\"the|strong=\"H3605\"ways|strong=\"H1870\"of|strong=\"H3117\"your|strong=\"H3605\"heart|strong=\"H3820\",  \nand|strong=\"H1980\"in|strong=\"H5921\"the|strong=\"H3605\"sight|strong=\"H5869\"of|strong=\"H3117\"your|strong=\"H3605\"eyes|strong=\"H5869\";  \nbut|strong=\"H3588\"know|strong=\"H3045\"that|strong=\"H3588\"for|strong=\"H3588\"all|strong=\"H3605\"these|strong=\"H3605\"things|strong=\"H3605\"God|strong=\"H3190\"will|strong=\"H5869\"bring|strong=\"H1980\"you|strong=\"H3588\"into|strong=\"H1980\"judgment|strong=\"H4941\".   \n"},{"number":10,"text":"Therefore|strong=\"H3588\"remove|strong=\"H5493\"sorrow|strong=\"H3708\"from|strong=\"H5493\"your|strong=\"H3588\"heart|strong=\"H3820\",  \nand|strong=\"H1892\"put|strong=\"H5493\"away|strong=\"H5493\"evil|strong=\"H7451\"from|strong=\"H5493\"your|strong=\"H3588\"flesh|strong=\"H1320\";  \nfor|strong=\"H3588\"youth|strong=\"H3208\"and|strong=\"H1892\"the|strong=\"H3588\"dawn of|strong=\"H3820\"life|strong=\"H7839\"are|strong=\"H1320\"vanity|strong=\"H1892\".   \n"}]}
