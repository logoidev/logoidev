"H7043\"to|strong=\"H5704\"the|strong=\"H5414\"nations|strong=\"H1471\",  \nthat|strong=\"H1471\"you|strong=\"H5414\"may|strong=\"H1961\"be|strong=\"H1961\"my|strong=\"H5414\"salvation|strong=\"H3444\"to|strong=\"H5704\"the|strong=\"H5414\"end|strong=\"H7097\"of|strong=\"H7626\"the|strong=\"H5414\"earth.”   \n"},{"number":7,"text":"The|strong=\"H7200\"LORD|strong=\"H3068\", the|strong=\"H7200\"Redeemer|strong=\"H1350\"of|strong=\"H4428\"Israel|strong=\"H3478\", and|strong=\"H6965\"his|strong=\"H3068\"Holy|strong=\"H6918\"One|strong=\"H6918\",  \nsays|strong=\"H3541\"to|strong=\"H3478\"him|strong=\"H7200\"whom man|strong=\"H5315\"despises|strong=\"H8581\", to|strong=\"H3478\"him|strong=\"H7200\"whom the|strong=\"H7200\"nation|strong=\"H1471\"abhors|strong=\"H8581\", to|strong=\"H3478\"a|strong=\"H3068\"servant|strong=\"H5650\"of|strong=\"H4428\"rulers|strong=\"H8269\":  \n“Kings|strong=\"H4428\"shall|strong=\"H3068\"see|strong=\"H7200\"and|strong=\"H6965\"rise|strong=\"H6965\"up|strong=\"H6965\",  \nprinces|strong=\"H8269\", and|strong=\"H6965\"they|strong=\"H3068\"shall|strong=\"H3068\"worship|strong=\"H7812\",  \nbecause|strong=\"H4616\"of|strong=\"H4428\"the|strong=\"H7200\"LORD|strong=\"H3068\"who|strong=\"H3068\"is|strong=\"H3068\"faithful, even|strong=\"H3068\"the|strong=\"H7200\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H4428\"Israel|strong=\"H3478\", who|strong=\"H3068\"has|strong=\"H3068\"chosen you|strong=\"H7200\".”   \n"},{"number":8,"text":"The|strong=\"H5414\"LORD|strong=\"H3068\"says|strong=\"H3541\", “I|strong=\"H3117\"have|strong=\"H3068\"answered|strong=\"H6030\"you|strong=\"H5414\"in|strong=\"H3068\"an|strong=\"H5414\"acceptable|strong=\"H7522\"time|strong=\"H6256\".  \nI|strong=\"H3117\"have|strong=\"H3068\"helped|strong=\"H5826\"you|strong=\"H5414\"in|strong=\"H3068\"a|strong=\"H3068\"day|strong=\"H3117\"of|strong=\"H3068\"salvation|strong=\"H3444\".  \nI|strong=\"H3117\"will|strong=\"H3068\"preserve|strong=\"H5341\"you|strong=\"H5414\"and|strong=\"H6965\"give|strong=\"H5414\"you|strong=\"H5414\"for|strong=\"H3068\"a|strong=\"H3068\"covenant|strong=\"H1285\"of|strong=\"H3068\"the|strong=\"H5414\"people|strong=\"H5971\",  \nto|strong=\"H3068\"raise|strong=\"H6965\"up|strong=\"H6965\"the|strong=\"H5414\"land|strong=\"H5159\", to|strong=\"H3068\"make|strong=\"H5414\"them|strong=\"H5414\"inherit|strong=\"H5157\"the|strong=\"H5414\"desolate|strong=\"H8074\"heritage|strong=\"H5159\",   \n"},{"number":9,"text":"saying to|strong=\"H3318\"those|strong=\"H3605\"who|strong=\"H3605\"are|strong=\"H1870\"bound, ‘Come|strong=\"H3318\"out|strong=\"H3318\"!’;  \nto|strong=\"H3318\"those|strong=\"H3605\"who|strong=\"H3605\"are|strong=\"H1870\"in|strong=\"H5921\"darkness|strong=\"H2822\", ‘Show|strong=\"H1540\"yourselves|strong=\"H3605\"!’  \n“They|strong=\"H5921\"shall|strong=\"H2822\"feed|strong=\"H7462\"along|strong=\"H5921\"the|strong=\"H3605\"paths|strong=\"H1870\",  \nand|strong=\"H1870\"their|strong=\"H3605\"pasture|strong=\"H4830\"shall|strong=\"H2822\"be|strong=\"H1870\"on|strong=\"H5921\"all|strong=\"H3605\"treeless heights|strong=\"H8205\".   \n"},{"number":10,"text":"They|strong=\"H3588\"shall|strong=\"H3808\"not|strong=\"H3808\"hunger|strong=\"H7456\"nor|strong=\"H3808\"thirst|strong=\"H6770\";  \nneither|strong=\"H3808\"shall|strong=\"H3808\"the|strong=\"H5921\"heat|strong=\"H8273\"nor|strong=\"H3808\"sun|strong=\"H8121\"strike|strong=\"H5221\"them|strong=\"H5921\",  \nfor|strong=\"H3588\"he|strong=\"H3588\"who|strong=\"H3588\"has|strong=\"H3588\"mercy|strong=\"H7355\"on|strong=\"H5921\"them|strong=\"H5921\"will|strong=\"H3808\"lead|strong=\"H5090\"them|strong=\"H5921\".  \nHe|strong=\"H3588\"will|strong=\"H3808\"guide|strong=\"H5095\"them|strong=\"H5921\"by|strong=\"H5921\"springs|strong=\"H4002\"of|strong=\"H4325\"water|strong=\"H4325\".   \n"},{"number":11,"text":"I|strong=\"H7760\"will|strong=\"H2022\"make|strong=\"H7760\"all|strong=\"H3605\"my|strong=\"H3605\"mountains|strong=\"H2022\"a|strong=\"H3068\"road|strong=\"H1870\",  \nand|strong=\"H1870\"my|strong=\"H3605\"highways|strong=\"H4546\"shall|strong=\"H2022\"be|strong=\"H1870\"exalted|strong=\"H7311\".   \n"},{"number":12,"text":"Behold|strong=\"H2009\", these shall|strong=\"H6828\"come|strong=\"H7350\"from|strong=\"H7350\"afar|strong=\"H7350\",  \nand|strong=\"H3220\"behold|strong=\"H2009\", these from|strong=\"H7350\"the|strong=\"H2009\"north|strong=\"H6828\"and|strong=\"H3220\"from|strong=\"H7350\"the|strong=\"H2009\"west|strong=\"H3220\",  \nand|strong=\"H3220\"these from|strong=\"H7350\"the|strong=\"H2009\"land of|strong=\"H3220\"Sinim|strong=\"H5515\".”   \n"},{"number":13,"text":"Sing|strong=\"H7442\", heavens|strong=\"H8064\", and|strong=\"H3068\"be|strong=\"H3068\"joyful|strong=\"H7440\", earth|strong=\"H8064\"!  \nBreak|strong=\"H6476\"out|strong=\"H7442\"into|strong=\"H6476\"singing|strong=\"H7440\", mountains|strong=\"H2022\"!  \nFor|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"has|strong=\"H3068\"comforted|strong=\"H5162\"his|strong=\"H3068\"people|strong=\"H5971\",  \nand|strong=\"H3068\"will|strong=\"H3068\"have|strong=\"H7355\"compassion|strong=\"H7355\"on|strong=\"H3068\"his|strong=\"H3068\"afflicted|strong=\"H6041\".   \n"},{"number":14,"text":"But|strong=\"H5800\"Zion|strong=\"H6726\"said, “The|strong=\"H3068\"LORD|strong=\"H3068\"has|strong=\"H3068\"forsaken|strong=\"H5800\"me|strong=\"H7911\",  \nand|strong=\"H3068\"the|strong=\"H3068\"Lord|strong=\"H3068\"has|strong=\"H3068\"forgotten|strong=\"H7911\"me|strong=\"H7911\".”   \n"},{"number":15,"text":"“Can|strong=\"H3808\"a|strong=\"H3068\"woman forget|strong=\"H7911\"her|strong=\"H7911\"nursing|strong=\"H5764\"child|strong=\"H1121\",  \nthat|strong=\"H1121\"she|strong=\"H1571\"should not|strong=\"H3808\"have|strong=\"H7355\"compassion|strong=\"H7355\"on|strong=\"H7355\"the|strong=\"H7911\"son|strong=\"H1121\"of|strong=\"H1121\"her|strong=\"H7911\"womb?  \nYes|strong=\"H1571\", these may|strong=\"H1121\"forget|strong=\"H7911\",  \nyet|strong=\"H1571\"I|strong=\"H3808\"will|strong=\"H1571\"not|strong=\"H3808\"forget|strong=\"H7911\"you|strong=\"H3808\"!   \n"},{"number":16,"text":"Behold|strong=\"H2005\", I|strong=\"H2005\"have|strong=\"H5921\"engraved you|strong=\"H5921\"on|strong=\"H5921\"the|strong=\"H5921\"palms|strong=\"H3709\"of|strong=\"H2346\"my|strong=\"H5921\"hands|strong=\"H3709\".  \nYour|strong=\"H5921\"walls|strong=\"H2346\"are|strong=\"H3709\"continually|strong=\"H8548\"before|strong=\"H5048\"me|strong=\"H5921\".   \n"},{"number":17,"text":"Your|strong=\"H4480\"children|strong=\"H1121\"hurry|strong=\"H4116\".  \nYour|strong=\"H4480\"destroyers|strong=\"H2040\"and|strong=\"H1121\"those|strong=\"H4480\"who|strong=\"H1121\"devastated|strong=\"H2717\"you|strong=\"H4480\"will|strong=\"H1121\"leave|strong=\"H3318\"you|strong=\"H4480\".   \n"},{"number":18,"text":"Lift|strong=\"H5375\"up|strong=\"H5375\"your|strong=\"H3068\"eyes|strong=\"H5869\"all|strong=\"H3605\"around|strong=\"H5439\", and|strong=\"H3068\"see|strong=\"H7200\":  \nall|strong=\"H3605\"these|strong=\"H3605\"gather|strong=\"H6908\"themselves|strong=\"H6908\"together|strong=\"H6908\", and|strong=\"H3068\"come to|strong=\"H3068\"you|strong=\"H3588\".  \nAs|strong=\"H3068\"I|strong=\"H3588\"live|strong=\"H2416\",” says|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\", “you|strong=\"H3588\"shall|strong=\"H3068\"surely|strong=\"H3588\"clothe|strong=\"H3847\"yourself|strong=\"H3847\"with|strong=\"H3847\"them|strong=\"H7200\"all|strong=\"H3605\"as|strong=\"H3068\"with|strong=\"H3847\"an|strong=\"H5375\"ornament|strong=\"H5716\",  \nand|strong=\"H3068\"dress|strong=\"H3847\"yourself|strong=\"H3847\"with|strong=\"H3847\"them|strong=\"H7200\", like|strong=\"H3068\"a|strong=\"H3068\"bride|strong=\"H3618\".   \n"},{"number":19,"text":"“For|strong=\"H3588\", as|strong=\"H3588\"for|strong=\"H3588\"your|strong=\"H3588\"waste|strong=\"H2723\"and|strong=\"H3427\"your|strong=\"H3588\"desolate|strong=\"H8074\"places|str