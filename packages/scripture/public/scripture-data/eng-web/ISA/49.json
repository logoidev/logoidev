rong=\"H5921\"Lord|strong=\"H3069\"GOD|strong=\"H3068\"says|strong=\"H3541\", “Behold|strong=\"H2009\", I|strong=\"H3541\"will|strong=\"H1471\"lift|strong=\"H5375\"up|strong=\"H5375\"my|strong=\"H5921\"hand|strong=\"H3027\"to|strong=\"H5921\"the|strong=\"H5921\"nations|strong=\"H1471\",  \nand|strong=\"H1121\"lift|strong=\"H5375\"up|strong=\"H5375\"my|strong=\"H5921\"banner|strong=\"H5251\"to|strong=\"H5921\"the|strong=\"H5921\"peoples|strong=\"H5971\".  \nThey|strong=\"H5921\"shall|strong=\"H1121\"bring|strong=\"H5375\"your|strong=\"H5921\"sons|strong=\"H1121\"in|strong=\"H5921\"their|strong=\"H5375\"bosom|strong=\"H2684\",  \nand|strong=\"H1121\"your|strong=\"H5921\"daughters|strong=\"H1323\"shall|strong=\"H1121\"be|strong=\"H3027\"carried|strong=\"H5375\"on|strong=\"H5921\"their|strong=\"H5375\"shoulders|strong=\"H3802\".   \n"},{"number":23,"text":"Kings|strong=\"H4428\"shall|strong=\"H3068\"be|strong=\"H1961\"your|strong=\"H3068\"foster fathers,  \nand|strong=\"H3068\"their|strong=\"H3068\"queens|strong=\"H8282\"your|strong=\"H3068\"nursing|strong=\"H3243\"mothers|strong=\"H3243\".  \nThey|strong=\"H3588\"will|strong=\"H3068\"bow|strong=\"H7812\"down|strong=\"H7812\"to|strong=\"H3068\"you|strong=\"H3588\"with|strong=\"H3068\"their|strong=\"H3068\"faces to|strong=\"H3068\"the|strong=\"H3588\"earth|strong=\"H6083\",  \nand|strong=\"H3068\"lick|strong=\"H3897\"the|strong=\"H3588\"dust|strong=\"H6083\"of|strong=\"H4428\"your|strong=\"H3068\"feet|strong=\"H7272\".  \nThen|strong=\"H1961\"you|strong=\"H3588\"will|strong=\"H3068\"know|strong=\"H3045\"that|strong=\"H3588\"I|strong=\"H3588\"am|strong=\"H1961\"the|strong=\"H3588\"LORD|strong=\"H3068\";  \nand|strong=\"H3068\"those|strong=\"H1961\"who|strong=\"H3068\"wait|strong=\"H6960\"for|strong=\"H3588\"me|strong=\"H1961\"won’t be|strong=\"H1961\"disappointed.”   \n"},{"number":24,"text":"Shall|strong=\"H6662\"the|strong=\"H3947\"plunder|strong=\"H4455\"be|strong=\"H6662\"taken|strong=\"H3947\"from|strong=\"H3947\"the|strong=\"H3947\"mighty|strong=\"H1368\",  \nor the|strong=\"H3947\"lawful|strong=\"H6662\"captives|strong=\"H7628\"be|strong=\"H6662\"delivered|strong=\"H4422\"?   \n"},{"number":25,"text":"But|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"says|strong=\"H3541\", “Even|strong=\"H1571\"the|strong=\"H3588\"captives|strong=\"H7628\"of|strong=\"H1121\"the|strong=\"H3588\"mighty|strong=\"H1368\"shall|strong=\"H3068\"be|strong=\"H3068\"taken|strong=\"H3947\"away|strong=\"H3947\",  \nand|strong=\"H1121\"the|strong=\"H3588\"plunder|strong=\"H4455\"retrieved from|strong=\"H1121\"the|strong=\"H3588\"fierce,  \nfor|strong=\"H3588\"I|strong=\"H3588\"will|strong=\"H3068\"contend|strong=\"H7378\"with|strong=\"H3068\"him|strong=\"H3947\"who|strong=\"H3068\"contends|strong=\"H3401\"with|strong=\"H3068\"you|strong=\"H3588\"and|strong=\"H1121\"I|strong=\"H3588\"will|strong=\"H3068\"save|strong=\"H3467\"your|strong=\"H3068\"children|strong=\"H1121\".   \n"},{"number":26,"text":"I|strong=\"H3588\"will|strong=\"H3068\"feed those|strong=\"H3605\"who|strong=\"H3605\"oppress|strong=\"H3238\"you|strong=\"H3588\"with|strong=\"H3068\"their|strong=\"H3605\"own flesh|strong=\"H1320\";  \nand|strong=\"H3068\"they|strong=\"H3588\"will|strong=\"H3068\"be|strong=\"H3068\"drunk|strong=\"H7937\"on|strong=\"H3068\"their|strong=\"H3605\"own blood|strong=\"H1818\", as|strong=\"H3068\"with|strong=\"H3068\"sweet|strong=\"H6071\"wine|strong=\"H6071\".  \nThen|strong=\"H3588\"all|strong=\"H3605\"flesh|strong=\"H1320\"shall|strong=\"H3068\"know|strong=\"H3045\"that|strong=\"H3588\"I|strong=\"H3588\", the|strong=\"H3605\"LORD|strong=\"H3068\", am|strong=\"H3068\"your|strong=\"H3068\"Savior|strong=\"H3467\"and|strong=\"H3068\"your|strong=\"H3068\"Redeemer|strong=\"H1350\", the|strong=\"H3605\"Mighty One|strong=\"H3605\"of|strong=\"H3068\"Jacob|strong=\"H3290\".”   \n"}]}
