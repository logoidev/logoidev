{"verses":[{"number":1,"text":"Let|strong=\"H4994\"me|strong=\"H4994\"sing|strong=\"H7891\"for|strong=\"H1121\"my|strong=\"H1961\"well beloved|strong=\"H1730\"a|strong=\"H3068\"song|strong=\"H7892\"of|strong=\"H1121\"my|strong=\"H1961\"beloved|strong=\"H1730\"about|strong=\"H1961\"his|strong=\"H1961\"vineyard|strong=\"H3754\".  \nMy|strong=\"H1961\"beloved|strong=\"H1730\"had|strong=\"H1961\"a|strong=\"H3068\"vineyard|strong=\"H3754\"on|strong=\"H1961\"a|strong=\"H3068\"very fruitful|strong=\"H1121\"hill|strong=\"H7161\".   \n"},{"number":2,"text":"He|strong=\"H6213\"dug|strong=\"H5823\"it|strong=\"H6213\"up|strong=\"H1129\",  \ngathered|strong=\"H6960\"out|strong=\"H2672\"its|strong=\"H6213\"stones|strong=\"H5619\",  \nplanted|strong=\"H5193\"it|strong=\"H6213\"with|strong=\"H6213\"the|strong=\"H6213\"choicest|strong=\"H8321\"vine|strong=\"H8321\",  \nbuilt|strong=\"H1129\"a|strong=\"H3068\"tower|strong=\"H4026\"in|strong=\"H6213\"the|strong=\"H6213\"middle|strong=\"H8432\"of|strong=\"H8432\"it|strong=\"H6213\",  \nand|strong=\"H6213\"also|strong=\"H1571\"cut|strong=\"H2672\"out|strong=\"H2672\"a|strong=\"H3068\"wine|strong=\"H3342\"press|strong=\"H3342\"in|strong=\"H6213\"it|strong=\"H6213\".  \nHe|strong=\"H6213\"looked|strong=\"H6960\"for|strong=\"H6213\"it|strong=\"H6213\"to|strong=\"H6213\"yield|strong=\"H6213\"grapes|strong=\"H6025\",  \nbut|strong=\"H1571\"it|strong=\"H6213\"yielded|strong=\"H6213\"wild|strong=\"H6213\"grapes|strong=\"H6025\".   \n"},{"number":3,"text":"“Now|strong=\"H6258\", inhabitants|strong=\"H3427\"of|strong=\"H3427\"Jerusalem|strong=\"H3389\"and|strong=\"H3063\"men of|strong=\"H3427\"Judah|strong=\"H3063\",  \nplease|strong=\"H4994\"judge|strong=\"H8199\"between|strong=\"H8199\"me|strong=\"H4994\"and|strong=\"H3063\"my|strong=\"H6258\"vineyard|strong=\"H3754\".   \n"},{"number":4,"text":"What|strong=\"H4100\"could|strong=\"H4100\"have|strong=\"H3808\"been|strong=\"H3808\"done|strong=\"H6213\"more|strong=\"H5750\"to|strong=\"H6213\"my|strong=\"H6213\"vineyard|strong=\"H3754\", that|strong=\"H6213\"I|strong=\"H3808\"have|strong=\"H3808\"not|strong=\"H3808\"done|strong=\"H6213\"in|strong=\"H6213\"it|strong=\"H6213\"?  \nWhy|strong=\"H4100\", when|strong=\"H6213\"I|strong=\"H3808\"looked|strong=\"H6960\"for|strong=\"H6213\"it|strong=\"H6213\"to|strong=\"H6213\"yield|strong=\"H6213\"grapes|strong=\"H6025\", did|strong=\"H6213\"it|strong=\"H6213\"yield|strong=\"H6213\"wild|strong=\"H6213\"grapes|strong=\"H6025\"?   \n"},{"number":5,"text":"Now|strong=\"H6258\"I|strong=\"H6258\"will|strong=\"H1961\"tell|strong=\"H3045\"you|strong=\"H6213\"what|strong=\"H3045\"I|strong=\"H6258\"will|strong=\"H1961\"do|strong=\"H6213\"to|strong=\"H1961\"my|strong=\"H3045\"vineyard|strong=\"H3754\".  \nI|strong=\"H6258\"will|strong=\"H1961\"take|strong=\"H5493\"away|strong=\"H5493\"its|strong=\"H6213\"hedge|strong=\"H4881\", and|strong=\"H6213\"it|strong=\"H6213\"will|strong=\"H1961\"be|strong=\"H1961\"eaten|strong=\"H1197\"up|strong=\"H1197\".  \nI|strong=\"H6258\"will|strong=\"H1961\"break|strong=\"H6555\"down|strong=\"H6555\"its|strong=\"H6213\"wall|strong=\"H1447\", and|strong=\"H6213\"it|strong=\"H6213\"will|strong=\"H1961\"be|strong=\"H1961\"trampled|strong=\"H4823\"down|strong=\"H6555\".   \n"},{"number":6,"text":"I|strong=\"H5921\"will|strong=\"H3808\"lay|strong=\"H7896\"it|strong=\"H5921\"a|strong=\"H3068\"wasteland.  \nIt|strong=\"H5921\"won’t be|strong=\"H3808\"pruned|strong=\"H2168\"or|strong=\"H3808\"hoed|strong=\"H5737\",  \nbut|strong=\"H3808\"it|strong=\"H5921\"will|strong=\"H3808\"grow|strong=\"H5927\"briers|strong=\"H8068\"and|strong=\"H5927\"thorns|strong=\"H7898\".  \nI|strong=\"H5921\"will|strong=\"H3808\"also|strong=\"H5645\"command|strong=\"H6680\"the|strong=\"H5921\"clouds|strong=\"H5645\"that|strong=\"H3808\"they|strong=\"H3808\"rain|strong=\"H4306\"no|strong=\"H3808\"rain|strong=\"H4306\"on|strong=\"H5921\"it|strong=\"H5921\".”   \n"},{"number":7,"text":"For|strong=\"H3588\"the|strong=\"H3588\"vineyard|strong=\"H3754\"of|strong=\"H1004\"the|strong=\"H3588\"LORD|strong=\"H3068\"of|strong=\"H1004\"Armies|strong=\"H6635\"is|strong=\"H3068\"the|strong=\"H3588\"house|strong=\"H1004\"of|strong=\"H1004\"Israel|strong=\"H3478\",  \nand|strong=\"H3063\"the|strong=\"H3588\"men|strong=\"H3478\"of|strong=\"H1004\"Judah|strong=\"H3063\"his|strong=\"H3068\"pleasant|strong=\"H8191\"plant|strong=\"H5194\".  \nHe|strong=\"H3588\"looked|strong=\"H6960\"for|strong=\"H3588\"justice|strong=\"H4941\", but|strong=\"H3588\"behold|strong=\"H2009\", oppression|strong=\"H4939\",  \nfor|strong=\"H3588\"righteousness|strong=\"H6666\", but|strong=\"H3588\"behold|strong=\"H2009\", a|strong=\"H3068\"cry|strong=\"H6818\"of|strong=\"H1004\"distress|strong=\"H6818\".   \n"},{"number":8,"text":"Woe|strong=\"H1945\"to|strong=\"H5704\"those|strong=\"H1945\"who|strong=\"H3427\"join|strong=\"H7126\"house|strong=\"H1004\"to|strong=\"H5704\"house|strong=\"H1004\",  \nwho|strong=\"H3427\"lay|strong=\"H7126\"field|strong=\"H7704\"to|strong=\"H5704\"field|strong=\"H7704\", until|strong=\"H5704\"there|strong=\"H3427\"is|strong=\"H4725\"no|strong=\"H5060\"room|strong=\"H1004\",  \nand|strong=\"H1004\"you|strong=\"H5704\"are|strong=\"H1004\"made|strong=\"H7126\"to|strong=\"H5704\"dwell|strong=\"H3427\"alone in|strong=\"H3427\"the|strong=\"H5704\"middle|strong=\"H7130\"of|strong=\"H1004\"the|strong=\"H5704\"land|strong=\"H7704\"!   \n"},{"number":9,"text":"In|strong=\"H3427\"my|strong=\"H3068\"ears, the|strong=\"H3068\"LORD|strong=\"H3068\"of|strong=\"H1004\"Armies|strong=\"H6635\"says: “Surely|strong=\"H1961\"many|strong=\"H7227\"houses|strong=\"H1004\"will|strong=\"H3068\"be|strong=\"H1961\"desolate|strong=\"H8047\",  \neven|strong=\"H3808\"great|strong=\"H1419\"and|strong=\"H3068\"beautiful|strong=\"H2896\", unoccupied.   \n"},{"number":10,"text":"For|strong=\"H3588\"ten|strong=\"H6235\"acres|strong=\"H6776\"of|strong=\"H2233\"vineyard|strong=\"H3754\"shall|strong=\"H2233\"yield|strong=\"H6213\"one|strong=\"H6213\"bath|strong=\"H1324\",  \nand|strong=\"H6213\"a|strong=\"H3068\"homer|strong=\"H2563\"of|strong=\"H2233\"seed|strong=\"H2233\"shall|strong=\"H2233\"yield|strong=\"H6213\"an|strong=\"H6213\"ephah.”   \n"},{"number":11,"text":"Woe|strong=\"H1945\"to|strong=\"H1242\"those|strong=\"H1945\"who|strong=\"H1945\"rise|strong=\"H7925\"up|strong=\"H7925\"early|strong=\"H7925\"in|strong=\"H3196\"the|strong=\"H7291\"morning|strong=\"H1242\", that|strong=\"H3196\"they|strong=\"H1242\"may|strong=\"H3196\"follow|strong=\"H7291\"strong|strong=\"H7941\"drink|strong=\"H7941\",  \nwho|strong=\"H1945\"stay late into the|strong=\"H7291\"night|strong=\"H5399\", until wine|strong=\"H3196\"inflames them|strong=\"H7291\"!   \n"},{"number":12,"text":"The|strong=\"H7200\"harp|strong=\"H3658\", lyre|strong=\"H3658\", tambourine|strong=\"H8596\", and|strong=\"H3068\"flute|strong=\"H2485\", with|strong=\"H3068\"wine|strong=\"H3196\", are|strong=\"H3027\"at|strong=\"H3068\"their|strong=\"H3068\"feasts|strong=\"H4960\";  \nbut|strong=\"H3808\"they|strong=\"H3068\"don’t respect|strong=\"H7200\"the|strong=\"H7200\"work|strong=\"H4639\"of|strong=\"H3068\"the|strong=\"H7200\"LORD|strong=\"H3068\",  \nneither|strong=\"H3808\"have|strong=\"H1961\"they|strong=\"H3068\"considered|strong=\"H7200\"the|strong=\"H7200\"operation|strong=\"H4639\"of|strong=\"H3068\"his|strong=\"H3068\"hands|strong=\"H3027\".   \n"},{"number":13,"text":"Therefore|strong=\"H3651\"my|strong=\"H3651\"people|strong=\"H5971\"go|strong=\"H1540\"into|strong=\"H1540\"captivity|strong=\"H1540\"for|strong=\"H3651\"lack|strong=\"H1097\"of|strong=\"H5971\"knowledge|strong=\"H1847\".  \nTheir|strong=\"H1540\"honorable|strong=\"H3519\"men|strong=\"H4962\"are|strong=\"H5971\"famished|strong=\"H7458\",  \nand|strong=\"H5971\"their|strong=\"H1540\"multitudes|strong=\"H1995\"are|strong=\"H5971\"parched|strong=\"H6704\"with|strong=\"H5971\"thirst|strong=\"H6772\".   \n"},{"number":14,"text":"Therefore|strong=\"H3651\"Sheol|strong=\"H7585\"has|strong=\"H5315\"enlarged|strong=\"H7337\"its|strong=\"H7337\"desire|strong=\"H5315\",  \nand|strong=\"H2706\"opened|strong=\"H6473\"its|strong=\"H7337\"mouth|strong=\"H6310\"without|strong=\"H1097\"measure|strong=\"H2706\";  \nand|strong=\"H2706\"their|strong=\"H3381\"glory|strong=\"H1926\", their|strong=\"H3381\"multitude|strong=\"H1995\", their|strong=\"H3381\"pomp|strong=\"H7588\", and|strong=\"H2706\"he|strong=\"H3651\"who|strong=\"H5315\"rejoices among them|strong=\"H3381\", descend|strong=\"H3381\"into|strong=\"H3381\"it|strong=\"H3651\".   \n"},{"number":15,"text":"So man|strong=\"H8213\"is|strong=\"H5869\"brought|strong=\"H5869\"low|strong=\"H8213\",  \nmankind is|strong=\"H5869\"humbled|strong=\"H7817\",  \nand|strong=\"H5869\"the|strong=\"H5869\"eyes|strong=\"H5869\"of|strong=\"H5869\"the|strong=\"H5869\"arrogant ones are|strong=\"H5869\"humbled|strong=\"H7817\";   \n"},{"number":16,"text":"but|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\"of|strong=\"H3068\"Armies|strong=\"H6635\"is|strong=\"H3068\"exalted|strong=\"H1361\"in|strong=\"H3068\"justice|strong=\"H4941\",  \nand|strong=\"H3068\"God|strong=\"H3068\"the|strong=\"H3068\"Holy|strong=\"H6918\"One|strong=\"H6918\"is|strong=\"H3068\"sanctified|strong=\"H6942\"in|strong=\"H3068\"righteousness|strong=\"H6666\".   \n"},{"number":17,"text":"Then the|strong=\"H7462\"lambs|strong=\"H3532\"will|strong=\"H2723\"graze|strong=\"H7462\"as|strong=\"H3532\"in|strong=\"H1481\"their|strong=\"H7462\"pasture|strong=\"H7462\",  \nand|strong=\"H3532\"strangers|strong=\"H1481\"will|strong=\"H2723\"eat|strong=\"H7462\"the|strong=\"H7462\"ruins|strong=\"H2723\"of|strong=\"H7462\"the|strong=\"H7462\"rich.   \n"},{"number":18,"text":"Woe|strong=\"H1945\"to|strong=\"H5771\"those|strong=\"H1945\"who|strong=\"H1945\"draw|strong=\"H4900\"iniquity|strong=\"H5771\"with|strong=\"H5771\"cords|strong=\"H5688\"of|strong=\"H2403\"falsehood|strong=\"H7723\",  \nand|strong=\"H2403\"wickedness as|strong=\"H2403\"with|strong=\"H5771\"cart|strong=\"H5699\"rope|strong=\"H2256\",   \n"},{"number":19,"text":"who|strong=\"H3478\"say|strong=\"H3478\", “Let him|strong=\"H7200\"make|strong=\"H3045\"haste|strong=\"H4116\", let him|strong=\"H7200\"hasten|strong=\"H2363\"his|strong=\"H7200\"work|strong=\"H4639\", that|strong=\"H3045\"we|strong=\"H3068\"may|strong=\"H3478\"see|strong=\"H7200\"it|strong=\"H7126\";  \nlet the|strong=\"H7200\"counsel|strong=\"H6098\"of|strong=\"H6918\"the|strong=\"H7200\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H6918\"Israel|strong=\"H3478\"draw|strong=\"H7126\"near|strong=\"H7126\"and|strong=\"H3478\"come|strong=\"H7126\",  \nthat|strong=\"H3045\"we|strong=\"H3068\"may|strong=\"H3478\"know|strong=\"H3045\"it|strong=\"H7126\"!”   \n"},{"number":20,"text":"Woe|strong=\"H1945\"to|strong=\"H2896\"those|strong=\"H1945\"who|strong=\"H2896\"call evil|strong=\"H7451\"good|strong=\"H2896\", and|strong=\"H2896\"good|strong=\"H2896\"evil|strong=\"H7451\";  \nwho|strong=\"H2896\"put|strong=\"H7760\"darkness|strong=\"H2822\"for|strong=\"H7451\"light|strong=\"H7760\",  \nand|strong=\"H2896\"light|strong=\"H7760\"for|strong=\"H7451\"darkness|strong=\"H2822\";  \nwho|strong=\"H2896\"put|strong=\"H7760\"bitter|strong=\"H4751\"for|strong=\"H7451\"sweet|strong=\"H4966\",  \nand|strong=\"H2896\"sweet|strong=\"H4966\"for|strong=\"H7451\"bitter|strong=\"H4751\"!   \n"},{"number":21,"text":"Woe|strong=\"H1945\"to|strong=\"H6440\"those|strong=\"H1945\"who|strong=\"H2450\"are|strong=\"H5869\"wise|strong=\"H2450\"in|strong=\"H6440\"their|strong=\"H6440\"own|strong=\"H6440\"eyes|strong=\"H5869\",  \nand|strong=\"H5869\"prudent in|strong=\"H6440\"their|strong=\"H6440\"own|strong=\"H6440\"sight|strong=\"H5869\"!   \n"},{"number":22,"text":"Woe|strong=\"H1945\"to|strong=\"H2428\"those|strong=\"H1945\"who|strong=\"H1368\"are|strong=\"H1368\"mighty|strong=\"H1368\"to|strong=\"H2428\"drink|strong=\"H8354\"wine|strong=\"H3196\",  \nand|strong=\"H8354\"champions at|strong=\"H2428\"mixing|strong=\"H4537\"strong|strong=\"H7941\"drink|strong=\"H8354\";   \n"},{"number":23,"text":"who|strong=\"H6662\"acquit|strong=\"H6663\"the|strong=\"H4480\"guilty|strong=\"H7563\"for|strong=\"H4480\"a|strong=\"H3068\"bribe|strong=\"H7810\",  \nbut|strong=\"H7563\"deny justice|strong=\"H6666\"for|strong=\"H4480\"the|strong=\"H4480\"innocent|strong=\"H6666\"!   \n"},{"number":24,"text":"Therefore|strong=\"H3651\"as|strong=\"H1961\"the|strong=\"H3588\"tongue|strong=\"H3956\"of|strong=\"H3068\"fire devours the|strong=\"H3588\"stubble|strong=\"H7179\",  \nand|strong=\"H3478\"as|strong=\"H1961\"the|strong=\"H3588\"dry|strong=\"H2842\"grass|strong=\"H2842\"sinks down|strong=\"H7503\"in|strong=\"H3478\"the|strong=\"H3588\"flame|strong=\"H3852\",  \nso|strong=\"H3651\"their|strong=\"H3068\"root|strong=\"H8328\"shall|strong=\"H3068\"be|strong=\"H1961\"as|strong=\"H1961\"rottenness|strong=\"H4716\",  \nand|strong=\"H3478\"their|strong=\"H3068\"blossom|strong=\"H6525\"shall|strong=\"H3068\"go|strong=\"H5927\"up|strong=\"H5927\"as|strong=\"H1961\"dust,  \nbecause|strong=\"H3588\"they|strong=\"H3588\"have|strong=\"H1961\"rejected|strong=\"H3988\"the|strong=\"H3588\"law|strong=\"H8451\"of|strong=\"H3068\"the|strong=\"H3588\"LORD|strong=\"H3068\"of|strong=\"H3068\"Armies|strong=\"H6635\",  \nand|strong=\"H3478\"despised|strong=\"H3988\"the|strong=\"H3588\"word|strong=\"H3956\"of|strong=\"H3068\"the|strong=\"H3588\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H3068\"Israel|strong=\"H3478\".   \n"},{"number":25,"text":"Therefore|strong=\"H3651\"the|strong=\"H3605\"LORD|strong=\"H3068\"’s anger burns|strong=\"H2734\"against|strong=\"H5921\"his|strong=\"H3605\"people|strong=\"H5971\",  \nand|strong=\"H3068\"he|strong=\"H3651\"has|strong=\"H3068\"stretched|strong=\"H5186\"out|strong=\"H5186\"his|strong=\"H3605\"hand|strong=\"H3027\"against|strong=\"H5921\"them|strong=\"H5921\"and|strong=\"H3068\"has|strong=\"H3068\"struck|strong=\"H5221\"them|strong=\"H5921\".  \nThe|strong=\"H3605\"mountains|strong=\"H2022\"tremble|strong=\"H7264\",  \nand|strong=\"H3068\"their|strong=\"H3605\"dead|strong=\"H5038\"bodies|strong=\"H5038\"are|strong=\"H5971\"as|strong=\"H1961\"refuse|strong=\"H7725\"in|strong=\"H5921\"the|strong=\"H3605\"middle|strong=\"H7130\"of|strong=\"H3068\"the|strong=\"H3605\"streets|strong=\"H2351\".  \nFor|strong=\"H5921\"all|strong=\"H3605\"this|strong=\"H2063\", his|strong=\"H3605\"anger is|strong=\"H3068\"not|strong=\"H3808\"turned|strong=\"H7725\"away|strong=\"H7725\",  \nbut|strong=\"H3808\"his|strong=\"H3605\"hand|strong=\"H3027\"is|strong=\"H3068\"still|strong=\"H5750\"stretched|strong=\"H5186\"out|strong=\"H5186\".   \n"},{"number":26,"text":"He|strong=\"H2009\"will|strong=\"H1471\"lift|strong=\"H5375\"up|strong=\"H5375\"a|strong=\"H3068\"banner|strong=\"H5251\"to|strong=\"H1471\"the|strong=\"H5375\"nations|strong=\"H1471\"from|strong=\"H1471\"far|strong=\"H7350\"away|strong=\"H5375\",  \nand|strong=\"H1471\"he|strong=\"H2009\"will|strong=\"H1471\"whistle|strong=\"H8319\"for|strong=\"H5375\"them|strong=\"H5375\"from|strong=\"H1471\"the|strong=\"H5375\"end|strong=\"H7097\"of|strong=\"H7097\"the|strong=\"H5375\"earth.  \nBehold|strong=\"H2009\", they|strong=\"H5375\"will|strong=\"H1471\"come|strong=\"H7350\"speedily|strong=\"H4120\"and|strong=\"H1471\"swiftly|strong=\"H7031\".   \n"},{"number":27,"text":"No|strong=\"H3808\"one|strong=\"H3808\"shall|strong=\"H3808\"be|strong=\"H3808\"weary|strong=\"H5889\"nor|strong=\"H3808\"stumble|strong=\"H3782\"among|strong=\"H3808\"them|strong=\"H5423\";  \nno|strong=\"H3808\"one|strong=\"H3808\"shall|strong=\"H3808\"slumber|strong=\"H5123\"nor|strong=\"H3808\"sleep|strong=\"H3462\",  \nneither|strong=\"H3808\"shall|strong=\"H3808\"the|strong=\"H6605\"belt of|strong=\"H3808\"their|strong=\"H3808\"waist|strong=\"H2504\"be|strong=\"H3808\"untied,  \nnor|strong=\"H3808\"the|strong=\"H6605\"strap|strong=\"H8288\"of|strong=\"H3808\"their|strong=\"H3808\"sandals|strong=\"H5275\"be|strong=\"H3808\"broken|strong=\"H5423\",   \n"},{"number":28,"text":"whose|strong=\"H3605\"arrows|strong=\"H2671\"are|strong=\"H5483\"sharp|strong=\"H8150\",  \nand|strong=\"H5483\"all|strong=\"H3605\"their|strong=\"H3605\"bows|strong=\"H7198\"bent|strong=\"H1869\".  \nTheir|strong=\"H3605\"horses|strong=\"H5483\"’ hoofs|strong=\"H6541\"will|strong=\"H7198\"be|strong=\"H3605\"like|strong=\"H2803\"flint|strong=\"H6862\",  \nand|strong=\"H5483\"their|strong=\"H3605\"wheels|strong=\"H1534\"like|strong=\"H2803\"a|strong=\"H3068\"whirlwind|strong=\"H5492\".   \n"},{"number":29,"text":"Their|strong=\"H5337\"roaring|strong=\"H7580\"will be like|strong=\"H7580\"a|strong=\"H3068\"lioness|strong=\"H3833\".  \nThey will roar|strong=\"H7580\"like|strong=\"H7580\"young|strong=\"H3715\"lions|strong=\"H3715\".  \nYes, they shall roar|strong=\"H7580\",  \nand|strong=\"H3833\"seize their|strong=\"H5337\"prey|strong=\"H2964\"and|strong=\"H3833\"carry it off|strong=\"H5337\",  \nand|strong=\"H3833\"there will be no one to|strong=\"H5337\"deliver|strong=\"H5337\".   \n"},{"number":30,"text":"They|strong=\"H3117\"will|strong=\"H1931\"roar|strong=\"H5098\"against|strong=\"H5921\"them|strong=\"H5921\"in|strong=\"H5921\"that|strong=\"H3117\"day|strong=\"H3117\"like|strong=\"H5921\"the|strong=\"H5921\"roaring|strong=\"H5098\"of|strong=\"H3117\"the|strong=\"H5921\"sea|strong=\"H3220\".  \nIf|strong=\"H2009\"one|strong=\"H1931\"looks|strong=\"H5027\"to|strong=\"H5921\"the|strong=\"H5921\"land, behold|strong=\"H2009\", darkness|strong=\"H2822\"and|strong=\"H3117\"distress|strong=\"H6862\".  \nThe|strong=\"H5921\"light is|strong=\"H1931\"darkened|strong=\"H2821\"in|strong=\"H5921\"its|strong=\"H5921\"clouds|strong=\"H6183\".   \n"}]}
