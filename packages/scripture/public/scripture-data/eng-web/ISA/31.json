{"verses":[{"number":1,"text":"Woe|strong=\"H1945\"to|strong=\"H3381\"those|strong=\"H1945\"who|strong=\"H3068\"go|strong=\"H3381\"down|strong=\"H3381\"to|strong=\"H3381\"Egypt|strong=\"H4714\"for|strong=\"H3588\"help|strong=\"H5833\",  \nand|strong=\"H3478\"rely|strong=\"H8172\"on|strong=\"H5921\"horses|strong=\"H5483\",  \nand|strong=\"H3478\"trust|strong=\"H8172\"in|strong=\"H5921\"chariots|strong=\"H7393\"because|strong=\"H3588\"they|strong=\"H3588\"are|strong=\"H3478\"many|strong=\"H7227\",  \nand|strong=\"H3478\"in|strong=\"H5921\"horsemen|strong=\"H6571\"because|strong=\"H3588\"they|strong=\"H3588\"are|strong=\"H3478\"very|strong=\"H3966\"strong|strong=\"H6105\",  \nbut|strong=\"H3588\"they|strong=\"H3588\"don’t look|strong=\"H8159\"to|strong=\"H3381\"the|strong=\"H5921\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H3068\"Israel|strong=\"H3478\",  \nand|strong=\"H3478\"they|strong=\"H3588\"don’t seek|strong=\"H1875\"the|strong=\"H5921\"LORD|strong=\"H3068\"!   \n"},{"number":2,"text":"Yet|strong=\"H1571\"he|strong=\"H1931\"also|strong=\"H1571\"is|strong=\"H1931\"wise|strong=\"H2450\", and|strong=\"H6965\"will|strong=\"H1571\"bring|strong=\"H7451\"disaster|strong=\"H7451\",  \nand|strong=\"H6965\"will|strong=\"H1571\"not|strong=\"H3808\"call back|strong=\"H5493\"his|strong=\"H5921\"words|strong=\"H1697\", but|strong=\"H3808\"will|strong=\"H1571\"arise|strong=\"H6965\"against|strong=\"H5921\"the|strong=\"H5921\"house|strong=\"H1004\"of|strong=\"H1004\"the|strong=\"H5921\"evildoers|strong=\"H7489\",  \nand|strong=\"H6965\"against|strong=\"H5921\"the|strong=\"H5921\"help|strong=\"H5833\"of|strong=\"H1004\"those|strong=\"H5921\"who|strong=\"H1931\"work|strong=\"H6466\"iniquity.   \n"},{"number":3,"text":"Now|strong=\"H4714\"the|strong=\"H3605\"Egyptians|strong=\"H4714\"are|strong=\"H3027\"men|strong=\"H3605\", and|strong=\"H3068\"not|strong=\"H3808\"God|strong=\"H3068\";  \nand|strong=\"H3068\"their|strong=\"H3605\"horses|strong=\"H5483\"flesh|strong=\"H1320\", and|strong=\"H3068\"not|strong=\"H3808\"spirit|strong=\"H7307\".  \nWhen|strong=\"H3615\"the|strong=\"H3605\"LORD|strong=\"H3068\"stretches|strong=\"H5186\"out|strong=\"H5186\"his|strong=\"H3605\"hand|strong=\"H3027\", both|strong=\"H3605\"he|strong=\"H3068\"who|strong=\"H3605\"helps|strong=\"H5826\"shall|strong=\"H3068\"stumble|strong=\"H3782\",  \nand|strong=\"H3068\"he|strong=\"H3068\"who|strong=\"H3605\"is|strong=\"H3068\"helped|strong=\"H5826\"shall|strong=\"H3068\"fall|strong=\"H5307\",  \nand|strong=\"H3068\"they|strong=\"H3068\"all|strong=\"H3605\"shall|strong=\"H3068\"be|strong=\"H3808\"consumed|strong=\"H3615\"together|strong=\"H3162\".   \n"},{"number":4,"text":"For|strong=\"H3588\"the|strong=\"H5921\"LORD|strong=\"H3068\"says|strong=\"H3541\"to|strong=\"H3381\"me|strong=\"H5921\",  \n“As|strong=\"H3651\"the|strong=\"H5921\"lion|strong=\"H3715\"and|strong=\"H3068\"the|strong=\"H5921\"young|strong=\"H3715\"lion|strong=\"H3715\"growling|strong=\"H7121\"over|strong=\"H5921\"his|strong=\"H3068\"prey|strong=\"H2964\",  \nif|strong=\"H3588\"a|strong=\"H3068\"multitude|strong=\"H1995\"of|strong=\"H3068\"shepherds|strong=\"H7462\"is|strong=\"H3068\"called|strong=\"H7121\"together|strong=\"H5921\"against|strong=\"H5921\"him|strong=\"H7121\",  \nwill|strong=\"H3068\"not|strong=\"H3808\"be|strong=\"H3808\"dismayed|strong=\"H2865\"at|strong=\"H5921\"their|strong=\"H3068\"voice|strong=\"H6963\",  \nnor|strong=\"H3808\"abase|strong=\"H6031\"himself|strong=\"H7121\"for|strong=\"H3588\"their|strong=\"H3068\"noise|strong=\"H6963\",  \nso|strong=\"H3651\"the|strong=\"H5921\"LORD|strong=\"H3068\"of|strong=\"H3068\"Armies|strong=\"H6635\"will|strong=\"H3068\"come|strong=\"H3381\"down|strong=\"H3381\"to|strong=\"H3381\"fight|strong=\"H6633\"on|strong=\"H5921\"Mount|strong=\"H2022\"Zion|strong=\"H6726\"and|strong=\"H3068\"on|strong=\"H5921\"its|strong=\"H5921\"heights.   \n"},{"number":5,"text":"As|strong=\"H3651\"birds|strong=\"H6833\"hovering, so|strong=\"H3651\"the|strong=\"H5921\"LORD|strong=\"H3068\"of|strong=\"H3068\"Armies|strong=\"H6635\"will|strong=\"H3068\"protect|strong=\"H1598\"Jerusalem|strong=\"H3389\".  \nHe|strong=\"H3651\"will|strong=\"H3068\"protect|strong=\"H1598\"and|strong=\"H3068\"deliver|strong=\"H5337\"it|strong=\"H5921\".  \nHe|strong=\"H3651\"will|strong=\"H3068\"pass|strong=\"H6452\"over|strong=\"H5921\"and|strong=\"H3068\"preserve|strong=\"H4422\"it|strong=\"H5921\".”   \n"},{"number":6,"text":"Return|strong=\"H7725\"to|strong=\"H7725\"him|strong=\"H7725\"from|strong=\"H7725\"whom you|strong=\"H7725\"have|strong=\"H1121\"deeply|strong=\"H6009\"revolted|strong=\"H5627\", children|strong=\"H1121\"of|strong=\"H1121\"Israel|strong=\"H3478\".  \n"},{"number":7,"text":"For|strong=\"H3588\"in|strong=\"H6213\"that|strong=\"H3588\"day|strong=\"H3117\"everyone shall|strong=\"H3117\"cast|strong=\"H3988\"away|strong=\"H3988\"his|strong=\"H3027\"idols of|strong=\"H3117\"silver|strong=\"H3701\"and|strong=\"H3701\"his|strong=\"H3027\"idols of|strong=\"H3117\"gold|strong=\"H2091\"—sin|strong=\"H2399\"which|strong=\"H1931\"your|strong=\"H6213\"own|strong=\"H3027\"hands|strong=\"H3027\"have|strong=\"H3027\"made|strong=\"H6213\"for|strong=\"H3588\"you|strong=\"H3588\".   \n"},{"number":8,"text":"“The|strong=\"H6440\"Assyrian will|strong=\"H1961\"fall|strong=\"H5307\"by|strong=\"H1961\"the|strong=\"H6440\"sword|strong=\"H2719\", not|strong=\"H3808\"of|strong=\"H6440\"man|strong=\"H5307\";  \nand|strong=\"H2719\"the|strong=\"H6440\"sword|strong=\"H2719\", not|strong=\"H3808\"of|strong=\"H6440\"mankind, shall|strong=\"H2719\"devour him|strong=\"H6440\".  \nHe|strong=\"H3808\"will|strong=\"H1961\"flee|strong=\"H5127\"from|strong=\"H6440\"the|strong=\"H6440\"sword|strong=\"H2719\",  \nand|strong=\"H2719\"his|strong=\"H6440\"young men|strong=\"H4522\"will|strong=\"H1961\"become|strong=\"H1961\"subject to|strong=\"H1961\"forced|strong=\"H4522\"labor|strong=\"H4522\".   \n"},{"number":9,"text":"His|strong=\"H3068\"rock|strong=\"H5553\"will|strong=\"H3068\"pass|strong=\"H5674\"away|strong=\"H5674\"by|strong=\"H5674\"reason of|strong=\"H3068\"terror|strong=\"H4032\",  \nand|strong=\"H3068\"his|strong=\"H3068\"princes|strong=\"H8269\"will|strong=\"H3068\"be|strong=\"H3068\"afraid|strong=\"H2865\"of|strong=\"H3068\"the|strong=\"H5002\"banner|strong=\"H5251\",”  \nsays|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\", whose fire is|strong=\"H3068\"in|strong=\"H3068\"Zion|strong=\"H6726\",  \nand|strong=\"H3068\"his|strong=\"H3068\"furnace|strong=\"H8574\"in|strong=\"H3068\"Jerusalem|strong=\"H3389\".   \n"}]}
