ng=\"H3588\"Assyrian has|strong=\"H3588\"oppressed|strong=\"H6231\"them|strong=\"H3381\"without|strong=\"H3588\"cause|strong=\"H5971\".   \n"},{"number":5,"text":"“Now|strong=\"H6258\"therefore|strong=\"H6258\", what|strong=\"H4100\"do|strong=\"H3068\"I|strong=\"H3588\"do|strong=\"H3068\"here|strong=\"H6311\",” says|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\",  \n“seeing|strong=\"H3588\"that|strong=\"H3588\"my|strong=\"H3605\"people|strong=\"H5971\"are|strong=\"H3117\"taken|strong=\"H3947\"away|strong=\"H3947\"for|strong=\"H3588\"nothing|strong=\"H2600\"?  \nThose|strong=\"H3605\"who|strong=\"H3605\"rule|strong=\"H4910\"over|strong=\"H4910\"them|strong=\"H3947\"mock,” says|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\",  \n“and|strong=\"H3068\"my|strong=\"H3605\"name|strong=\"H8034\"is|strong=\"H3068\"blasphemed|strong=\"H5006\"continually|strong=\"H8548\"all|strong=\"H3605\"day|strong=\"H3117\"long|strong=\"H3117\".   \n"},{"number":6,"text":"Therefore|strong=\"H3651\"my|strong=\"H3045\"people|strong=\"H5971\"shall|strong=\"H5971\"know|strong=\"H3045\"my|strong=\"H3045\"name|strong=\"H8034\".  \nTherefore|strong=\"H3651\"they|strong=\"H3588\"shall|strong=\"H5971\"know|strong=\"H3045\"in|strong=\"H3117\"that|strong=\"H3588\"day|strong=\"H3117\"that|strong=\"H3588\"I|strong=\"H3588\"am|strong=\"H2005\"he|strong=\"H1931\"who|strong=\"H1931\"speaks|strong=\"H1696\".  \nBehold|strong=\"H2005\", it|strong=\"H1931\"is|strong=\"H1931\"I|strong=\"H3588\".”   \n"},{"number":7,"text":"How|strong=\"H4100\"beautiful|strong=\"H2896\"on|strong=\"H5921\"the|strong=\"H5921\"mountains|strong=\"H2022\"are|strong=\"H4100\"the|strong=\"H5921\"feet|strong=\"H7272\"of|strong=\"H2022\"him|strong=\"H5921\"who|strong=\"H2896\"brings|strong=\"H1319\"good|strong=\"H2896\"news|strong=\"H1319\",  \nwho|strong=\"H2896\"publishes peace|strong=\"H7965\",  \nwho|strong=\"H2896\"brings|strong=\"H1319\"good|strong=\"H2896\"news|strong=\"H1319\",  \nwho|strong=\"H2896\"proclai