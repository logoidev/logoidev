{"verses":[{"number":1,"text":"But|strong=\"H3588\"now|strong=\"H6258\"the|strong=\"H3588\"LORD|strong=\"H3068\"who|strong=\"H3068\"created|strong=\"H1254\"you|strong=\"H3588\", Jacob|strong=\"H3290\",  \nand|strong=\"H3478\"he|strong=\"H3588\"who|strong=\"H3068\"formed|strong=\"H3335\"you|strong=\"H3588\", Israel|strong=\"H3478\", says|strong=\"H3541\":  \n“Don’t be|strong=\"H3068\"afraid|strong=\"H3372\", for|strong=\"H3588\"I|strong=\"H3588\"have|strong=\"H3068\"redeemed|strong=\"H1350\"you|strong=\"H3588\".  \nI|strong=\"H3588\"have|strong=\"H3068\"called|strong=\"H7121\"you|strong=\"H3588\"by|strong=\"H3068\"your|strong=\"H3068\"name|strong=\"H8034\".  \nYou|strong=\"H3588\"are|strong=\"H3478\"mine|strong=\"H3478\".   \n"},{"number":2,"text":"When|strong=\"H3588\"you|strong=\"H3588\"pass|strong=\"H5674\"through|strong=\"H5674\"the|strong=\"H3588\"waters|strong=\"H4325\", I|strong=\"H3588\"will|strong=\"H3808\"be|strong=\"H3808\"with|strong=\"H3212\"you|strong=\"H3588\",  \nand|strong=\"H3212\"through|strong=\"H5674\"the|strong=\"H3588\"rivers|strong=\"H5104\", they|strong=\"H3588\"will|strong=\"H3808\"not|strong=\"H3808\"overflow|strong=\"H7857\"you|strong=\"H3588\".  \nWhen|strong=\"H3588\"you|strong=\"H3588\"walk|strong=\"H3212\"through|strong=\"H5674\"the|strong=\"H3588\"fire, you|strong=\"H3588\"will|strong=\"H3808\"not|strong=\"H3808\"be|strong=\"H3808\"burned|strong=\"H1197\",  \nand|strong=\"H3212\"flame|strong=\"H3852\"will|strong=\"H3808\"not|strong=\"H3808\"scorch you|strong=\"H3588\".   \n"},{"number":3,"text":"For|strong=\"H3588\"I|strong=\"H3588\"am|strong=\"H3068\"the|strong=\"H3588\"LORD|strong=\"H3068\"your|strong=\"H3068\"God|strong=\"H3068\",  \nthe|strong=\"H3588\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H3068\"Israel|strong=\"H3478\",  \nyour|strong=\"H3068\"Savior|strong=\"H3467\".  \nI|strong=\"H3588\"have|strong=\"H3068\"given|strong=\"H5414\"Egypt|strong=\"H4714\"as|strong=\"H3068\"your|strong=\"H3068\"ransom|strong=\"H3724\",  \nEthiopia|strong=\"H3568\"and|strong=\"H3478\"Seba|strong=\"H5434\"in|strong=\"H3478\"your|strong=\"H3068\"place|strong=\"H8478\".   \n"},{"number":4,"text":"Since you|strong=\"H5414\"have|strong=\"H5869\"been precious|strong=\"H3365\"and|strong=\"H5869\"honored|strong=\"H3513\"in|strong=\"H5315\"my|strong=\"H5414\"sight|strong=\"H5869\",  \nand|strong=\"H5869\"I|strong=\"H5414\"have|strong=\"H5869\"loved you|strong=\"H5414\",  \ntherefore I|strong=\"H5414\"will|strong=\"H5869\"give|strong=\"H5414\"people|strong=\"H3816\"in|strong=\"H5315\"your|strong=\"H5414\"place|strong=\"H8478\",  \nand|strong=\"H5869\"nations|strong=\"H3816\"instead|strong=\"H8478\"of|strong=\"H5869\"your|strong=\"H5414\"life|strong=\"H5315\".   \n"},{"number":5,"text":"Don’t be|strong=\"H3372\"afraid|strong=\"H3372\", for|strong=\"H3588\"I|strong=\"H3588\"am with|strong=\"H2233\"you|strong=\"H3588\".  \nI|strong=\"H3588\"will|strong=\"H2233\"bring your|strong=\"H3588\"offspring|strong=\"H2233\"from|strong=\"H2233\"the|strong=\"H3588\"east|strong=\"H4217\",  \nand|strong=\"H3372\"gather|strong=\"H6908\"you|strong=\"H3588\"from|strong=\"H2233\"the|strong=\"H3588\"west|strong=\"H4628\".   \n"},{"number":6,"text":"I|strong=\"H5414\"will|strong=\"H1121\"tell the|strong=\"H5414\"north|strong=\"H6828\", ‘Give|strong=\"H5414\"them|strong=\"H5414\"up|strong=\"H5414\"!’  \nand|strong=\"H1121\"tell the|strong=\"H5414\"south|strong=\"H8486\", ‘Don’t hold|strong=\"H3607\"them|strong=\"H5414\"back|strong=\"H3607\"!  \nBring|strong=\"H5414\"my|strong=\"H5414\"sons|strong=\"H1121\"from|strong=\"H1121\"far|strong=\"H7350\"away|strong=\"H5414\",  \nand|strong=\"H1121\"my|strong=\"H5414\"daughters|strong=\"H1323\"from|strong=\"H1121\"the|strong=\"H5414\"ends|strong=\"H7097\"of|strong=\"H1121\"the|strong=\"H5414\"earth—   \n"},{"number":7,"text":"everyone|strong=\"H3605\"who|strong=\"H3605\"is|strong=\"H8034\"called|strong=\"H7121\"by|strong=\"H7121\"my|strong=\"H3605\"name|strong=\"H8034\",  \nand|strong=\"H6213\"whom|strong=\"H7121\"I|strong=\"H3605\"have|strong=\"H3605\"created|strong=\"H1254\"for|strong=\"H7121\"my|strong=\"H3605\"glory|strong=\"H3519\",  \nwhom|strong=\"H7121\"I|strong=\"H3605\"have|strong=\"H3605\"formed|strong=\"H3335\",  \nyes, whom|strong=\"H7121\"I|strong=\"H3605\"have|strong=\"H3605\"made|strong=\"H6213\".’”   \n"},{"number":8,"text":"Bring|strong=\"H3318\"out|strong=\"H3318\"the|strong=\"H3318\"blind|strong=\"H5787\"people|strong=\"H5971\"who|strong=\"H5971\"have|strong=\"H3426\"eyes|strong=\"H5869\",  \nand|strong=\"H5971\"the|strong=\"H3318\"deaf|strong=\"H2795\"who|strong=\"H5971\"have|strong=\"H3426\"ears.   \n"},{"number":9,"text":"Let|strong=\"H5414\"all|strong=\"H3605\"the|strong=\"H3605\"nations|strong=\"H1471\"be|strong=\"H1471\"gathered|strong=\"H6908\"together|strong=\"H3162\",  \nand|strong=\"H8085\"let|strong=\"H5414\"the|strong=\"H3605\"peoples|strong=\"H3816\"be|strong=\"H1471\"assembled|strong=\"H6908\".  \nWho|strong=\"H4310\"among|strong=\"H4310\"them|strong=\"H5414\"can|strong=\"H4310\"declare|strong=\"H5046\"this|strong=\"H2063\",  \nand|strong=\"H8085\"show|strong=\"H5414\"us|strong=\"H5414\"former|strong=\"H7223\"things|strong=\"H7223\"?  \nLet|strong=\"H5414\"them|strong=\"H5414\"bring|strong=\"H5414\"their|strong=\"H3605\"witnesses|strong=\"H5707\", that|strong=\"H3605\"they|strong=\"H3605\"may|strong=\"H1471\"be|strong=\"H1471\"justified|strong=\"H6663\",  \nor|strong=\"H8085\"let|strong=\"H5414\"them|strong=\"H5414\"hear|strong=\"H8085\", and|strong=\"H8085\"say, “That|strong=\"H3605\"is|strong=\"H4310\"true.”   \n"},{"number":10,"text":"“You|strong=\"H3588\"are|strong=\"H3068\"my|strong=\"H3068\"witnesses|strong=\"H5707\",” says|strong=\"H5002\"the|strong=\"H6440\"LORD|strong=\"H3068\",  \n“With|strong=\"H3068\"my|strong=\"H3068\"servant|strong=\"H5650\"whom|strong=\"H6440\"I|strong=\"H3588\"have|strong=\"H1961\"chosen|strong=\"H3045\";  \nthat|strong=\"H3588\"you|strong=\"H3588\"may|strong=\"H1961\"know|strong=\"H3045\"and|strong=\"H3068\"believe me|strong=\"H6440\",  \nand|strong=\"H3068\"understand|strong=\"H3045\"that|strong=\"H3588\"I|strong=\"H3588\"am|strong=\"H1961\"he|strong=\"H1931\".  \nBefore|strong=\"H6440\"me|strong=\"H6440\"there|strong=\"H1961\"was|strong=\"H3068\"no|strong=\"H3808\"God|strong=\"H3068\"formed|strong=\"H3335\",  \nneither|strong=\"H3808\"will|strong=\"H3068\"there|strong=\"H1961\"be|strong=\"H1961\"after|strong=\"H1961\"me|strong=\"H6440\".   \n"},{"number":11,"text":"I|strong=\"H3068\"myself am|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\".  \nBesides|strong=\"H1107\"me|strong=\"H3467\", there|strong=\"H3068\"is|strong=\"H3068\"no savior|strong=\"H3467\".   \n"},{"number":12,"text":"I|strong=\"H8085\"have|strong=\"H3068\"declared|strong=\"H5046\", I|strong=\"H8085\"have|strong=\"H3068\"saved|strong=\"H3467\", and|strong=\"H3068\"I|strong=\"H8085\"have|strong=\"H3068\"shown|strong=\"H5046\",  \nand|strong=\"H3068\"there|strong=\"H3068\"was|strong=\"H3068\"no strange|strong=\"H2114\"god|strong=\"H3068\"among you|strong=\"H5046\".  \nTherefore|strong=\"H3068\"you|strong=\"H5046\"are|strong=\"H3068\"my|strong=\"H8085\"witnesses|strong=\"H5707\"”,  \nsays|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\", “and|strong=\"H3068\"I|strong=\"H8085\"am|strong=\"H3068\"God|strong=\"H3068\".   \n"},{"number":13,"text":"Yes|strong=\"H1571\", since|strong=\"H3117\"the|strong=\"H3117\"day|strong=\"H3117\"was|strong=\"H1931\", I|strong=\"H3117\"am he|strong=\"H1931\".  \nThere|strong=\"H3117\"is|strong=\"H1931\"no|strong=\"H6466\"one|strong=\"H1931\"who|strong=\"H4310\"can|strong=\"H4310\"deliver|strong=\"H5337\"out|strong=\"H5337\"of|strong=\"H3117\"my|strong=\"H7725\"hand|strong=\"H3027\".  \nI|strong=\"H3117\"will|strong=\"H4310\"work|strong=\"H6466\", and|strong=\"H7725\"who|strong=\"H4310\"can|strong=\"H4310\"hinder|strong=\"H7725\"it|strong=\"H1931\"?”   \n"},{"number":14,"text":"The|strong=\"H3605\"LORD|strong=\"H3068\", your|strong=\"H3068\"Redeemer|strong=\"H1350\", the|strong=\"H3605\"Holy|strong=\"H6918\"One|strong=\"H6918\"of|strong=\"H3068\"Israel|strong=\"H3478\"says|strong=\"H3541\": “For|strong=\"H7971\"your|strong=\"H3068\"sake|strong=\"H4616\", I|strong=\"H3541\"have|strong=\"H3068\"sent|strong=\"H7971\"to|strong=\"H3381\"Babylon, and|strong=\"H3478\"I|strong=\"H3541\"will|strong=\"H3068\"bring|strong=\"H3381\"all|strong=\"H3605\"of|strong=\"H3068\"them|strong=\"H7971\"down|strong=\"H3381\"as|strong=\"H3068\"fugitives|strong=\"H1281\", even|strong=\"H3068\"the|strong=\"H3605\"Chaldeans|strong=\"H3778\", in|strong=\"H3478\"the|strong=\"H3605\"ships of|strong=\"H3068\"their|strong=\"H3605\"rejoicing|strong=\"H7440\".  \n"},{"number":15,"text":"I|strong=\"H3478\"am|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\", your|strong=\"H3068\"Holy|strong=\"H6918\"One|strong=\"H6918\", the|strong=\"H3068\"Creator|strong=\"H1254\"of|strong=\"H4428\"Israel|strong=\"H3478\", your|strong=\"H3068\"King|strong=\"H4428\".”   \n"},{"number":16,"text":"The|strong=\"H5414\"LORD|strong=\"H3068\", who|strong=\"H3068\"makes|strong=\"H5414\"a|strong=\"H3068\"way|strong=\"H1870\"in|strong=\"H3068\"the|strong=\"H5414\"sea|strong=\"H3220\",  \nand|strong=\"H3068\"a|strong=\"H3068\"path|strong=\"H5410\"in|strong=\"H3068\"the|strong=\"H5414\"mighty|strong=\"H5794\"waters|strong=\"H4325\",   \n"},{"number":17,"text":"who brings|strong=\"H3318\"out|strong=\"H3318\"the|strong=\"H3318\"chariot|strong=\"H7393\"and|strong=\"H6965\"horse|strong=\"H5483\",  \nthe|strong=\"H3318\"army|strong=\"H2428\"and|strong=\"H6965\"the|strong=\"H3318\"mighty|strong=\"H2428\"man|strong=\"H2428\"(they|strong=\"H1077\"lie|strong=\"H7901\"down|strong=\"H7901\"together|strong=\"H3162\", they|strong=\"H1077\"shall|strong=\"H7393\"not|strong=\"H1077\"rise|strong=\"H6965\";  \nthey|strong=\"H1077\"are|strong=\"H5483\"extinct|strong=\"H1846\", they|strong=\"H1077\"are|strong=\"H5483\"quenched|strong=\"H3518\"like|strong=\"H3318\"a|strong=\"H3068\"wick|strong=\"H6594\") says:   \n"},{"number":18,"text":"“Don’t remember|strong=\"H2142\"the|strong=\"H2142\"former|strong=\"H7223\"things|strong=\"H7223\",  \nand|strong=\"H7223\"don’t consider|strong=\"H2142\"the|strong=\"H2142\"things|strong=\"H7223\"of|strong=\"H2142\"old|strong=\"H6931\".   \n"},{"number":19,"text":"Behold|strong=\"H2005\", I|strong=\"H2005\"will|strong=\"H3808\"do|strong=\"H6213\"a|strong=\"H3068\"new|strong=\"H2319\"thing|strong=\"H2319\".  \nIt|strong=\"H7760\"springs|strong=\"H6779\"out|strong=\"H6213\"now|strong=\"H6258\".  \nDon’t you|strong=\"H6213\"know|strong=\"H3045\"it|strong=\"H7760\"?  \nI|strong=\"H2005\"will|strong=\"H3808\"even|strong=\"H3808\"make|strong=\"H6213\"a|strong=\"H3068\"way|strong=\"H1870\"in|strong=\"H6213\"the|strong=\"H6213\"wilderness|strong=\"H4057\",  \nand|strong=\"H1870\"rivers|strong=\"H5104\"in|strong=\"H6213\"the|strong=\"H6213\"desert|strong=\"H4057\".   \n"},{"number":20,"text":"The|strong=\"H3588\"animals|strong=\"H2416\"of|strong=\"H1323\"the|strong=\"H3588\"field|strong=\"H7704\", the|strong=\"H3588\"jackals|strong=\"H8577\"and|strong=\"H5971\"the|strong=\"H3588\"ostriches|strong=\"H3284\", shall|strong=\"H5971\"honor|strong=\"H3513\"me|strong=\"H5414\",  \nbecause|strong=\"H3588\"I|strong=\"H3588\"give|strong=\"H5414\"water|strong=\"H4325\"in|strong=\"H5414\"the|strong=\"H3588\"wilderness|strong=\"H4057\"and|strong=\"H5971\"rivers|strong=\"H5104\"in|strong=\"H5414\"the|strong=\"H3588\"desert|strong=\"H4057\",  \nto|strong=\"H5414\"give|strong=\"H5414\"drink|strong=\"H8248\"to|strong=\"H5414\"my|strong=\"H5414\"people|strong=\"H5971\", my|strong=\"H5414\"chosen,   \n"},{"number":21,"text":"the|strong=\"H5608\"people|strong=\"H5971\"which|strong=\"H2098\"I|strong=\"H2098\"formed|strong=\"H3335\"for|strong=\"H5971\"myself,  \nthat|strong=\"H5971\"they|strong=\"H5971\"might|strong=\"H5971\"declare|strong=\"H5608\"my|strong=\"H5608\"praise|strong=\"H8416\".   \n"},{"number":22,"text":"Yet|strong=\"H3588\"you|strong=\"H3588\"have|strong=\"H3478\"not|strong=\"H3808\"called|strong=\"H7121\"on|strong=\"H7121\"me|strong=\"H7121\", Jacob|strong=\"H3290\";  \nbut|strong=\"H3588\"you|strong=\"H3588\"have|strong=\"H3478\"been|strong=\"H3808\"weary|strong=\"H3021\"of|strong=\"H7121\"me|strong=\"H7121\", Israel|strong=\"H3478\".   \n"},{"number":23,"text":"You|strong=\"H3808\"have|strong=\"H3808\"not|strong=\"H3808\"brought me|strong=\"H3808\"any|strong=\"H3808\"of|strong=\"H2077\"your|strong=\"H3513\"sheep|strong=\"H7716\"for|strong=\"H3808\"burnt|strong=\"H5930\"offerings|strong=\"H5930\",  \nneither|strong=\"H3808\"have|strong=\"H3808\"you|strong=\"H3808\"honored|strong=\"H3513\"me|strong=\"H3808\"with|strong=\"H3513\"your|strong=\"H3513\"sacrifices|strong=\"H2077\".  \nI|strong=\"H3808\"have|strong=\"H3808\"not|strong=\"H3808\"burdened|strong=\"H5647\"you|strong=\"H3808\"with|strong=\"H3513\"offerings|strong=\"H5930\",  \nnor|strong=\"H3808\"wearied|strong=\"H3021\"you|strong=\"H3808\"with|strong=\"H3513\"frankincense|strong=\"H3828\".   \n"},{"number":24,"text":"You|strong=\"H3808\"have|strong=\"H5771\"bought|strong=\"H7069\"me|strong=\"H3808\"no|strong=\"H3808\"sweet|strong=\"H7070\"cane|strong=\"H7070\"with|strong=\"H5647\"money|strong=\"H3701\",  \nnor|strong=\"H3808\"have|strong=\"H5771\"you|strong=\"H3808\"filled|strong=\"H7301\"me|strong=\"H3808\"with|strong=\"H5647\"the|strong=\"H5647\"fat|strong=\"H2459\"of|strong=\"H2077\"your|strong=\"H3808\"sacrifices|strong=\"H2077\",  \nbut|strong=\"H3808\"you|strong=\"H3808\"have|strong=\"H5771\"burdened|strong=\"H5647\"me|strong=\"H3808\"with|strong=\"H5647\"your|strong=\"H3808\"sins|strong=\"H2403\".  \nYou|strong=\"H3808\"have|strong=\"H5771\"wearied|strong=\"H3021\"me|strong=\"H3808\"with|strong=\"H5647\"your|strong=\"H3808\"iniquities|strong=\"H5771\".   \n"},{"number":25,"text":"I|strong=\"H3808\", even|strong=\"H3808\"I|strong=\"H3808\", am he|strong=\"H1931\"who|strong=\"H1931\"blots out|strong=\"H4229\"your|strong=\"H2142\"transgressions|strong=\"H6588\"for|strong=\"H4616\"my|strong=\"H2142\"own sake|strong=\"H4616\";  \nand|strong=\"H2403\"I|strong=\"H3808\"will|strong=\"H3808\"not|strong=\"H3808\"remember|strong=\"H2142\"your|strong=\"H2142\"sins|strong=\"H2403\".   \n"},{"number":26,"text":"Put|strong=\"H2142\"me|strong=\"H8199\"in|strong=\"H3162\"remembrance|strong=\"H2142\".  \nLet|strong=\"H2142\"us|strong=\"H2142\"plead|strong=\"H8199\"together|strong=\"H3162\".  \nDeclare|strong=\"H5608\"your|strong=\"H2142\"case|strong=\"H8199\",  \nthat|strong=\"H4616\"you|strong=\"H6663\"may|strong=\"H8199\"be|strong=\"H3162\"justified|strong=\"H6663\".   \n"},{"number":27,"text":"Your|strong=\"H6586\"first|strong=\"H7223\"father sinned|strong=\"H2398\",  \nand|strong=\"H2398\"your|strong=\"H6586\"teachers|strong=\"H3887\"have|strong=\"H7223\"transgressed|strong=\"H6586\"against|strong=\"H2398\"me|strong=\"H2398\".   \n"},{"number":28,"text":"Therefore I|strong=\"H5414\"will|strong=\"H3478\"profane|strong=\"H2490\"the|strong=\"H5414\"princes|strong=\"H8269\"of|strong=\"H8269\"the|strong=\"H5414\"sanctuary|strong=\"H6944\";  \nand|strong=\"H3478\"I|strong=\"H5414\"will|strong=\"H3478\"make|strong=\"H5414\"Jacob|strong=\"H3290\"a|strong=\"H3068\"curse|strong=\"H2764\",  \nand|strong=\"H3478\"Israel|strong=\"H3478\"an|strong=\"H5414\"insult.”   \n"}]}
