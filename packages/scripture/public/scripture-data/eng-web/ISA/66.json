{"verses":[{"number":1,"text":"The|strong=\"H3541\"LORD|strong=\"H3068\"says|strong=\"H3541\":  \n“Heaven|strong=\"H8064\"is|strong=\"H3068\"my|strong=\"H3068\"throne|strong=\"H3678\", and|strong=\"H3068\"the|strong=\"H3541\"earth|strong=\"H8064\"is|strong=\"H3068\"my|strong=\"H3068\"footstool|strong=\"H1916\".  \nWhat|strong=\"H2088\"kind of|strong=\"H1004\"house|strong=\"H1004\"will|strong=\"H3068\"you|strong=\"H4725\"build|strong=\"H1129\"to|strong=\"H3068\"me|strong=\"H1129\"?  \nWhere|strong=\"H4725\"will|strong=\"H3068\"I|strong=\"H3541\"rest|strong=\"H4496\"?   \n"},{"number":2,"text":"For|strong=\"H5921\"my|strong=\"H3605\"hand|strong=\"H3027\"has|strong=\"H3068\"made|strong=\"H6213\"all|strong=\"H3605\"these|strong=\"H2088\"things|strong=\"H1697\",  \nand|strong=\"H3068\"so|strong=\"H6213\"all|strong=\"H3605\"these|strong=\"H2088\"things|strong=\"H1697\"came|strong=\"H1961\"to|strong=\"H3068\"be|strong=\"H1961\",” says|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\":  \n“but|strong=\"H1961\"I|strong=\"H5921\"will|strong=\"H3068\"look|strong=\"H5027\"to|strong=\"H3068\"this|strong=\"H2088\"man|strong=\"H6041\",  \neven|strong=\"H6213\"to|strong=\"H3068\"he|strong=\"H6213\"who|strong=\"H3605\"is|strong=\"H3068\"poor|strong=\"H6041\"and|strong=\"H3068\"of|strong=\"H3068\"a|strong=\"H3068\"contrite|strong=\"H5223\"spirit|strong=\"H7307\",  \nand|strong=\"H3068\"who|strong=\"H3605\"trembles|strong=\"H2730\"at|strong=\"H5921\"my|strong=\"H3605\"word|strong=\"H1697\".   \n"},{"number":3,"text":"He|strong=\"H5221\"who|strong=\"H5315\"kills|strong=\"H5221\"an|strong=\"H5221\"ox|strong=\"H7794\"is|strong=\"H5315\"as|strong=\"H1571\"he|strong=\"H5221\"who|strong=\"H5315\"kills|strong=\"H5221\"a|strong=\"H3068\"man|strong=\"H5315\";  \nhe|strong=\"H5221\"who|strong=\"H5315\"sacrifices|strong=\"H2076\"a|strong=\"H3068\"lamb|strong=\"H7716\", as|strong=\"H1571\"he|strong=\"H5221\"who|strong=\"H5315\"breaks|strong=\"H6202\"a|strong=\"H3068\"dog|strong=\"H3611\"’