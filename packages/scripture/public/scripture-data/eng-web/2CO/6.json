{"verses":[{"number":1,"text":"Working|strong=\"G4903\"together|strong=\"G4903\", we|strong=\"G2532\"entreat|strong=\"G3870\"also|strong=\"G2532\"that|strong=\"G3588\"you|strong=\"G5210\"do|strong=\"G2532\"not|strong=\"G3361\"receive|strong=\"G1209\"the|strong=\"G2532\"grace|strong=\"G5485\"of|strong=\"G2316\"God|strong=\"G2316\"in|strong=\"G1519\"vain|strong=\"G2756\".  \n"},{"number":2,"text":"For|strong=\"G1063\"he|strong=\"G2532\"says|strong=\"G3004\",  \n“At|strong=\"G1722\"an|strong=\"G2532\"acceptable|strong=\"G2144\"time|strong=\"G2540\"I|strong=\"G2532\"listened|strong=\"G1873\"to|strong=\"G2532\"you|strong=\"G4771\".  \nIn|strong=\"G1722\"a|strong=\"G2532\"day|strong=\"G2250\"of|strong=\"G2250\"salvation|strong=\"G4991\"I|strong=\"G2532\"helped you|strong=\"G4771\".”  \nBehold|strong=\"G2400\", now|strong=\"G3568\"is|strong=\"G2532\"the|strong=\"G1722\"acceptable|strong=\"G2144\"time|strong=\"G2540\". Behold|strong=\"G2400\", now|strong=\"G3568\"is|strong=\"G2532\"the|strong=\"G1722\"day|strong=\"G2250\"of|strong=\"G2250\"salvation|strong=\"G4991\".  \n"},{"number":3,"text":"We|strong=\"G2443\"give|strong=\"G1325\"no|strong=\"G3361\"occasion of|strong=\"G1722\"stumbling in|strong=\"G1722\"anything|strong=\"G3367\", that|strong=\"G2443\"our|strong=\"G1722\"service|strong=\"G1248\"may|strong=\"G2443\"not|strong=\"G3361\"be|strong=\"G3361\"blamed|strong=\"G3469\",  \n"},{"number":4,"text":"but|strong=\"G2316\"in|strong=\"G1722\"everything|strong=\"G3956\"commending|strong=\"G4921\"ourselves|strong=\"G1438\"as|strong=\"G5613\"servants|strong=\"G1249\"of|strong=\"G2316\"God|strong=\"G2316\": in|strong=\"G1722\"great|strong=\"G4183\"endurance|strong=\"G5281\", in|strong=\"G1722\"afflictions|strong=\"G2347\", in|strong=\"G1722\"hardships, in|strong=\"G1722\"distresses|strong=\"G4730\",  \n"},{"number":5,"text":"in|strong=\"G1722\"beatings|strong=\"G4127\", in|strong=\"G1722\"imprisonments|strong=\"G5438\", in|strong=\"G1722\"riots, in|strong=\"G1722\"labors|stron