rong=\"G2532\"Lamb|strong=\"G3004\",  \n"},{"number":17,"text":"for|strong=\"G3754\"the|strong=\"G2532\"great|strong=\"G3173\"day|strong=\"G2250\"of|strong=\"G2250\"his|strong=\"G2532\"wrath|strong=\"G3709\"has|strong=\"G5101\"come|strong=\"G2064\", and|strong=\"G2532\"who|strong=\"G5101\"is|strong=\"G3588\"able|strong=\"G1410\"to|strong=\"G2532\"stand|strong=\"G2476\"?”   \n"}]}
