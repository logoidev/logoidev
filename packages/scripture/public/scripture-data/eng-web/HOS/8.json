{"verses":[{"number":1,"text":"“Put|strong=\"H3068\"the|strong=\"H5921\"trumpet|strong=\"H7782\"to|strong=\"H3068\"your|strong=\"H3068\"lips|strong=\"H2441\"!  \nSomething like|strong=\"H1004\"an|strong=\"H3068\"eagle|strong=\"H5404\"is|strong=\"H3068\"over|strong=\"H5921\"the|strong=\"H5921\"LORD|strong=\"H3068\"’s house|strong=\"H1004\",  \nbecause|strong=\"H5921\"they|strong=\"H3068\"have|strong=\"H3068\"broken|strong=\"H5674\"my|strong=\"H3068\"covenant|strong=\"H1285\"and|strong=\"H3068\"rebelled|strong=\"H6586\"against|strong=\"H5921\"my|strong=\"H3068\"law|strong=\"H8451\".   \n"},{"number":2,"text":"They|strong=\"H3478\"cry|strong=\"H2199\"to|strong=\"H3478\"me|strong=\"H3045\", ‘My|strong=\"H3045\"God, we|strong=\"H3068\", Israel|strong=\"H3478\", acknowledge|strong=\"H3045\"you|strong=\"H3045\"!’   \n"},{"number":3,"text":"Israel|strong=\"H3478\"has|strong=\"H3478\"cast|strong=\"H2186\"off|strong=\"H2186\"that|strong=\"H3478\"which|strong=\"H3478\"is|strong=\"H2896\"good|strong=\"H2896\".  \nThe|strong=\"H7291\"enemy will|strong=\"H3478\"pursue|strong=\"H7291\"him|strong=\"H7291\".   \n"},{"number":4,"text":"They|strong=\"H1992\"have|strong=\"H3045\"set|strong=\"H6213\"up|strong=\"H6213\"kings|strong=\"H4427\", but|strong=\"H3808\"not|strong=\"H3808\"by|strong=\"H2091\"me|strong=\"H4480\".  \nThey|strong=\"H1992\"have|strong=\"H3045\"made|strong=\"H6213\"princes|strong=\"H8323\", and|strong=\"H3701\"I|strong=\"H3045\"didn’t approve.  \nOf|strong=\"H4480\"their|strong=\"H1992\"silver|strong=\"H3701\"and|strong=\"H3701\"their|strong=\"H1992\"gold|strong=\"H2091\"they|strong=\"H1992\"have|strong=\"H3045\"made|strong=\"H6213\"themselves|strong=\"H1992\"idols|strong=\"H6091\",  \nthat|strong=\"H3045\"they|strong=\"H1992\"may|strong=\"H6213\"be|strong=\"H3808\"cut|strong=\"H3772\"off|strong=\"H3772\".   \n"},{"number":5,"text":"Let|strong=\"H3808\"Samaria|strong=\"H8111\"throw out|strong=\"H5704\"his|strong=\"H3808\"calf|strong=\"H5695\"idol!  \nMy|strong=\"H3808\"anger burns|strong=\"H2734\"against|strong=\"H2734\"them|strong=\"H5704\"!  \nHow|strong=\"H4970\"long|strong=\"H5704\"will|strong=\"H3808\"it|strong=\"H5704\"be|strong=\"H3808\"until|strong=\"H5704\"they|strong=\"H3808\"are|strong=\"H3808\"capable of|strong=\"H3808\"purity?   \n"},{"number":6,"text":"For|strong=\"H3588\"this|strong=\"H6213\"is|strong=\"H1931\"even|strong=\"H3588\"from|strong=\"H3478\"Israel|strong=\"H3478\"!  \nThe|strong=\"H3588\"workman|strong=\"H2796\"made|strong=\"H6213\"it|strong=\"H1931\", and|strong=\"H3478\"it|strong=\"H1931\"is|strong=\"H1931\"no|strong=\"H3808\"God|strong=\"H3808\";  \nindeed|strong=\"H3588\", the|strong=\"H3588\"calf|strong=\"H5695\"of|strong=\"H6213\"Samaria|strong=\"H8111\"shall|strong=\"H3478\"be|strong=\"H1961\"broken|strong=\"H7616\"in|strong=\"H3478\"pieces|strong=\"H7616\".   \n"},{"number":7,"text":"For|strong=\"H3588\"they|strong=\"H3588\"sow|strong=\"H2232\"the|strong=\"H3588\"wind|strong=\"H7307\",  \nand|strong=\"H6213\"they|strong=\"H3588\"will|strong=\"H7307\"reap|strong=\"H7114\"the|strong=\"H3588\"whirlwind|strong=\"H5492\".  \nHe|strong=\"H3588\"has|strong=\"H3588\"no|strong=\"H6213\"standing|strong=\"H7054\"grain|strong=\"H7054\".  \nThe|strong=\"H3588\"stalk|strong=\"H7054\"will|strong=\"H7307\"yield|strong=\"H6213\"no|strong=\"H6213\"head.  \nIf|strong=\"H3588\"it|strong=\"H3588\"does|strong=\"H6213\"yield|strong=\"H6213\", strangers|strong=\"H2114\"will|strong=\"H7307\"swallow|strong=\"H1104\"it|strong=\"H3588\"up|strong=\"H1104\".   \n"},{"number":8,"text":"Israel|strong=\"H3478\"is|strong=\"H3478\"swallowed|strong=\"H1104\"up|strong=\"H1104\".  \nNow|strong=\"H6258\"they|strong=\"H3478\"are|strong=\"H1471\"among|strong=\"H3478\"the|strong=\"H1961\"nations|strong=\"H1471\"like|strong=\"H1961\"a|strong=\"H3068\"worthless thing|strong=\"H3627\".   \n"},{"number":9,"text":"For|strong=\"H3588\"they|strong=\"H1992\"have|strong=\"H3588\"gone|strong=\"H5927\"up|strong=\"H5927\"to|strong=\"H5927\"Assyria,  \nlike|strong=\"H5927\"a|strong=\"H3068\"wild|strong=\"H6501\"donkey|strong=\"H6501\"wandering alone.  \nEphraim has|strong=\"H3588\"hired|strong=\"H8566\"lovers for|strong=\"H3588\"himself.   \n"},{"number":10,"text":"But|strong=\"H3588\"although|strong=\"H3588\"they|strong=\"H3588\"sold themselves|strong=\"H6908\"among the|strong=\"H3588\"nations|strong=\"H1471\",  \nI|strong=\"H3588\"will|strong=\"H1471\"now|strong=\"H6258\"gather|strong=\"H6908\"them|strong=\"H2490\";  \nand|strong=\"H4428\"they|strong=\"H3588\"begin|strong=\"H2490\"to|strong=\"H2490\"waste away|strong=\"H4853\"because|strong=\"H3588\"of|strong=\"H4428\"the|strong=\"H3588\"oppression of|strong=\"H4428\"the|strong=\"H3588\"king|strong=\"H4428\"of|strong=\"H4428\"mighty ones.   \n"},{"number":11,"text":"Because|strong=\"H3588\"Ephraim has|strong=\"H1961\"multiplied|strong=\"H7235\"altars|strong=\"H4196\"for|strong=\"H3588\"sinning|strong=\"H2398\",  \nthey|strong=\"H3588\"became|strong=\"H1961\"for|strong=\"H3588\"him|strong=\"H7235\"altars|strong=\"H4196\"for|strong=\"H3588\"sinning|strong=\"H2398\".   \n"},{"number":12,"text":"I|strong=\"H3644\"wrote|strong=\"H3789\"for|strong=\"H2803\"him|strong=\"H3644\"the|strong=\"H3789\"many things|strong=\"H3644\"of|strong=\"H8451\"my|strong=\"H2803\"law|strong=\"H8451\",  \nbut|strong=\"H2114\"they|strong=\"H3644\"were|strong=\"H3644\"regarded|strong=\"H2803\"as|strong=\"H2803\"a|strong=\"H3068\"strange|strong=\"H2114\"thing|strong=\"H2114\".   \n"},{"number":13,"text":"As|strong=\"H3068\"for|strong=\"H4714\"the|strong=\"H3068\"sacrifices|strong=\"H2077\"of|strong=\"H3068\"my|strong=\"H3068\"offerings|strong=\"H2077\",  \nthey|strong=\"H1992\"sacrifice|strong=\"H2077\"meat|strong=\"H1320\"and|strong=\"H3068\"eat it|strong=\"H7725\",  \nbut|strong=\"H3808\"the|strong=\"H3068\"LORD|strong=\"H3068\"doesn’t accept|strong=\"H7521\"them|strong=\"H1992\".  \nNow|strong=\"H6258\"he|strong=\"H3068\"will|strong=\"H3068\"remember|strong=\"H2142\"their|strong=\"H3068\"iniquity|strong=\"H5771\",  \nand|strong=\"H3068\"punish|strong=\"H6485\"their|strong=\"H3068\"sins|strong=\"H2403\".  \nThey|strong=\"H1992\"will|strong=\"H3068\"return|strong=\"H7725\"to|strong=\"H7725\"Egypt|strong=\"H4714\".   \n"},{"number":14,"text":"For|strong=\"H6213\"Israel|strong=\"H3478\"has|strong=\"H3478\"forgotten|strong=\"H7911\"his|strong=\"H7971\"Maker|strong=\"H6213\"and|strong=\"H3063\"built|strong=\"H1129\"palaces|strong=\"H1964\";  \nand|strong=\"H3063\"Judah|strong=\"H3063\"has|strong=\"H3478\"multiplied|strong=\"H7235\"fortified|strong=\"H1219\"cities|strong=\"H5892\";  \nbut|strong=\"H7911\"I|strong=\"H3478\"will|strong=\"H3478\"send|strong=\"H7971\"a|strong=\"H3068\"fire on|strong=\"H7971\"his|strong=\"H7971\"cities|strong=\"H5892\",  \nand|strong=\"H3063\"it|strong=\"H6213\"will|strong=\"H3478\"devour its|strong=\"H6213\"fortresses.”   \n"}]}
