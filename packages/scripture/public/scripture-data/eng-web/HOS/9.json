{"verses":[{"number":1,"text":"Don’t rejoice|strong=\"H8055\", Israel|strong=\"H3478\", to|strong=\"H3478\"jubilation like|strong=\"H3478\"the|strong=\"H3605\"nations|strong=\"H5971\";  \nfor|strong=\"H3588\"you|strong=\"H3588\"were|strong=\"H3478\"unfaithful|strong=\"H2181\"to|strong=\"H3478\"your|strong=\"H3605\"God.  \nYou|strong=\"H3588\"love the|strong=\"H3605\"wages of|strong=\"H5971\"a|strong=\"H3068\"prostitute|strong=\"H2181\"at|strong=\"H5921\"every|strong=\"H3605\"grain|strong=\"H1715\"threshing|strong=\"H1637\"floor|strong=\"H1637\".   \n"},{"number":2,"text":"The|strong=\"H3808\"threshing|strong=\"H1637\"floor|strong=\"H1637\"and|strong=\"H8492\"the|strong=\"H3808\"wine|strong=\"H8492\"press|strong=\"H3342\"won’t feed|strong=\"H7462\"them|strong=\"H7462\",  \nand|strong=\"H8492\"the|strong=\"H3808\"new|strong=\"H8492\"wine|strong=\"H8492\"will|strong=\"H3808\"fail|strong=\"H3584\"her.   \n"},{"number":3,"text":"They|strong=\"H3068\"won’t dwell|strong=\"H3427\"in|strong=\"H3427\"the|strong=\"H3068\"LORD|strong=\"H3068\"’s land;  \nbut|strong=\"H3808\"Ephraim will|strong=\"H3068\"return|strong=\"H7725\"to|strong=\"H7725\"Egypt|strong=\"H4714\",  \nand|strong=\"H3068\"they|strong=\"H3068\"will|strong=\"H3068\"eat unclean|strong=\"H2931\"food in|strong=\"H3427\"Assyria.   \n"},{"number":4,"text":"They|strong=\"H3588\"won’t pour|strong=\"H5258\"out|strong=\"H5258\"wine|strong=\"H3196\"offerings|strong=\"H2077\"to|strong=\"H3068\"the|strong=\"H3605\"LORD|strong=\"H3068\",  \nneither|strong=\"H3808\"will|strong=\"H3068\"they|strong=\"H3588\"be|strong=\"H3808\"pleasing to|strong=\"H3068\"him|strong=\"H2930\".  \nTheir|strong=\"H3605\"sacrifices|strong=\"H2077\"will|strong=\"H3068\"be|strong=\"H3808\"to|strong=\"H3068\"them|strong=\"H3588\"like|strong=\"H1004\"the|strong=\"H3605\"bread|strong=\"H3899\"of|strong=\"H1004\"mourners;  \nall|strong=\"H3605\"who|strong=\"H3605\"eat|strong=\"H3899\"of|strong=\"H1004\"it|strong=\"H3588\"will|strong=\"H3068\"be|strong=\"H3808\"polluted|strong=\"H2930\";  \nfor|strong=\"H3588\"their|strong=\"H3605\"bread|strong=\"H3899\"will|strong=\"H3068\"be|strong=\"H3808\"for|strong=\"H3588\"their|strong=\"H3605\"appetite|strong=\"H5315\".  \nIt|strong=\"H3588\"will|strong=\"H3068\"not|strong=\"H3808\"come into the|strong=\"H3605\"LORD|strong=\"H3068\"’s house|strong=\"H1004\".   \n"},{"number":5,"text":"What|strong=\"H4100\"will|strong=\"H3068\"you|strong=\"H3117\"do|strong=\"H6213\"in|strong=\"H3068\"the|strong=\"H6213\"day|strong=\"H3117\"of|strong=\"H3068\"solemn|strong=\"H4150\"assembly|strong=\"H4150\",  \nand|strong=\"H3068\"in|strong=\"H3068\"the|strong=\"H6213\"day|strong=\"H3117\"of|strong=\"H3068\"the|strong=\"H6213\"feast|strong=\"H2282\"of|strong=\"H3068\"the|strong=\"H6213\"LORD|strong=\"H3068\"?   \n"},{"number":6,"text":"For|strong=\"H3588\", behold|strong=\"H2009\", when|strong=\"H3588\"they|strong=\"H3588\"flee destruction|strong=\"H7701\",  \nEgypt|strong=\"H4714\"will|strong=\"H4714\"gather|strong=\"H6908\"them|strong=\"H3423\"up|strong=\"H6908\".  \nMemphis|strong=\"H4644\"will|strong=\"H4714\"bury|strong=\"H6912\"them|strong=\"H3423\".  \nNettles|strong=\"H7057\"will|strong=\"H4714\"possess|strong=\"H3423\"their|strong=\"H3588\"pleasant|strong=\"H4261\"things|strong=\"H4261\"of|strong=\"H3423\"silver|strong=\"H3701\".  \nThorns|strong=\"H2336\"will|strong=\"H4714\"be|strong=\"H3701\"in|strong=\"H1980\"their|strong=\"H3588\"tents.   \n"},{"number":7,"text":"The|strong=\"H5921\"days|strong=\"H3117\"of|strong=\"H3117\"visitation|strong=\"H6486\"have|strong=\"H3045\"come|strong=\"H3478\".  \nThe|strong=\"H5921\"days|strong=\"H3117\"of|strong=\"H3117\"reckoning|strong=\"H6486\"have|strong=\"H3045\"come|strong=\"H3478\".  \nIsrael|strong=\"H3478\"will|strong=\"H3478\"consider|strong=\"H3045\"the|strong=\"H5921\"prophet|strong=\"H5030\"to|strong=\"H3478\"be|strong=\"H3478\"a|strong=\"H3068\"fool,  \nand|strong=\"H3478\"the|strong=\"H5921\"man|strong=\"H7696\"who|strong=\"H3478\"is|strong=\"H3117\"inspired|strong=\"H7307\"to|strong=\"H3478\"be|strong=\"H3478\"insane,  \nbecause|strong=\"H5921\"of|strong=\"H3117\"the|strong=\"H5921\"abundance|strong=\"H7230\"of|strong=\"H3117\"your|strong=\"H5921\"sins|strong=\"H5771\",  \nand|strong=\"H3478\"because|strong=\"H5921\"your|strong=\"H5921\"hostility|strong=\"H4895\"is|strong=\"H3117\"great|strong=\"H7227\".   \n"},{"number":8,"text":"A|strong=\"H3068\"prophet|strong=\"H5030\"watches over|strong=\"H5921\"Ephraim with|strong=\"H5973\"my|strong=\"H3605\"God.  \nA|strong=\"H3068\"fowler|strong=\"H3352\"’s snare|strong=\"H6341\"is|strong=\"H1870\"on|strong=\"H5921\"all|strong=\"H3605\"of|strong=\"H1004\"his|strong=\"H3605\"paths|strong=\"H1870\",  \nand|strong=\"H1004\"hostility|strong=\"H4895\"in|strong=\"H5921\"the|strong=\"H3605\"house|strong=\"H1004\"of|strong=\"H1004\"his|strong=\"H3605\"God.   \n"},{"number":9,"text":"They|strong=\"H3117\"have|strong=\"H5771\"deeply|strong=\"H6009\"corrupted|strong=\"H7843\"themselves|strong=\"H5771\",  \nas|strong=\"H3117\"in|strong=\"H3117\"the|strong=\"H3117\"days|strong=\"H3117\"of|strong=\"H3117\"Gibeah|strong=\"H1390\".  \nHe|strong=\"H3117\"will|strong=\"H3117\"remember|strong=\"H2142\"their|strong=\"H2142\"iniquity|strong=\"H5771\".  \nHe|strong=\"H3117\"will|strong=\"H3117\"punish|strong=\"H6485\"them|strong=\"H6485\"for|strong=\"H3117\"their|strong=\"H2142\"sins|strong=\"H2403\".   \n"},{"number":10,"text":"I|strong=\"H7200\"found|strong=\"H4672\"Israel|strong=\"H3478\"like|strong=\"H1961\"grapes|strong=\"H6025\"in|strong=\"H3478\"the|strong=\"H7200\"wilderness|strong=\"H4057\".  \nI|strong=\"H7200\"saw|strong=\"H7200\"your|strong=\"H7200\"fathers as|strong=\"H1961\"the|strong=\"H7200\"first|strong=\"H7225\"ripe in|strong=\"H3478\"the|strong=\"H7200\"fig|strong=\"H8384\"tree|strong=\"H8384\"at|strong=\"H3478\"its|strong=\"H1961\"first|strong=\"H7225\"season;  \nbut|strong=\"H1961\"they|strong=\"H1992\"came|strong=\"H1961\"to|strong=\"H3478\"Baal|strong=\"H1187\"Peor|strong=\"H1187\", and|strong=\"H3478\"consecrated themselves|strong=\"H1992\"to|strong=\"H3478\"the|strong=\"H7200\"shameful|strong=\"H1322\"thing|strong=\"H1322\",  \nand|strong=\"H3478\"became|strong=\"H1961\"abominable|strong=\"H8251\"like|strong=\"H1961\"that|strong=\"H7200\"which|strong=\"H1992\"they|strong=\"H1992\"loved.   \n"},{"number":11,"text":"As for|strong=\"H3205\"Ephraim, their glory|strong=\"H3519\"will|strong=\"H3519\"fly|strong=\"H5774\"away|strong=\"H5774\"like|strong=\"H5774\"a|strong=\"H3068\"bird|strong=\"H5775\".  \nThere will|strong=\"H3519\"be|strong=\"H3519\"no birth|strong=\"H3205\", no one with child|strong=\"H3205\", and|strong=\"H5775\"no conception|strong=\"H2032\".   \n"},{"number":12,"text":"Though|strong=\"H3588\"they|strong=\"H1992\"bring|strong=\"H1431\"up|strong=\"H1431\"their|strong=\"H1992\"children|strong=\"H1121\",  \nyet|strong=\"H3588\"I|strong=\"H3588\"will|strong=\"H1571\"bereave|strong=\"H7921\"them|strong=\"H1992\", so|strong=\"H1571\"that|strong=\"H3588\"not|strong=\"H3588\"a|strong=\"H3068\"man|strong=\"H1121\"shall|strong=\"H1121\"be|strong=\"H1121\"left|strong=\"H5493\".  \nIndeed|strong=\"H3588\", woe also|strong=\"H1571\"to|strong=\"H1121\"them|strong=\"H1992\"when|strong=\"H3588\"I|strong=\"H3588\"depart|strong=\"H5493\"from|strong=\"H5493\"them|strong=\"H1992\"!   \n"},{"number":13,"text":"I|strong=\"H7200\"have|strong=\"H1121\"seen|strong=\"H7200\"Ephraim, like|strong=\"H3318\"Tyre|strong=\"H6865\", planted|strong=\"H8362\"in|strong=\"H1121\"a|strong=\"H3068\"pleasant place|strong=\"H5116\";  \nbut|strong=\"H7200\"Ephraim will|strong=\"H1121\"bring|strong=\"H3318\"out|strong=\"H3318\"his|strong=\"H7200\"children|strong=\"H1121\"to|strong=\"H3318\"the|strong=\"H7200\"murderer|strong=\"H2026\".   \n"},{"number":14,"text":"Give|strong=\"H5414\"them|strong=\"H5414\"—LORD|strong=\"H3068\"what|strong=\"H4100\"will|strong=\"H3068\"you|strong=\"H5414\"give|strong=\"H5414\"?  \nGive|strong=\"H5414\"them|strong=\"H5414\"a|strong=\"H3068\"miscarrying|strong=\"H7921\"womb|strong=\"H7358\"and|strong=\"H3068\"dry|strong=\"H6784\"breasts|strong=\"H7699\".   \n"},{"number":15,"text":"“All|strong=\"H3605\"their|strong=\"H3605\"wickedness|strong=\"H7451\"is|strong=\"H3605\"in|strong=\"H5921\"Gilgal|strong=\"H1537\";  \nfor|strong=\"H3588\"there|strong=\"H8033\"I|strong=\"H3588\"hated|strong=\"H8130\"them|strong=\"H5921\".  \nBecause|strong=\"H3588\"of|strong=\"H1004\"the|strong=\"H3605\"wickedness|strong=\"H7451\"of|strong=\"H1004\"their|strong=\"H3605\"deeds|strong=\"H4611\", I|strong=\"H3588\"will|strong=\"H1004\"drive|strong=\"H1644\"them|strong=\"H5921\"out|strong=\"H1644\"of|strong=\"H1004\"my|strong=\"H3605\"house|strong=\"H1004\"!  \nI|strong=\"H3588\"will|strong=\"H1004\"love them|strong=\"H5921\"no|strong=\"H3808\"more|strong=\"H3254\".  \nAll|strong=\"H3605\"their|strong=\"H3605\"princes|strong=\"H8269\"are|strong=\"H1004\"rebels|strong=\"H5637\".   \n"},{"number":16,"text":"Ephraim is|strong=\"H1571\"struck|strong=\"H5221\".  \nTheir|strong=\"H3588\"root|strong=\"H8328\"has|strong=\"H3588\"dried|strong=\"H3001\"up|strong=\"H3001\".  \nThey|strong=\"H3588\"will|strong=\"H1571\"bear|strong=\"H3205\"no|strong=\"H6213\"fruit|strong=\"H6529\".  \nEven|strong=\"H1571\"though|strong=\"H3588\"they|strong=\"H3588\"give|strong=\"H3205\"birth|strong=\"H3205\", yet|strong=\"H3588\"I|strong=\"H3588\"will|strong=\"H1571\"kill|strong=\"H4191\"the|strong=\"H3588\"beloved|strong=\"H4261\"ones|strong=\"H4261\"of|strong=\"H3205\"their|strong=\"H3588\"womb.”   \n"},{"number":17,"text":"My|strong=\"H8085\"God|strong=\"H3808\"will|strong=\"H1961\"cast|strong=\"H3988\"them|strong=\"H1961\"away|strong=\"H3988\", because|strong=\"H3588\"they|strong=\"H3588\"didn’t listen|strong=\"H8085\"to|strong=\"H1961\"him|strong=\"H8085\";  \nand|strong=\"H8085\"they|strong=\"H3588\"will|strong=\"H1961\"be|strong=\"H1961\"wanderers|strong=\"H5074\"among|strong=\"H3808\"the|strong=\"H8085\"nations|strong=\"H1471\".   \n"}]}
