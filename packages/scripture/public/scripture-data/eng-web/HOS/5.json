"H3045\"the|strong=\"H3588\"LORD|strong=\"H3068\".   \n"},{"number":5,"text":"The|strong=\"H6440\"pride|strong=\"H1347\"of|strong=\"H6440\"Israel|strong=\"H3478\"testifies|strong=\"H6030\"to|strong=\"H3478\"his|strong=\"H6440\"face|strong=\"H6440\".  \nTherefore|strong=\"H1571\"Israel|strong=\"H3478\"and|strong=\"H3063\"Ephraim will|strong=\"H3478\"stumble|strong=\"H3782\"in|strong=\"H3478\"their|strong=\"H6440\"iniquity|strong=\"H5771\".  \nJudah|strong=\"H3063\"also|strong=\"H1571\"will|strong=\"H3478\"stumble|strong=\"H3782\"with|strong=\"H5973\"them|strong=\"H6440\".   \n"},{"number":6,"text":"They|strong=\"H1992\"will|strong=\"H3068\"go|strong=\"H3212\"with|strong=\"H3068\"their|strong=\"H3068\"flocks|strong=\"H6629\"and|strong=\"H3068\"with|strong=\"H3068\"their|strong=\"H3068\"herds|strong=\"H1241\"to|strong=\"H3212\"seek|strong=\"H1245\"the|strong=\"H3068\"LORD|strong=\"H3068\",  \nbut|strong=\"H3808\"they|strong=\"H1992\"won’t find|strong=\"H4672\"him|strong=\"H4672\".  \nHe|strong=\"H3068\"has|strong=\"H3068\"withdrawn|strong=\"H2502\"himself|strong=\"H3068\"from|strong=\"H3068\"them|strong=\"H1992\".   \n"},{"number":7,"text":"They|strong=\"H3588\"are|strong=\"H1121\"unfaithful to|strong=\"H3068\"the|strong=\"H3588\"LORD|strong=\"H3068\";  \nfor|strong=\"H3588\"they|strong=\"H3588\"have|strong=\"H3068\"borne|strong=\"H3205\"illegitimate|strong=\"H2114\"children|strong=\"H1121\".  \nNow|strong=\"H6258\"the|strong=\"H3588\"new|strong=\"H2320\"moon|strong=\"H2320\"will|strong=\"H3068\"devour them|strong=\"H3205\"with|strong=\"H3068\"their|strong=\"H3068\"fields.   \n"},{"number":8,"text":"“Blow|strong=\"H8628\"the|strong=\"H8628\"cornet|strong=\"H7782\"in|strong=\"H7782\"Gibeah|strong=\"H1390\",  \nand|strong=\"H7414\"the|strong=\"H8628\"trumpet|strong=\"H7782\"in|strong=\"H7782\"Ramah|strong=\"H7414\"!  \nSound|strong=\"H7321\"a|strong=\"H3068\"battle|strong=\"H7321\"cry|strong=\"H7321\"at|strong=\"H1144\"Beth Aven, behind you, Benjamin|strong=\"H1144\"!   \n"},{"number":9,"text":"Ephraim will|strong=\"H1961\"become|strong=\"H1961\"a|strong=\"H3068\"desolation|strong=\"H8047\"in|strong=\"H3478\"the|strong=\"H3117\"day|strong=\"H3117\"of|strong=\"H3117\"rebuke|strong=\"H8433\".  \nAmong|strong=\"H3478\"the|strong=\"H3117\"tribes|strong=\"H7626\"of|strong=\"H3117\"Israel|strong=\"H3478\", I|strong=\"H3117\"have|strong=\"H1961\"made|strong=\"H3045\"known|strong=\"H3045\"that|strong=\"H3045\"which|strong=\"H3478\"will|strong=\"H1961\"surely|strong=\"H1961\"be|strong=\"H1961\".   \n"},{"number":10,"text":"The|strong=\"H5921\"princes|strong=\"H8269\"of|strong=\"H8269\"Judah|strong=\"H3063\"are|strong=\"H4325\"like|strong=\"H1961\"those|strong=\"H5921\"who|strong=\"H3063\"remove|strong=\"H5253\"a|strong=\"H3068\"landmark|strong=\"H1366\".  \nI|strong=\"H5921\"will|strong=\"H1961\"pour|strong=\"H8210\"out|strong=\"H8210\"my|strong=\"H5921\"wrath|strong=\"H5678\"on|strong=\"H5921\"them|strong=\"H5921\"like|strong=\"H1961\"water|strong=\"H4325\".   \n"},{"number":11,"text":"Ephraim is|strong=\"H4941\"oppressed|strong=\"H6231\",  \nhe|strong=\"H3588\"is|strong=\"H4941\"crushed|strong=\"H7533\"in|strong=\"H1980\"judgment|strong=\"H4941\",  \nbecause|strong=\"H3588\"he|strong=\"H3588\"is|strong=\"H4941\"intent in|strong=\"H1980\"his|strong=\"H3588\"pursuit of|strong=\"H4941\"idols.   \n"},{"number":12,"text":"Therefore I|strong=\"H1004\"am to|strong=\"H1004\"Ephraim like|strong=\"H1004\"a|strong=\"H3068\"moth|strong=\"H6211\",  \nand|strong=\"H3063\"to|strong=\"H1004\"the|strong=\"H1004\"house|strong=\"H1004\"of|strong=\"H1004\"Judah|strong=\"H3063\"like|strong=\"H1004\"rottenness|strong=\"H7538\".   \n"},{"number":13,"text":"“When|strong=\"H7200\"Ephraim saw|strong=\"H7200\"his|strong=\"H7971\"sickness|strong=\"H2483\",  \nand|strong=\"H3063\"Judah|strong=\"H3063\"his|strong=\"H7971\"wound|strong=\"H4205\",  \nthen|strong=\"H7971\"Ephraim went|strong=\"H3212\"to|strong=\"H3201\"Assyria,  \nand|strong=\"H3063\"sent|strong=\"H7971\"to|strong=\"H3201\"King|strong=\"H4428\"Jareb|strong=\"H3377\":  \nbut|strong=\"H3808\"he|strong=\"H1931\"is|strong=\"H1931\"not|strong=\"H3808\"able|strong=\"H3201\"to|strong=\"H3201\"heal|strong=\"H7495\"you|strong=\"H7971\",  \nneither|strong=\"H3808\"will|strong=\"H4428\"he|strong=\"H1931\"cure|strong=\"H1455\"you|strong=\"H7971\"of|strong=\"H4428\"your|strong=\"H7200\"wound|strong=\"H4205\".   \n"},{"number":14,"text":"For|strong=\"H3588\"I|strong=\"H3588\"will|strong=\"H1004\"be|strong=\"H1004\"to|strong=\"H3212\"Ephraim like|strong=\"H1004\"a|strong=\"H3068\"lion|strong=\"H3715\",  \nand|strong=\"H3063\"like|strong=\"H1004\"a|strong=\"H3068\"young|strong=\"H3715\"lion|strong=\"H3715\"to|strong=\"H3212\"the|strong=\"H3588\"house|strong=\"H1004\"of|strong=\"H1004\"Judah|strong=\"H3063\".  \nI|strong=\"H3588\"myself will|strong=\"H1004\"tear|strong=\"H2963\"in|strong=\"H1004\"pieces|strong=\"H2963\"and|strong=\"H3063\"go|strong=\"H3212\"away|strong=\"H5375\".  \nI|strong=\"H3588\"will|strong=\"H1004\"carry|strong=\"H5375\"off|strong=\"H5375\", and|strong=\"H3063\"there will|strong=\"H1004\"be|strong=\"H1004\"no|strong=\"H5375\"one|strong=\"H3588\"to|strong=\"H3212\"deliver|strong=\"H5337\".   \n"},{"number":15,"text":"I|strong=\"H5704\"will|strong=\"H5704\"go|strong=\"H3212\"and|strong=\"H7725\"return|strong=\"H7725\"to|strong=\"H5704\"my|strong=\"H1245\"place|strong=\"H4725\",  \nuntil|strong=\"H5704\"they|strong=\"H1992\"acknowledge their|strong=\"H6440\"offense,  \nand|strong=\"H7725\"seek|strong=\"H1245\"my|strong=\"H1245\"face|strong=\"H6440\".  \nIn|strong=\"H3212\"their|strong=\"H6440\"affliction|strong=\"H6862\"they|strong=\"H1992\"will|strong=\"H5704\"seek|strong=\"H1245\"me|strong=\"H6440\"earnestly|strong=\"H7836\".”   \n"}]}
