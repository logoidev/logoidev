{"verses":[{"number":1,"text":"Hear|strong=\"H8085\"this|strong=\"H2088\"word|strong=\"H1697\"that|strong=\"H3605\"the|strong=\"H3605\"LORD|strong=\"H3068\"has|strong=\"H3068\"spoken|strong=\"H1696\"against|strong=\"H5921\"you|strong=\"H3605\", children|strong=\"H1121\"of|strong=\"H1121\"Israel|strong=\"H3478\", against|strong=\"H5921\"the|strong=\"H3605\"whole|strong=\"H3605\"family|strong=\"H4940\"which|strong=\"H3068\"I|strong=\"H5921\"brought|strong=\"H5927\"up|strong=\"H5927\"out|strong=\"H5921\"of|strong=\"H1121\"the|strong=\"H3605\"land|strong=\"H4940\"of|strong=\"H1121\"Egypt|strong=\"H4714\", saying|strong=\"H1697\":   \n"},{"number":2,"text":"“I|strong=\"H5921\"have|strong=\"H3045\"only|strong=\"H7535\"chosen|strong=\"H3045\"you|strong=\"H3605\"of|strong=\"H4940\"all|strong=\"H3605\"the|strong=\"H3605\"families|strong=\"H4940\"of|strong=\"H4940\"the|strong=\"H3605\"earth.  \nTherefore|strong=\"H3651\"I|strong=\"H5921\"will|strong=\"H5771\"punish|strong=\"H6485\"you|strong=\"H3605\"for|strong=\"H5921\"all|strong=\"H3605\"of|strong=\"H4940\"your|strong=\"H3605\"sins|strong=\"H5771\".”   \n"},{"number":3,"text":"Do two|strong=\"H8147\"walk|strong=\"H3212\"together|strong=\"H3162\",  \nunless|strong=\"H1115\"they|strong=\"H3162\"have|strong=\"H8147\"agreed|strong=\"H3259\"?   \n"},{"number":4,"text":"Will|strong=\"H5414\"a|strong=\"H3068\"lion|strong=\"H3715\"roar|strong=\"H7580\"in|strong=\"H5414\"the|strong=\"H5414\"thicket,  \nwhen|strong=\"H6963\"he|strong=\"H5414\"has|strong=\"H3293\"no|strong=\"H1115\"prey|strong=\"H2964\"?  \nDoes a|strong=\"H3068\"young|strong=\"H3715\"lion|strong=\"H3715\"cry|strong=\"H6963\"out|strong=\"H5414\"of|strong=\"H6963\"his|strong=\"H5414\"den|strong=\"H4585\",  \nif he|strong=\"H5414\"has|strong=\"H3293\"caught|strong=\"H3920\"nothing|strong=\"H1115\"?   \n"},{"number":5,"text":"Can|strong=\"H3808\"a|strong=\"H3068\"bird|strong=\"H6833\"fall|strong=\"H5307\"in|strong=\"H5921\"a|strong=\"H3068\"trap|strong=\"H4170\"on|strong=\"H5921\"the|strong=\"H5921\"earth|strong=\"H5927\",  \nwhere|strong=\"H5921\"no|strong=\"H3808\"snare|strong=\"H4170\"is|strong=\"H3808\"set|strong=\"H5927\"for|strong=\"H5921\"him|strong=\"H5921\"?  \nDoes|strong=\"H3808\"a|strong=\"H3068\"snare|strong=\"H4170\"spring|strong=\"H5927\"up|strong=\"H5927\"from|strong=\"H4480\"the|strong=\"H5921\"ground,  \nwhen|strong=\"H5307\"there|strong=\"H5927\"is|strong=\"H3808\"nothing|strong=\"H3808\"to|strong=\"H5927\"catch|strong=\"H3920\"?   \n"},{"number":6,"text":"Does|strong=\"H6213\"the|strong=\"H6213\"trumpet|strong=\"H7782\"alarm sound|strong=\"H8628\"in|strong=\"H3068\"a|strong=\"H3068\"city|strong=\"H5892\",  \nwithout|strong=\"H3808\"the|strong=\"H6213\"people|strong=\"H5971\"being|strong=\"H1961\"afraid|strong=\"H2729\"?  \nDoes|strong=\"H6213\"evil|strong=\"H7451\"happen|strong=\"H1961\"to|strong=\"H3068\"a|strong=\"H3068\"city|strong=\"H5892\",  \nand|strong=\"H3068\"the|strong=\"H6213\"LORD|strong=\"H3068\"hasn’t done|strong=\"H6213\"it|strong=\"H6213\"?   \n"},{"number":7,"text":"Surely|strong=\"H3588\"the|strong=\"H3588\"Lord|strong=\"H3069\"GOD|strong=\"H3068\"will|strong=\"H5650\"do|strong=\"H6213\"nothing|strong=\"H3808\",  \nunless|strong=\"H3588\"he|strong=\"H3588\"reveals|strong=\"H1540\"his|strong=\"H1540\"secret|strong=\"H5475\"to|strong=\"H6213\"his|strong=\"H1540\"servants|strong=\"H5650\"the|strong=\"H3588\"prophets|strong=\"H5030\".   \n"},{"number":8,"text":"The|strong=\"H3069\"lion has|strong=\"H4310\"roared|strong=\"H7580\".  \nWho|strong=\"H4310\"will|strong=\"H4310\"not|strong=\"H3808\"fear|strong=\"H3372\"?  \nThe|strong=\"H3069\"Lord|strong=\"H3069\"GOD|strong=\"H3068\"has|strong=\"H4310\"spoken|strong=\"H1696\".  \nWho|strong=\"H4310\"can|strong=\"H4310\"but|strong=\"H3808\"prophesy|strong=\"H5012\"?   \n"},{"number":9,"text":"Proclaim|strong=\"H8085\"in|strong=\"H5921\"the|strong=\"H5921\"palaces at|strong=\"H5921\"Ashdod,  \nand|strong=\"H4714\"in|strong=\"H5921\"the|strong=\"H5921\"palaces in|strong=\"H5921\"the|strong=\"H5921\"land|strong=\"H7130\"of|strong=\"H2022\"Egypt|strong=\"H4714\",  \nand|strong=\"H4714\"say, “Assemble yourselves|strong=\"H8432\"on|strong=\"H5921\"the|strong=\"H5921\"mountains|strong=\"H2022\"of|strong=\"H2022\"Samaria|strong=\"H8111\",  \nand|strong=\"H4714\"see|strong=\"H7200\"what|strong=\"H7200\"unrest is|strong=\"H4714\"in|strong=\"H5921\"her|strong=\"H5921\",  \nand|strong=\"H4714\"what|strong=\"H7200\"oppression|strong=\"H6217\"is|strong=\"H4714\"among|strong=\"H8432\"them|strong=\"H5921\".”   \n"},{"number":10,"text":"“Indeed|strong=\"H3808\"they|strong=\"H3068\"don’t know|strong=\"H3045\"to|strong=\"H3068\"do|strong=\"H6213\"right|strong=\"H5229\",” says|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\",  \n“Who|strong=\"H3068\"hoard plunder and|strong=\"H3068\"loot in|strong=\"H3068\"their|strong=\"H3068\"palaces.”   \n"},{"number":11,"text":"Therefore|strong=\"H3651\"the|strong=\"H3069\"Lord|strong=\"H3069\"GOD|strong=\"H3068\"says|strong=\"H3541\":  \n“An|strong=\"H4480\"adversary|strong=\"H6862\"will|strong=\"H3069\"overrun the|strong=\"H3069\"land;  \nand|strong=\"H3381\"he|strong=\"H3651\"will|strong=\"H3069\"pull|strong=\"H3381\"down|strong=\"H3381\"your|strong=\"H4480\"strongholds,  \nand|strong=\"H3381\"your|strong=\"H4480\"fortresses will|strong=\"H3069\"be|strong=\"H3069\"plundered.”   \n"},{"number":12,"text":"The|strong=\"H3541\"LORD|strong=\"H3068\"says|strong=\"H3541\":  \n“As|strong=\"H3651\"the|strong=\"H3541\"shepherd|strong=\"H7462\"rescues|strong=\"H5337\"out|strong=\"H5337\"of|strong=\"H1121\"the|strong=\"H3541\"mouth|strong=\"H6310\"of|strong=\"H1121\"the|strong=\"H3541\"lion two|strong=\"H8147\"legs|strong=\"H3767\",  \nor|strong=\"H1121\"a|strong=\"H3068\"piece of|strong=\"H1121\"an|strong=\"H3068\"ear,  \nso|strong=\"H3651\"shall|strong=\"H3068\"the|strong=\"H3541\"children|strong=\"H1121\"of|strong=\"H1121\"Israel|strong=\"H3478\"be|strong=\"H3068\"rescued|strong=\"H5337\"who|strong=\"H3068\"sit|strong=\"H3427\"in|strong=\"H3427\"Samaria|strong=\"H8111\"on|strong=\"H3427\"the|strong=\"H3541\"corner|strong=\"H6285\"of|strong=\"H1121\"a|strong=\"H3068\"couch|strong=\"H6210\",  \nand|strong=\"H1121\"on|strong=\"H3427\"the|strong=\"H3541\"silken cushions of|strong=\"H1121\"a|strong=\"H3068\"bed|strong=\"H4296\".”   \n"},{"number":13,"text":"“Listen|strong=\"H8085\", and|strong=\"H1004\"testify|strong=\"H5749\"against|strong=\"H5749\"the|strong=\"H5002\"house|strong=\"H1004\"of|strong=\"H1004\"Jacob|strong=\"H3290\",” says|strong=\"H5002\"the|strong=\"H5002\"Lord|strong=\"H3069\"GOD|strong=\"H3068\", the|strong=\"H5002\"God|strong=\"H3069\"of|strong=\"H1004\"Armies|strong=\"H6635\".   \n"},{"number":14,"text":"“For|strong=\"H3588\"in|strong=\"H5921\"the|strong=\"H5921\"day|strong=\"H3117\"that|strong=\"H3588\"I|strong=\"H3588\"visit|strong=\"H6485\"the|strong=\"H5921\"transgressions|strong=\"H6588\"of|strong=\"H3117\"Israel|strong=\"H3478\"on|strong=\"H5921\"him|strong=\"H5921\",  \nI|strong=\"H3588\"will|strong=\"H3478\"also|strong=\"H3478\"visit|strong=\"H6485\"the|strong=\"H5921\"altars|strong=\"H4196\"of|strong=\"H3117\"Bethel|strong=\"H1008\";  \nand|strong=\"H3478\"the|strong=\"H5921\"horns|strong=\"H7161\"of|strong=\"H3117\"the|strong=\"H5921\"altar|strong=\"H4196\"will|strong=\"H3478\"be|strong=\"H3478\"cut|strong=\"H1438\"off|strong=\"H1438\",  \nand|strong=\"H3478\"fall|strong=\"H5307\"to|strong=\"H3478\"the|strong=\"H5921\"ground.   \n"},{"number":15,"text":"I|strong=\"H5921\"will|strong=\"H3068\"strike|strong=\"H5221\"the|strong=\"H5002\"winter|strong=\"H2779\"house|strong=\"H1004\"with|strong=\"H1004\"the|strong=\"H5002\"summer|strong=\"H7019\"house|strong=\"H1004\";  \nand|strong=\"H3068\"the|strong=\"H5002\"houses|strong=\"H1004\"of|strong=\"H1004\"ivory|strong=\"H8127\"will|strong=\"H3068\"perish|strong=\"H5486\",  \nand|strong=\"H3068\"the|strong=\"H5002\"great|strong=\"H7227\"houses|strong=\"H1004\"will|strong=\"H3068\"have|strong=\"H3068\"an|strong=\"H5221\"end|strong=\"H5486\",”  \nsays|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\".   \n"}]}
