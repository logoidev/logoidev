{"verses":[{"number":1,"text":"This|strong=\"H2063\"is|strong=\"H3478\"the|strong=\"H6440\"blessing|strong=\"H1293\"with|strong=\"H6440\"which|strong=\"H3478\"Moses|strong=\"H4872\"the|strong=\"H6440\"man|strong=\"H1121\"of|strong=\"H1121\"God blessed|strong=\"H1288\"the|strong=\"H6440\"children|strong=\"H1121\"of|strong=\"H1121\"Israel|strong=\"H3478\"before|strong=\"H6440\"his|strong=\"H6440\"death|strong=\"H4194\".  \n"},{"number":2,"text":"He|strong=\"H3068\"said,  \n“The|strong=\"H3068\"LORD|strong=\"H3068\"came|strong=\"H3068\"from|strong=\"H3068\"Sinai|strong=\"H5514\",  \nand|strong=\"H3068\"rose|strong=\"H2224\"from|strong=\"H3068\"Seir|strong=\"H8165\"to|strong=\"H3068\"them|strong=\"H3068\".  \nHe|strong=\"H3068\"shone|strong=\"H3313\"from|strong=\"H3068\"Mount|strong=\"H2022\"Paran|strong=\"H6290\".  \nHe|strong=\"H3068\"came|strong=\"H3068\"from|strong=\"H3068\"the|strong=\"H3068\"ten|strong=\"H7233\"thousands|strong=\"H7233\"of|strong=\"H3068\"holy|strong=\"H6944\"ones|strong=\"H6944\".  \nAt|strong=\"H3068\"his|strong=\"H3068\"right|strong=\"H3225\"hand|strong=\"H3225\"was|strong=\"H3068\"a|strong=\"H3068\"fiery law for|strong=\"H3068\"them|strong=\"H3068\".   \n"},{"number":3,"text":"Yes, he|strong=\"H3605\"loves|strong=\"H2245\"the|strong=\"H3605\"people|strong=\"H5971\".  \nAll|strong=\"H3605\"his|strong=\"H3605\"saints|strong=\"H6918\"are|strong=\"H1992\"in|strong=\"H3027\"your|strong=\"H3605\"hand|strong=\"H3027\".  \nThey|strong=\"H1992\"sat down|strong=\"H3027\"at|strong=\"H5971\"your|strong=\"H3605\"feet|strong=\"H7272\".  \nEach|strong=\"H3605\"receives|strong=\"H5375\"your|strong=\"H3605\"words|strong=\"H1703\".   \n"},{"number":4,"text":"Moses|strong=\"H4872\"commanded|strong=\"H6680\"us a|strong=\"H3068\"law|strong=\"H8451\",  \nan inheritance|strong=\"H4181\"for|strong=\"H4872\"the|strong=\"H6680\"assembly|strong=\"H6952\"of|strong=\"H8451\"Jacob|strong=\"H3290\".   \n"},{"number":5,"text":"He|strong=\"H3478\"was|strong=\"H1961\"king|strong=\"H4428\"in|strong=\"H3478\"Jeshurun|strong=\"H3484\",  \nwhen|strong=\"H1961\"the|strong=\"H1961\"heads|strong=\"H7218\"of|strong=\"H4428\"the|strong=\"H1961\"people|strong=\"H5971\"were|strong=\"H3478\"gathered|strong=\"H3478\",  \nall|strong=\"H3162\"the|strong=\"H1961\"tribes|strong=\"H7626\"of|strong=\"H4428\"Israel|strong=\"H3478\"together|strong=\"H3162\".   \n"},{"number":6,"text":"“Let|strong=\"H1961\"Reuben|strong=\"H7205\"live|strong=\"H2421\", and|strong=\"H4191\"not|strong=\"H1961\"die|strong=\"H4191\";  \nNor let|strong=\"H1961\"his|strong=\"H1961\"men|strong=\"H4962\"be|strong=\"H1961\"few|strong=\"H4557\".”   \n"},{"number":7,"text":"This|strong=\"H2063\"is|strong=\"H3068\"for|strong=\"H3027\"Judah|strong=\"H3063\". He|strong=\"H3068\"said|strong=\"H8085\",  \n“Hear|strong=\"H8085\", LORD|strong=\"H3068\", the|strong=\"H8085\"voice|strong=\"H6963\"of|strong=\"H3068\"Judah|strong=\"H3063\".  \nBring|strong=\"H1961\"him|strong=\"H3027\"in|strong=\"H3068\"to|strong=\"H3068\"his|strong=\"H3068\"people|strong=\"H5971\".  \nWith|strong=\"H3068\"his|strong=\"H3068\"hands|strong=\"H3027\"he|strong=\"H3068\"contended for|strong=\"H3027\"himself|strong=\"H3027\".  \nYou|strong=\"H3027\"shall|strong=\"H3068\"be|strong=\"H1961\"a|strong=\"H3068\"help|strong=\"H5828\"against|strong=\"H3027\"his|strong=\"H3068\"adversaries|strong=\"H6862\".”   \n"},{"number":8,"text":"About|strong=\"H5921\"Levi|strong=\"H3878\"he|strong=\"H5921\"said,  \n“Your|strong=\"H5921\"Thummim|strong=\"H8550\"and|strong=\"H4325\"your|strong=\"H5921\"Urim are|strong=\"H4325\"with|strong=\"H5921\"your|strong=\"H5921\"godly|strong=\"H2623\"one|strong=\"H2623\",  \nwhom you|strong=\"H5921\"proved|strong=\"H5254\"at|strong=\"H5921\"Massah|strong=\"H4532\",  \nwith|strong=\"H5921\"whom you|strong=\"H5921\"contended|strong=\"H7378\"at|strong=\"H5921\"the|strong=\"H5921\"waters|strong=\"H4325\"of|strong=\"H4325\"Meribah|strong=\"H4809\".   \n"},{"number":9,"text":"He|strong=\"H3588\"said of|strong=\"H1121\"his|strong=\"H8104\"father|strong=\"H1121\", and|strong=\"H1121\"of|strong=\"H1121\"his|strong=\"H8104\"mother, ‘I|strong=\"H3588\"have|strong=\"H3045\"not|strong=\"H3808\"seen|strong=\"H7200\"him|strong=\"H7200\".’  \nHe|strong=\"H3588\"didn’t acknowledge|strong=\"H3045\"his|strong=\"H8104\"brothers|strong=\"H1121\",  \nnor|strong=\"H3808\"did|strong=\"H3808\"he|strong=\"H3588\"know|strong=\"H3045\"his|strong=\"H8104\"own children|strong=\"H1121\";  \nfor|strong=\"H3588\"they|strong=\"H3588\"have|strong=\"H3045\"observed|strong=\"H8104\"your|strong=\"H8104\"word,  \nand|strong=\"H1121\"keep|strong=\"H8104\"your|strong=\"H8104\"covenant|strong=\"H1285\".   \n"},{"number":10,"text":"They|strong=\"H5921\"shall|strong=\"H3478\"teach|strong=\"H3384\"Jacob|strong=\"H3290\"your|strong=\"H5921\"ordinances|strong=\"H4941\",  \nand|strong=\"H3478\"Israel|strong=\"H3478\"your|strong=\"H5921\"law|strong=\"H8451\".  \nThey|strong=\"H5921\"shall|strong=\"H3478\"put|strong=\"H7760\"incense|strong=\"H6988\"before|strong=\"H5921\"you|strong=\"H5921\",  \nand|strong=\"H3478\"whole|strong=\"H3632\"burnt|strong=\"H3632\"offering|strong=\"H3632\"on|strong=\"H5921\"your|strong=\"H5921\"altar|strong=\"H4196\".   \n"},{"number":11,"text":"LORD|strong=\"H3068\", bless|strong=\"H1288\"his|strong=\"H3068\"skills.  \nAccept|strong=\"H7521\"the|strong=\"H3068\"work|strong=\"H6467\"of|strong=\"H3068\"his|strong=\"H3068\"hands|strong=\"H3027\".  \nStrike|strong=\"H4272\"through|strong=\"H3027\"the|strong=\"H3068\"hips|strong=\"H4975\"of|strong=\"H3068\"those|strong=\"H4480\"who|strong=\"H3068\"rise|strong=\"H6965\"up|strong=\"H6965\"against|strong=\"H4480\"him|strong=\"H3027\",  \nof|strong=\"H3068\"those|strong=\"H4480\"who|strong=\"H3068\"hate|strong=\"H8130\"him|strong=\"H3027\", that|strong=\"H3068\"they|strong=\"H3068\"not|strong=\"H6965\"rise|strong=\"H6965\"again|strong=\"H6965\".”   \n"},{"number":12,"text":"About|strong=\"H5921\"Benjamin|strong=\"H1144\"he|strong=\"H3117\"said,  \n“The|strong=\"H3605\"beloved|strong=\"H3039\"of|strong=\"H3068\"the|strong=\"H3605\"LORD|strong=\"H3068\"will|strong=\"H3068\"dwell|strong=\"H7931\"in|strong=\"H5921\"safety by|strong=\"H5921\"him|strong=\"H5921\".  \nHe|strong=\"H3117\"covers him|strong=\"H5921\"all|strong=\"H3605\"day|strong=\"H3117\"long|strong=\"H3117\".  \nHe|strong=\"H3117\"dwells|strong=\"H7931\"between|strong=\"H5921\"his|strong=\"H3605\"shoulders|strong=\"H3802\".”   \n"},{"number":13,"text":"About|strong=\"H3130\"Joseph|strong=\"H3130\"he|strong=\"H3068\"said,  \n“His|strong=\"H3068\"land|strong=\"H8064\"is|strong=\"H3068\"blessed|strong=\"H1288\"by|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\",  \nfor|strong=\"H8478\"the|strong=\"H3068\"precious|strong=\"H4022\"things|strong=\"H4022\"of|strong=\"H3068\"the|strong=\"H3068\"heavens|strong=\"H8064\", for|strong=\"H8478\"the|strong=\"H3068\"dew|strong=\"H2919\",  \nfor|strong=\"H8478\"the|strong=\"H3068\"deep|strong=\"H8415\"that|strong=\"H3068\"couches beneath|strong=\"H8478\",   \n"},{"number":14,"text":"for|strong=\"H8121\"the|strong=\"H8121\"precious|strong=\"H4022\"things|strong=\"H4022\"of|strong=\"H3391\"the|strong=\"H8121\"fruits|strong=\"H8393\"of|strong=\"H3391\"the|strong=\"H8121\"sun|strong=\"H8121\",  \nfor|strong=\"H8121\"the|strong=\"H8121\"precious|strong=\"H4022\"things|strong=\"H4022\"that|strong=\"H8121\"the|strong=\"H8121\"moon|strong=\"H3391\"can yield|strong=\"H8393\",   \n"},{"number":15,"text":"for|strong=\"H7218\"the|strong=\"H7218\"best|strong=\"H7218\"things|strong=\"H4022\"of|strong=\"H7218\"the|strong=\"H7218\"ancient|strong=\"H5769\"mountains|strong=\"H2042\",  \nfor|strong=\"H7218\"the|strong=\"H7218\"precious|strong=\"H4022\"things|strong=\"H4022\"of|strong=\"H7218\"the|strong=\"H7218\"everlasting|strong=\"H5769\"hills|strong=\"H1389\",   \n"},{"number":16,"text":"for|strong=\"H7218\"the|strong=\"H3130\"precious|strong=\"H4022\"things|strong=\"H4022\"of|strong=\"H7218\"the|strong=\"H3130\"earth and|strong=\"H7218\"its|strong=\"H4393\"fullness|strong=\"H4393\",  \nthe|strong=\"H3130\"good|strong=\"H7522\"will|strong=\"H7522\"of|strong=\"H7218\"him|strong=\"H3130\"who lived|strong=\"H7931\"in|strong=\"H7931\"the|strong=\"H3130\"bush|strong=\"H5572\".  \nLet this come on|strong=\"H7931\"the|strong=\"H3130\"head|strong=\"H7218\"of|strong=\"H7218\"Joseph|strong=\"H3130\",  \non|strong=\"H7931\"the|strong=\"H3130\"crown|strong=\"H6936\"of|strong=\"H7218\"the|strong=\"H3130\"head|strong=\"H7218\"of|strong=\"H7218\"him|strong=\"H3130\"who was|strong=\"H3130\"separated|strong=\"H5139\"from|strong=\"H7931\"his|strong=\"H7931\"brothers.   \n"},{"number":17,"text":"Majesty|strong=\"H1926\"belongs to|strong=\"H5971\"the|strong=\"H5971\"firstborn|strong=\"H1060\"of|strong=\"H1060\"his|strong=\"H4519\"herd|strong=\"H7794\".  \nHis|strong=\"H4519\"horns|strong=\"H7161\"are|strong=\"H1992\"the|strong=\"H5971\"horns|strong=\"H7161\"of|strong=\"H1060\"the|strong=\"H5971\"wild|strong=\"H7214\"ox|strong=\"H7794\".  \nWith|strong=\"H5971\"them|strong=\"H1992\"he|strong=\"H5971\"will|strong=\"H5971\"push|strong=\"H5055\"all|strong=\"H3162\"the|strong=\"H5971\"peoples|strong=\"H5971\"to|strong=\"H5971\"the|strong=\"H5971\"ends of|strong=\"H1060\"the|strong=\"H5971\"earth.  \nThey|strong=\"H1992\"are|strong=\"H1992\"the|strong=\"H5971\"ten|strong=\"H7233\"thousands|strong=\"H7233\"of|strong=\"H1060\"Ephraim.  \nThey|strong=\"H1992\"are|strong=\"H1992\"the|strong=\"H5971\"thousands|strong=\"H7233\"of|strong=\"H1060\"Manasseh|strong=\"H4519\".”   \n"},{"number":18,"text":"About|strong=\"H3318\"Zebulun|strong=\"H2074\"he|strong=\"H3318\"said|strong=\"H3318\",  \n“Rejoice|strong=\"H8055\", Zebulun|strong=\"H2074\", in|strong=\"H8055\"your|strong=\"H3318\"going|strong=\"H3318\"out|strong=\"H3318\";  \nand|strong=\"H3318\"Issachar|strong=\"H3485\", in|strong=\"H8055\"your|strong=\"H3318\"tents.   \n"},{"number":19,"text":"They|strong=\"H3588\"will|strong=\"H5971\"call|strong=\"H7121\"the|strong=\"H3588\"peoples|strong=\"H5971\"to|strong=\"H7121\"the|strong=\"H3588\"mountain|strong=\"H2022\".  \nThere|strong=\"H8033\"they|strong=\"H3588\"will|strong=\"H5971\"offer|strong=\"H2076\"sacrifices|strong=\"H2077\"of|strong=\"H2022\"righteousness|strong=\"H6664\",  \nfor|strong=\"H3588\"they|strong=\"H3588\"will|strong=\"H5971\"draw|strong=\"H5971\"out|strong=\"H8033\"the|strong=\"H3588\"abundance|strong=\"H8228\"of|strong=\"H2022\"the|strong=\"H3588\"seas|strong=\"H3220\",  \nthe|strong=\"H3588\"hidden|strong=\"H2934\"treasures|strong=\"H8226\"of|strong=\"H2022\"the|strong=\"H3588\"sand|strong=\"H2344\".”   \n"},{"number":20,"text":"About Gad|strong=\"H1410\"he|strong=\"H1410\"said,  \n“He|strong=\"H1410\"who enlarges|strong=\"H7337\"Gad|strong=\"H1410\"is|strong=\"H2220\"blessed|strong=\"H1288\".  \nHe|strong=\"H1410\"dwells|strong=\"H7931\"as a|strong=\"H3068\"lioness|strong=\"H3833\",  \nand|strong=\"H1410\"tears|strong=\"H2963\"the|strong=\"H1288\"arm|strong=\"H2220\"and|strong=\"H1410\"the|strong=\"H1288\"crown|strong=\"H6936\"of|strong=\"H2220\"the|strong=\"H1288\"head|strong=\"H6936\".   \n"},{"number":21,"text":"He|strong=\"H3588\"provided|strong=\"H7200\"the|strong=\"H7200\"first|strong=\"H7225\"part|strong=\"H2513\"for|strong=\"H3588\"himself|strong=\"H6213\",  \nfor|strong=\"H3588\"the|strong=\"H7200\"lawgiver|strong=\"H2710\"’s portion|strong=\"H2513\"was|strong=\"H3068\"reserved|strong=\"H5603\"for|strong=\"H3588\"him|strong=\"H6213\".  \nHe|strong=\"H3588\"came|strong=\"H3478\"with|strong=\"H5973\"the|strong=\"H7200\"heads|strong=\"H7218\"of|strong=\"H3068\"the|strong=\"H7200\"people|strong=\"H5971\".  \nHe|strong=\"H3588\"executed|strong=\"H6213\"the|strong=\"H7200\"righteousness|strong=\"H6666\"of|strong=\"H3068\"the|strong=\"H7200\"LORD|strong=\"H3068\",  \nHis|strong=\"H3068\"ordinances|strong=\"H4941\"with|strong=\"H5973\"Israel|strong=\"H3478\".”   \n"},{"number":22,"text":"About|strong=\"H4480\"Dan|strong=\"H1835\"he|strong=\"H4480\"said,  \n“Dan|strong=\"H1835\"is|strong=\"H1835\"a|strong=\"H3068\"lion’s cub|strong=\"H1482\"that|strong=\"H4480\"leaps|strong=\"H2187\"out|strong=\"H4480\"of|strong=\"H4480\"Bashan|strong=\"H1316\".”   \n"},{"number":23,"text":"About Naphtali|strong=\"H5321\"he|strong=\"H3068\"said,  \n“Naphtali|strong=\"H5321\", satisfied|strong=\"H7649\"with|strong=\"H3068\"favor|strong=\"H7522\",  \nfull|strong=\"H4392\"of|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\"’s blessing|strong=\"H1293\",  \nPossess|strong=\"H3423\"the|strong=\"H3068\"west|strong=\"H3220\"and|strong=\"H3068\"the|strong=\"H3068\"south|strong=\"H1864\".”   \n"},{"number":24,"text":"About|strong=\"H1961\"Asher he|strong=\"H7272\"said,  \n“Asher is|strong=\"H1121\"blessed|strong=\"H1288\"with|strong=\"H7521\"children|strong=\"H1121\".  \nLet|strong=\"H1961\"him|strong=\"H1288\"be|strong=\"H1961\"acceptable|strong=\"H7521\"to|strong=\"H1961\"his|strong=\"H1288\"brothers|strong=\"H1121\".  \nLet|strong=\"H1961\"him|strong=\"H1288\"dip|strong=\"H2881\"his|strong=\"H1288\"foot|strong=\"H7272\"in|strong=\"H1121\"oil|strong=\"H8081\".   \n"},{"number":25,"text":"Your|strong=\"H3117\"bars will|strong=\"H3117\"be|strong=\"H3117\"iron|strong=\"H1270\"and|strong=\"H3117\"bronze|strong=\"H5178\".  \nAs|strong=\"H3117\"your|strong=\"H3117\"days|strong=\"H3117\", so your|strong=\"H3117\"strength|strong=\"H1679\"will|strong=\"H3117\"be|strong=\"H3117\".   \n"},{"number":26,"text":"“There is|strong=\"H7834\"no one like|strong=\"H8064\"God|strong=\"H8064\", Jeshurun|strong=\"H3484\",  \nwho|strong=\"H5828\"rides|strong=\"H7392\"on|strong=\"H7392\"the|strong=\"H7392\"heavens|strong=\"H8064\"for|strong=\"H8064\"your|strong=\"H8064\"help|strong=\"H5828\",  \nin|strong=\"H8064\"his|strong=\"H7392\"excellency|strong=\"H1346\"on|strong=\"H7392\"the|strong=\"H7392\"skies|strong=\"H7834\".   \n"},{"number":27,"text":"The|strong=\"H6440\"eternal|strong=\"H5769\"God is|strong=\"H6440\"your|strong=\"H6440\"dwelling|strong=\"H4585\"place|strong=\"H8478\".  \nUnderneath|strong=\"H8478\"are|strong=\"H6440\"the|strong=\"H6440\"everlasting|strong=\"H5769\"arms|strong=\"H2220\".  \nHe|strong=\"H6440\"thrust out|strong=\"H1644\"the|strong=\"H6440\"enemy from|strong=\"H6440\"before|strong=\"H6440\"you|strong=\"H6440\",  \nand|strong=\"H5769\"said, ‘Destroy|strong=\"H8045\"!’   \n"},{"number":28,"text":"Israel|strong=\"H3478\"dwells|strong=\"H7931\"in|strong=\"H3478\"safety,  \nthe|strong=\"H5869\"fountain|strong=\"H5869\"of|strong=\"H5869\"Jacob|strong=\"H3290\"alone,  \nIn|strong=\"H3478\"a|strong=\"H3068\"land|strong=\"H8064\"of|strong=\"H5869\"grain|strong=\"H1715\"and|strong=\"H3478\"new|strong=\"H8492\"wine|strong=\"H8492\".  \nYes, his|strong=\"H3478\"heavens|strong=\"H8064\"drop|strong=\"H6201\"down|strong=\"H7931\"dew|strong=\"H2919\".   \n"},{"number":29,"text":"You|strong=\"H5921\"are|strong=\"H5971\"happy, Israel|strong=\"H3478\"!  \nWho|strong=\"H4310\"is|strong=\"H3068\"like|strong=\"H3644\"you|strong=\"H5921\", a|strong=\"H3068\"people|strong=\"H5971\"saved|strong=\"H3467\"by|strong=\"H5921\"the|strong=\"H5921\"LORD|strong=\"H3068\",  \nthe|strong=\"H5921\"shield|strong=\"H4043\"of|strong=\"H3068\"your|strong=\"H3068\"help|strong=\"H5828\",  \nthe|strong=\"H5921\"sword|strong=\"H2719\"of|strong=\"H3068\"your|strong=\"H3068\"excellency|strong=\"H1346\"?  \nYour|strong=\"H3068\"enemies will|strong=\"H3068\"submit|strong=\"H3584\"themselves|strong=\"H5921\"to|strong=\"H3478\"you|strong=\"H5921\".  \nYou|strong=\"H5921\"will|strong=\"H3068\"tread|strong=\"H1869\"on|strong=\"H5921\"their|strong=\"H3068\"high|strong=\"H1116\"places|strong=\"H1116\".”   \n"}]}
