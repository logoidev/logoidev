{"verses":[{"number":1,"text":"God|strong=\"G2316\", having|strong=\"G2532\"in|strong=\"G1722\"the|strong=\"G1722\"past|strong=\"G3819\"spoken|strong=\"G2980\"to|strong=\"G2532\"the|strong=\"G1722\"fathers|strong=\"G3962\"through|strong=\"G1722\"the|strong=\"G1722\"prophets|strong=\"G4396\"at|strong=\"G1722\"many|strong=\"G2980\"times|strong=\"G4181\"and|strong=\"G2532\"in|strong=\"G1722\"various ways|strong=\"G4187\",  \n"},{"number":2,"text":"has|strong=\"G3739\"at|strong=\"G1722\"the|strong=\"G1722\"end|strong=\"G2078\"of|strong=\"G5207\"these|strong=\"G3956\"days|strong=\"G2250\"spoken|strong=\"G2980\"to|strong=\"G2532\"us|strong=\"G4160\"by|strong=\"G1223\"his|strong=\"G3956\"Son|strong=\"G5207\", whom|strong=\"G3739\"he|strong=\"G2532\"appointed|strong=\"G5087\"heir|strong=\"G2818\"of|strong=\"G5207\"all|strong=\"G3956\"things|strong=\"G3956\", through|strong=\"G1223\"whom|strong=\"G3739\"also|strong=\"G2532\"he|strong=\"G2532\"made|strong=\"G4160\"the|strong=\"G1722\"worlds.  \n"},{"number":3,"text":"His|strong=\"G1438\"Son is|strong=\"G1510\"the|strong=\"G1722\"radiance|strong=\"G1391\"of|strong=\"G1223\"his|strong=\"G1438\"glory|strong=\"G1391\", the|strong=\"G1722\"very|strong=\"G2532\"image|strong=\"G5481\"of|strong=\"G1223\"his|strong=\"G1438\"substance|strong=\"G5287\", and|strong=\"G2532\"upholding|strong=\"G5342\"all|strong=\"G3956\"things|strong=\"G3956\"by|strong=\"G1223\"the|strong=\"G1722\"word|strong=\"G4487\"of|strong=\"G1223\"his|strong=\"G1438\"power|strong=\"G1411\", who|strong=\"G3739\", when|strong=\"G2532\"he|strong=\"G2532\"had|strong=\"G2532\"by|strong=\"G1223\"himself|strong=\"G1438\"purified us|strong=\"G4160\"of|strong=\"G1223\"our|strong=\"G2532\"sins, sat|strong=\"G2523\"down|strong=\"G2523\"on|strong=\"G1722\"the|strong=\"G1722\"right|strong=\"G1188\"hand|strong=\"G1188\"of|strong=\"G1223\"the|strong=\"G1722\"Majesty|strong=\"G3172\"on|strong=\"G1722\"high|strong=\"G5308\",  \n"},{"number":4,"text":"having become|strong=\"G1096\"as|strong=\"G3745\"much|strong=\"G5118\"better|strong=\"G2909\"than|strong=\"G3844\"the|strong=\"G3588\"angels as|strong=\"G3745\"the|strong=\"G3588\"more|strong=\"G1313\"excellent|strong=\"G1313\"name|strong=\"G3686\"he|strong=\"G3588\"has|strong=\"G1096\"inherited|strong=\"G2816\"is|strong=\"G3588\"better|strong=\"G2909\"than|strong=\"G3844\"theirs.  \n"},{"number":5,"text":"For|strong=\"G1063\"to|strong=\"G1519\"which|strong=\"G3588\"of|strong=\"G5207\"the|strong=\"G2532\"angels did|strong=\"G2532\"he|strong=\"G2532\"say|strong=\"G3004\"at|strong=\"G1519\"any|strong=\"G5101\"time|strong=\"G4218\",  \n“You|strong=\"G4771\"are|strong=\"G1510\"my|strong=\"G1473\"Son|strong=\"G5207\".  \nToday|strong=\"G4594\"I|strong=\"G1473\"have|strong=\"G2532\"become|strong=\"G1510\"your|strong=\"G2532\"father|strong=\"G3962\"?”  \nand|strong=\"G2532\"again|strong=\"G3825\",  \n“I|strong=\"G1473\"will|strong=\"G5101\"be|strong=\"G1510\"to|strong=\"G1519\"him|strong=\"G3588\"a|strong=\"G2532\"Father|strong=\"G3962\",  \nand|strong=\"G2532\"he|strong=\"G2532\"will|strong=\"G5101\"be|strong=\"G1510\"to|strong=\"G1519\"me|strong=\"G1473\"a|strong=\"G2532\"Son|strong=\"G5207\"?”   \n"},{"number":6,"text":"When|strong=\"G3752\"he|strong=\"G2532\"again|strong=\"G3825\"brings|strong=\"G1521\"in|strong=\"G1519\"the|strong=\"G2532\"firstborn|strong=\"G4416\"into|strong=\"G1519\"the|strong=\"G2532\"world|strong=\"G3625\"he|strong=\"G2532\"says|strong=\"G3004\", “Let|strong=\"G1161\"all|strong=\"G3956\"the|strong=\"G2532\"angels of|strong=\"G2316\"God|strong=\"G2316\"worship|strong=\"G4352\"him|strong=\"G3588\".”  \n"},{"number":7,"text":"Of|strong=\"G4151\"the|strong=\"G2532\"angels he|strong=\"G2532\"says|strong=\"G3004\",  \n“He|strong=\"G2532\"makes|strong=\"G4160\"his|strong=\"G4160\"angels winds|strong=\"G4151\",  \nand|strong=\"G2532\"his|strong=\"G4160\"servants|strong=\"G3011\"a|strong=\"G2532\"flame|strong=\"G5395\"of|strong=\"G4151\"fire|strong=\"G4442\".”   \n"},{"number":8,"text":"But|strong=\"G1161\"of|strong=\"G5207\"the|strong=\"G2532\"Son|strong=\"G5207\"he|strong=\"G2532\"says,  \n“Your|strong=\"G2532\"throne|strong=\"G2362\", O God|strong=\"G2316\", is|strong=\"G3588\"forever|strong=\"G1519\"and|strong=\"G2532\"ever|strong=\"G1519\".  \nThe|strong=\"G2532\"scepter|strong=\"G4464\"of|strong=\"G5207\"uprightness is|strong=\"G3588\"the|strong=\"G2532\"scepter|strong=\"G4464\"of|strong=\"G5207\"your|strong=\"G2532\"Kingdom.   \n"},{"number":9,"text":"You|strong=\"G4771\"have|strong=\"G2532\"loved righteousness|strong=\"G1343\"and|strong=\"G2532\"hated|strong=\"G3404\"iniquity;  \ntherefore|strong=\"G1223\"God|strong=\"G2316\", your|strong=\"G1223\"God|strong=\"G2316\", has|strong=\"G2316\"anointed|strong=\"G5548\"you|strong=\"G4771\"with|strong=\"G3844\"the|strong=\"G2532\"oil|strong=\"G1637\"of|strong=\"G1223\"gladness above|strong=\"G3844\"your|strong=\"G1223\"fellows|strong=\"G3353\".”   \n"},{"number":10,"text":"And|strong=\"G2532\",  \n“You|strong=\"G4771\", Lord|strong=\"G2962\", in|strong=\"G2596\"the|strong=\"G2532\"beginning, laid|strong=\"G2532\"the|strong=\"G2532\"foundation|strong=\"G2311\"of|strong=\"G2532\"the|strong=\"G2532\"earth|strong=\"G1093\".  \nThe|strong=\"G2532\"heavens|strong=\"G3772\"are|strong=\"G1510\"the|strong=\"G2532\"works|strong=\"G2041\"of|strong=\"G2532\"your|strong=\"G2962\"hands|strong=\"G5495\".   \n"},{"number":11,"text":"They|strong=\"G2532\"will|strong=\"G2532\"perish, but|strong=\"G1161\"you|strong=\"G4771\"continue|strong=\"G1265\".  \nThey|strong=\"G2532\"all|strong=\"G3956\"will|strong=\"G2532\"grow old|strong=\"G3822\"like|strong=\"G5613\"a|strong=\"G5613\"garment|strong=\"G2440\"does.   \n"},{"number":12,"text":"You|strong=\"G4771\"will|strong=\"G1510\"roll|strong=\"G1667\"them|strong=\"G3588\"up|strong=\"G1667\"like|strong=\"G5613\"a|strong=\"G5613\"mantle|strong=\"G4018\",  \nand|strong=\"G2532\"they|strong=\"G2532\"will|strong=\"G1510\"be|strong=\"G1510\"changed;  \nbut|strong=\"G1161\"you|strong=\"G4771\"are|strong=\"G1510\"the|strong=\"G2532\"same|strong=\"G2532\".  \nYour|strong=\"G2532\"years|strong=\"G2094\"won’t|strong=\"G3588\"fail|strong=\"G1587\".”   \n"},{"number":13,"text":"But|strong=\"G1161\"which|strong=\"G3588\"of|strong=\"G1537\"the|strong=\"G1537\"angels has|strong=\"G5101\"he|strong=\"G1161\"told|strong=\"G3004\"at|strong=\"G4314\"any|strong=\"G4314\"time|strong=\"G4218\",  \n“Sit|strong=\"G2521\"at|strong=\"G4314\"my|strong=\"G5087\"right|strong=\"G1188\"hand|strong=\"G1188\",  \nuntil|strong=\"G2193\"I|strong=\"G1473\"make|strong=\"G5087\"your|strong=\"G5087\"enemies|strong=\"G2190\"the|strong=\"G1537\"footstool|strong=\"G5286\"of|strong=\"G1537\"your|strong=\"G5087\"feet|strong=\"G4228\"?”   \n"},{"number":14,"text":"Aren’t|strong=\"G3588\"they|strong=\"G3588\"all|strong=\"G3956\"serving|strong=\"G1248\"spirits|strong=\"G4151\", sent|strong=\"G4151\"out|strong=\"G1519\"to|strong=\"G1519\"do|strong=\"G1510\"service|strong=\"G1248\"for|strong=\"G1519\"the|strong=\"G1519\"sake|strong=\"G1223\"of|strong=\"G4151\"those|strong=\"G3588\"who|strong=\"G3588\"will|strong=\"G3195\"inherit|strong=\"G2816\"salvation|strong=\"G4991\"?   \n"}]}
