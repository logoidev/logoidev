{"verses":[{"number":1,"text":"Praise|strong=\"H1984\"the|strong=\"H3068\"LORD|strong=\"H3068\"!  \nPraise|strong=\"H1984\"the|strong=\"H3068\"LORD|strong=\"H3068\"’s name|strong=\"H8034\"!  \nPraise|strong=\"H1984\"him|strong=\"H1984\", you servants|strong=\"H5650\"of|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\",   \n"},{"number":2,"text":"you|strong=\"H1004\"who|strong=\"H3068\"stand|strong=\"H5975\"in|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\"’s house|strong=\"H1004\",  \nin|strong=\"H3068\"the|strong=\"H3068\"courts|strong=\"H2691\"of|strong=\"H1004\"our|strong=\"H3068\"God|strong=\"H3068\"’s house|strong=\"H1004\".   \n"},{"number":3,"text":"Praise|strong=\"H1984\"the|strong=\"H3588\"LORD|strong=\"H3068\", for|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"is|strong=\"H3068\"good|strong=\"H2896\".  \nSing|strong=\"H2167\"praises|strong=\"H2167\"to|strong=\"H3068\"his|strong=\"H3068\"name|strong=\"H8034\", for|strong=\"H3588\"that|strong=\"H3588\"is|strong=\"H3068\"pleasant|strong=\"H5273\".   \n"},{"number":4,"text":"For|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"has|strong=\"H3478\"chosen Jacob|strong=\"H3290\"for|strong=\"H3588\"himself,  \nIsrael|strong=\"H3478\"for|strong=\"H3588\"his|strong=\"H3478\"own possession|strong=\"H5459\".   \n"},{"number":5,"text":"For|strong=\"H3588\"I|strong=\"H3588\"know|strong=\"H3045\"that|strong=\"H3588\"the|strong=\"H3605\"LORD|strong=\"H3068\"is|strong=\"H3068\"great|strong=\"H1419\",  \nthat|strong=\"H3588\"our|strong=\"H3068\"Lord|strong=\"H3068\"is|strong=\"H3068\"above all|strong=\"H3605\"gods.   \n"},{"number":6,"text":"Whatever|strong=\"H3605\"the|strong=\"H3605\"LORD|strong=\"H3068\"pleased|strong=\"H2654\", that|strong=\"H3605\"he|strong=\"H6213\"has|strong=\"H3068\"done|strong=\"H6213\",  \nin|strong=\"H3068\"heaven|strong=\"H8064\"and|strong=\"H3068\"in|strong=\"H3068\"earth|strong=\"H8064\", in|strong=\"H3068\"the|strong=\"H3605\"seas|strong=\"H3220\"and|strong=\"H3068\"in|strong=\"H3068\"all|strong=\"H3605\"deeps|strong=\"H8415\".   \n"},{"number":7,"text":"He|strong=\"H6213\"causes|strong=\"H3318\"the|strong=\"H6213\"clouds|strong=\"H5387\"to|strong=\"H3318\"rise|strong=\"H5927\"from|strong=\"H3318\"the|strong=\"H6213\"ends|strong=\"H7097\"of|strong=\"H7307\"the|strong=\"H6213\"earth|strong=\"H5927\".  \nHe|strong=\"H6213\"makes|strong=\"H6213\"lightnings|strong=\"H1300\"with|strong=\"H6213\"the|strong=\"H6213\"rain|strong=\"H4306\".  \nHe|strong=\"H6213\"brings|strong=\"H3318\"the|strong=\"H6213\"wind|strong=\"H7307\"out|strong=\"H3318\"of|strong=\"H7307\"his|strong=\"H6213\"treasuries.   \n"},{"number":8,"text":"He|strong=\"H5704\"struck|strong=\"H5221\"the|strong=\"H5221\"firstborn|strong=\"H1060\"of|strong=\"H1060\"Egypt|strong=\"H4714\",  \nboth of|strong=\"H1060\"man and|strong=\"H4714\"animal.   \n"},{"number":9,"text":"He|strong=\"H3605\"sent|strong=\"H7971\"signs and|strong=\"H7971\"wonders|strong=\"H4159\"into|strong=\"H8432\"the|strong=\"H3605\"middle|strong=\"H8432\"of|strong=\"H5650\"you|strong=\"H3605\", Egypt|strong=\"H4714\",  \non|strong=\"H7971\"Pharaoh|strong=\"H6547\", and|strong=\"H7971\"on|strong=\"H7971\"all|strong=\"H3605\"his|strong=\"H3605\"servants|strong=\"H5650\".   \n"},{"number":10,"text":"He|strong=\"H5221\"struck|strong=\"H5221\"many|strong=\"H7227\"nations|strong=\"H1471\",  \nand|strong=\"H4428\"killed|strong=\"H2026\"mighty|strong=\"H6099\"kings|strong=\"H4428\"—   \n"},{"number":11,"text":"Sihon|strong=\"H5511\"king|strong=\"H4428\"of|strong=\"H4428\"the|strong=\"H3605\"Amorites,  \nOg|strong=\"H5747\"king|strong=\"H4428\"of|strong=\"H4428\"Bashan|strong=\"H1316\",  \nand|strong=\"H4428\"all|strong=\"H3605\"the|strong=\"H3605\"kingdoms|strong=\"H4467\"of|strong=\"H4428\"Canaan|strong=\"H3667\"—   \n"},{"number":12,"text":"and|strong=\"H3478\"gave|strong=\"H5414\"their|strong=\"H5414\"land|strong=\"H5159\"for|strong=\"H3478\"a|strong=\"H3068\"heritage|strong=\"H5159\",  \na|strong=\"H3068\"heritage|strong=\"H5159\"to|strong=\"H3478\"Israel|strong=\"H3478\", his|strong=\"H5414\"people|strong=\"H5971\".   \n"},{"number":13,"text":"Your|strong=\"H3068\"name|strong=\"H8034\", LORD|strong=\"H3068\", endures|strong=\"H5769\"forever|strong=\"H5769\";  \nyour|strong=\"H3068\"renown|strong=\"H8034\", LORD|strong=\"H3068\", throughout|strong=\"H1755\"all|strong=\"H1755\"generations|strong=\"H1755\".   \n"},{"number":14,"text":"For|strong=\"H3588\"the|strong=\"H5921\"LORD|strong=\"H3068\"will|strong=\"H3068\"judge|strong=\"H1777\"his|strong=\"H3068\"people|strong=\"H5971\"and|strong=\"H3068\"have|strong=\"H3068\"compassion|strong=\"H5162\"on|strong=\"H5921\"his|strong=\"H3068\"servants|strong=\"H5650\".   \n"},{"number":15,"text":"The|strong=\"H3027\"idols|strong=\"H6091\"of|strong=\"H3027\"the|strong=\"H3027\"nations|strong=\"H1471\"are|strong=\"H1471\"silver|strong=\"H3701\"and|strong=\"H3701\"gold|strong=\"H2091\",  \nthe|strong=\"H3027\"work|strong=\"H4639\"of|strong=\"H3027\"men’s hands|strong=\"H3027\".   \n"},{"number":16,"text":"They|strong=\"H1992\"have|strong=\"H5869\"mouths|strong=\"H6310\", but|strong=\"H3808\"they|strong=\"H1992\"can|strong=\"H7200\"’t speak|strong=\"H1696\".  \nThey|strong=\"H1992\"have|strong=\"H5869\"eyes|strong=\"H5869\", but|strong=\"H3808\"they|strong=\"H1992\"can|strong=\"H7200\"’t see|strong=\"H7200\".   \n"},{"number":17,"text":"They|strong=\"H1992\"have|strong=\"H3426\"ears, but|strong=\"H3808\"they|strong=\"H1992\"can|strong=\"H7307\"’t hear,  \nneither|strong=\"H3808\"is|strong=\"H3426\"there|strong=\"H3426\"any|strong=\"H3426\"breath|strong=\"H7307\"in|strong=\"H6310\"their|strong=\"H1992\"mouths|strong=\"H6310\".   \n"},{"number":18,"text":"Those|strong=\"H3605\"who|strong=\"H3605\"make|strong=\"H6213\"them|strong=\"H6213\"will|strong=\"H1961\"be|strong=\"H1961\"like|strong=\"H3644\"them|strong=\"H6213\",  \nyes, everyone|strong=\"H3605\"who|strong=\"H3605\"trusts in|strong=\"H6213\"them|strong=\"H6213\".   \n"}