71\".   \n"},{"number":46,"text":"He|strong=\"H5414\"also gave|strong=\"H5414\"their|strong=\"H5414\"increase|strong=\"H2981\"to|strong=\"H5414\"the|strong=\"H5414\"caterpillar|strong=\"H2625\",  \nand|strong=\"H5414\"their|strong=\"H5414\"labor|strong=\"H3018\"to|strong=\"H5414\"the|strong=\"H5414\"locust|strong=\"H2625\".   \n"},{"number":47,"text":"He destroyed|strong=\"H2026\"their|strong=\"H2026\"vines|strong=\"H1612\"with|strong=\"H1612\"hail|strong=\"H1259\",  \ntheir|strong=\"H2026\"sycamore|strong=\"H8256\"fig trees|strong=\"H8256\"with|strong=\"H1612\"frost|strong=\"H2602\".   \n"},{"number":48,"text":"He also|strong=\"H1259\"gave|strong=\"H5462\"over|strong=\"H5462\"their|strong=\"H5462\"livestock|strong=\"H4735\"to|strong=\"H5462\"the|strong=\"H5462\"hail|strong=\"H1259\",  \nand|strong=\"H4735\"their|strong=\"H5462\"flocks|strong=\"H4735\"to|strong=\"H5462\"hot thunderbolts|strong=\"H7565\".   \n"},{"number":49,"text":"He|strong=\"H7971\"threw on|strong=\"H7971\"them|strong=\"H7971\"the|strong=\"H7971\"fierceness|strong=\"H2740\"of|strong=\"H4397\"his|strong=\"H7971\"anger|strong=\"H5678\",  \nwrath|strong=\"H5678\", indignation|strong=\"H2195\", and|strong=\"H7971\"trouble|strong=\"H6869\",  \nand|strong=\"H7971\"a|strong=\"H3068\"band|strong=\"H4917\"of|strong=\"H4397\"angels|strong=\"H4397\"of|strong=\"H4397\"evil|strong=\"H7451\".   \n"},{"number":50,"text":"He|strong=\"H3808\"made|strong=\"H6424\"a|strong=\"H3068\"path|strong=\"H5410\"for|strong=\"H5315\"his|strong=\"H2820\"anger.  \nHe|strong=\"H3808\"didn’t spare|strong=\"H2820\"their|strong=\"H5462\"soul|strong=\"H5315\"from|strong=\"H5315\"death|strong=\"H4194\",  \nbut|strong=\"H3808\"gave|strong=\"H5462\"their|strong=\"H5462\"life|strong=\"H5315\"over|strong=\"H5462\"to|strong=\"H5315\"the|strong=\"H5462\"pestilence|strong=\"H1698\",   \n"},{"number":51,"text":"and|strong=\"H4714\"struck|strong=\"H5221\"all|strong=\"H3605\"the|strong=\"H3605\"firstborn|strong=\"H1060\"in|strong=\"H1060\"Egypt