{"verses":[{"number":1,"text":"Why|strong=\"H4100\"do|strong=\"H4100\"the|strong=\"H4100\"nations|strong=\"H1471\"rage|strong=\"H7283\",  \nand|strong=\"H1471\"the|strong=\"H4100\"peoples|strong=\"H3816\"plot a|strong=\"H3068\"vain|strong=\"H7385\"thing|strong=\"H7385\"?   \n"},{"number":2,"text":"The|strong=\"H5921\"kings|strong=\"H4428\"of|strong=\"H4428\"the|strong=\"H5921\"earth take|strong=\"H3320\"a|strong=\"H3068\"stand|strong=\"H3320\",  \nand|strong=\"H3068\"the|strong=\"H5921\"rulers|strong=\"H7336\"take|strong=\"H3320\"counsel|strong=\"H3245\"together|strong=\"H3162\",  \nagainst|strong=\"H5921\"the|strong=\"H5921\"LORD|strong=\"H3068\", and|strong=\"H3068\"against|strong=\"H5921\"his|strong=\"H3068\"Anointed|strong=\"H4899\", saying,   \n"},{"number":3,"text":"“Let’s break|strong=\"H5423\"their|strong=\"H7993\"bonds|strong=\"H4147\"apart|strong=\"H5423\",  \nand|strong=\"H4480\"cast|strong=\"H7993\"their|strong=\"H7993\"cords|strong=\"H5688\"from|strong=\"H4480\"us|strong=\"H4480\".”   \n"},{"number":4,"text":"He|strong=\"H3427\"who|strong=\"H3427\"sits|strong=\"H3427\"in|strong=\"H3427\"the|strong=\"H3427\"heavens|strong=\"H8064\"will|strong=\"H8064\"laugh|strong=\"H7832\".  \nThe|strong=\"H3427\"Lord will|strong=\"H8064\"have them|strong=\"H3427\"in|strong=\"H3427\"derision|strong=\"H3932\".   \n"},{"number":5,"text":"Then|strong=\"H1696\"he|strong=\"H1696\"will speak|strong=\"H1696\"to|strong=\"H1696\"them in|strong=\"H1696\"his|strong=\"H1696\"anger|strong=\"H2740\",  \nand|strong=\"H1696\"terrify them in|strong=\"H1696\"his|strong=\"H1696\"wrath|strong=\"H2740\":   \n"},{"number":6,"text":"“Yet|strong=\"H5921\"I|strong=\"H5921\"have|strong=\"H4428\"set|strong=\"H5258\"my|strong=\"H5921\"King|strong=\"H4428\"on|strong=\"H5921\"my|strong=\"H5921\"holy|strong=\"H6944\"hill|strong=\"H2022\"of|strong=\"H4428\"Zion|strong=\"H6726\".”   \n"},{"number":7,"text":"I|strong=\"H3117\"will|strong=\"H3068\"tell|strong=\"H5608\"of|strong=\"H1121\"the|strong=\"H3205\"decree|strong=\"H2706\":  \nThe|strong=\"H3205\"LORD|strong=\"H3068\"said to|strong=\"H3068\"me|strong=\"H3205\", “You|strong=\"H3117\"are|strong=\"H3117\"my|strong=\"H3068\"son|strong=\"H1121\".  \nToday|strong=\"H3117\"I|strong=\"H3117\"have|strong=\"H3068\"become|strong=\"H3205\"your|strong=\"H3068\"father|strong=\"H3205\".   \n"},{"number":8,"text":"Ask|strong=\"H7592\"of|strong=\"H4480\"me|strong=\"H5414\", and|strong=\"H1471\"I|strong=\"H5414\"will|strong=\"H1471\"give|strong=\"H5414\"the|strong=\"H5414\"nations|strong=\"H1471\"for|strong=\"H7592\"your|strong=\"H5414\"inheritance|strong=\"H5159\",  \nthe|strong=\"H5414\"uttermost parts of|strong=\"H4480\"the|strong=\"H5414\"earth for|strong=\"H7592\"your|strong=\"H5414\"possession|strong=\"H5159\".   \n"},{"number":9,"text":"You|strong=\"H7489\"shall|strong=\"H7626\"break|strong=\"H7489\"them|strong=\"H1270\"with|strong=\"H3627\"a|strong=\"H3068\"rod|strong=\"H7626\"of|strong=\"H7626\"iron|strong=\"H1270\".  \nYou|strong=\"H7489\"shall|strong=\"H7626\"dash|strong=\"H5310\"them|strong=\"H1270\"in|strong=\"H7489\"pieces|strong=\"H5310\"like a|strong=\"H3068\"potter|strong=\"H3335\"’s vessel|strong=\"H3627\".”   \n"},{"number":10,"text":"Now|strong=\"H6258\"therefore|strong=\"H6258\"be|strong=\"H4428\"wise|strong=\"H7919\", you|strong=\"H3256\"kings|strong=\"H4428\".  \nBe|strong=\"H4428\"instructed|strong=\"H3256\", you|strong=\"H3256\"judges|strong=\"H8199\"of|strong=\"H4428\"the|strong=\"H8199\"earth.   \n"},{"number":11,"text":"Serve|strong=\"H5647\"the|strong=\"H5647\"LORD|strong=\"H3068\"with|strong=\"H3068\"fear|strong=\"H3374\",  \nand|strong=\"H3068\"rejoice|strong=\"H1523\"with|strong=\"H3068\"trembling|strong=\"H7461\".   \n"},{"number":12,"text":"Give sincere homage|strong=\"H5401\"to|strong=\"H1870\"the|strong=\"H3605\"Son|strong=\"H1248\", lest|strong=\"H6435\"he|strong=\"H3588\"be|strong=\"H1870\"angry, and|strong=\"H1870\"you|strong=\"H3588\"perish on|strong=\"H1870\"the|strong=\"H3605\"way|strong=\"H1870\",  \nfor|strong=\"H3588\"his|strong=\"H3605\"wrath will|strong=\"H3588\"soon|strong=\"H4592\"be|strong=\"H1870\"kindled|strong=\"H1197\".  \nBlessed are|strong=\"H1870\"all|strong=\"H3605\"those|strong=\"H3605\"who|strong=\"H3605\"take|strong=\"H2620\"refuge|strong=\"H2620\"in|strong=\"H1870\"him|strong=\"H3605\".   \n"}]}
