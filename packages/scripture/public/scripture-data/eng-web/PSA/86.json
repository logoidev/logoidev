{"verses":[{"number":1,"text":"Hear|strong=\"H6030\", LORD|strong=\"H3068\", and|strong=\"H3068\"answer|strong=\"H6030\"me|strong=\"H6030\",  \nfor|strong=\"H3588\"I|strong=\"H3588\"am|strong=\"H3068\"poor|strong=\"H6041\"and|strong=\"H3068\"needy|strong=\"H6041\".   \n"},{"number":2,"text":"Preserve|strong=\"H8104\"my|strong=\"H8104\"soul|strong=\"H5315\", for|strong=\"H3588\"I|strong=\"H3588\"am godly|strong=\"H2623\".  \nYou|strong=\"H3588\", my|strong=\"H8104\"God, save|strong=\"H3467\"your|strong=\"H8104\"servant|strong=\"H5650\"who|strong=\"H5315\"trusts in|strong=\"H5315\"you|strong=\"H3588\".   \n"},{"number":3,"text":"Be|strong=\"H3117\"merciful|strong=\"H2603\"to|strong=\"H3117\"me|strong=\"H7121\", Lord,  \nfor|strong=\"H3588\"I|strong=\"H3588\"call|strong=\"H7121\"to|strong=\"H3117\"you|strong=\"H3588\"all|strong=\"H3605\"day|strong=\"H3117\"long|strong=\"H3117\".   \n"},{"number":4,"text":"Bring|strong=\"H5375\"joy|strong=\"H8055\"to|strong=\"H5650\"the|strong=\"H3588\"soul|strong=\"H5315\"of|strong=\"H5650\"your|strong=\"H5375\"servant|strong=\"H5650\",  \nfor|strong=\"H3588\"to|strong=\"H5650\"you|strong=\"H3588\", Lord, do I|strong=\"H3588\"lift|strong=\"H5375\"up|strong=\"H5375\"my|strong=\"H5375\"soul|strong=\"H5315\".   \n"},{"number":5,"text":"For|strong=\"H3588\"you|strong=\"H3588\", Lord|strong=\"H2617\", are|strong=\"H7227\"good|strong=\"H2896\", and|strong=\"H2617\"ready|strong=\"H2896\"to|strong=\"H7121\"forgive|strong=\"H5546\",  \nabundant|strong=\"H7227\"in|strong=\"H7227\"loving|strong=\"H2896\"kindness|strong=\"H2617\"to|strong=\"H7121\"all|strong=\"H3605\"those|strong=\"H3605\"who|strong=\"H3605\"call|strong=\"H7121\"on|strong=\"H7121\"you|strong=\"H3588\".   \n"},{"number":6,"text":"Hear|strong=\"H7181\", LORD|strong=\"H3068\", my|strong=\"H3068\"prayer|strong=\"H8605\".  \nListen|strong=\"H7181\"to|strong=\"H3068\"the|strong=\"H3068\"voice|strong=\"H6963\"of|strong=\"H3068\"my|strong=\"H3068\"petitions.   \n"},{"number":7,"text":"In|strong=\"H3117\"the|strong=\"H3588\"day|strong=\"H3117\"of|strong=\"H3117\"my|strong=\"H3588\"trouble|strong=\"H6869\"I|strong=\"H3588\"will|strong=\"H3117\"call|strong=\"H7121\"on|strong=\"H3117\"you|strong=\"H3588\",  \nfor|strong=\"H3588\"you|strong=\"H3588\"will|strong=\"H3117\"answer|strong=\"H6030\"me|strong=\"H7121\".   \n"},{"number":8,"text":"There is|strong=\"H4639\"no one like|strong=\"H3644\"you|strong=\"H3644\"among the|strong=\"H3644\"gods, Lord,  \nnor any deeds|strong=\"H4639\"like|strong=\"H3644\"your deeds|strong=\"H4639\".   \n"},{"number":9,"text":"All|strong=\"H3605\"nations|strong=\"H1471\"you|strong=\"H6440\"have|strong=\"H1471\"made|strong=\"H6213\"will|strong=\"H1471\"come and|strong=\"H6440\"worship|strong=\"H7812\"before|strong=\"H6440\"you|strong=\"H6440\", Lord.  \nThey|strong=\"H6213\"shall|strong=\"H1471\"glorify|strong=\"H3513\"your|strong=\"H3605\"name|strong=\"H8034\".   \n"},{"number":10,"text":"For|strong=\"H3588\"you|strong=\"H3588\"are|strong=\"H6213\"great|strong=\"H1419\", and|strong=\"H1419\"do|strong=\"H6213\"wondrous|strong=\"H6381\"things|strong=\"H1419\".  \nYou|strong=\"H3588\"are|strong=\"H6213\"God alone|strong=\"H6213\".   \n"},{"number":11,"text":"Teach|strong=\"H3384\"me|strong=\"H3372\"your|strong=\"H3068\"way|strong=\"H1870\", LORD|strong=\"H3068\".  \nI|strong=\"H1980\"will|strong=\"H3068\"walk|strong=\"H1980\"in|strong=\"H1980\"your|strong=\"H3068\"truth.  \nMake|strong=\"H8034\"my|strong=\"H3068\"heart|strong=\"H3824\"undivided to|strong=\"H1980\"fear|strong=\"H3372\"your|strong=\"H3068\"name|strong=\"H8034\".   \n"},{"number":12,"text":"I|strong=\"H3605\"will|strong=\"H3824\"praise|strong=\"H3034\"you|strong=\"H3605\", Lord my|strong=\"H3605\"God, with|strong=\"H3513\"my|strong=\"H3605\"whole|strong=\"H3605\"heart|strong=\"H3824\".  \nI|strong=\"H3605\"will|strong=\"H3824\"glorify|strong=\"H3513\"your|strong=\"H3605\"name|strong=\"H8034\"forever|strong=\"H5769\"more|strong=\"H5769\".   \n"},{"number":13,"text":"For|strong=\"H3588\"your|strong=\"H5921\"loving kindness|strong=\"H2617\"is|strong=\"H2617\"great|strong=\"H1419\"toward|strong=\"H5921\"me|strong=\"H5315\".  \nYou|strong=\"H3588\"have|strong=\"H3588\"delivered|strong=\"H5337\"my|strong=\"H5921\"soul|strong=\"H5315\"from|strong=\"H5921\"the|strong=\"H5921\"lowest|strong=\"H8482\"Sheol|strong=\"H7585\".   \n"},{"number":14,"text":"God|strong=\"H3808\", the|strong=\"H5921\"proud|strong=\"H2086\"have|strong=\"H2086\"risen|strong=\"H6965\"up|strong=\"H6965\"against|strong=\"H5921\"me|strong=\"H5315\".  \nA|strong=\"H3068\"company|strong=\"H5712\"of|strong=\"H5921\"violent|strong=\"H6184\"men|strong=\"H6184\"have|strong=\"H2086\"sought|strong=\"H1245\"after|strong=\"H5921\"my|strong=\"H7760\"soul|strong=\"H5315\",  \nand|strong=\"H6965\"they|strong=\"H3808\"don’t hold|strong=\"H6965\"regard|strong=\"H5921\"for|strong=\"H5921\"you|strong=\"H5921\"before|strong=\"H5048\"them|strong=\"H5921\".   \n"},{"number":15,"text":"But|strong=\"H7227\"you, Lord|strong=\"H2617\", are|strong=\"H7227\"a|strong=\"H3068\"merciful|strong=\"H7349\"and|strong=\"H2617\"gracious|strong=\"H2587\"God,  \nslow to|strong=\"H2617\"anger, and|strong=\"H2617\"abundant|strong=\"H7227\"in|strong=\"H7227\"loving kindness|strong=\"H2617\"and|strong=\"H2617\"truth.   \n"},{"number":16,"text":"Turn|strong=\"H6437\"to|strong=\"H5414\"me|strong=\"H5414\", and|strong=\"H1121\"have|strong=\"H1121\"mercy|strong=\"H2603\"on|strong=\"H5414\"me|strong=\"H5414\"!  \nGive|strong=\"H5414\"your|strong=\"H5414\"strength|strong=\"H5797\"to|strong=\"H5414\"your|strong=\"H5414\"servant|strong=\"H5650\".  \nSave|strong=\"H3467\"the|strong=\"H5414\"son|strong=\"H1121\"of|strong=\"H1121\"your|strong=\"H5414\"servant|strong=\"H5650\".   \n"},{"number":17,"text":"Show|strong=\"H7200\"me|strong=\"H7200\"a|strong=\"H3068\"sign of|strong=\"H3068\"your|strong=\"H3068\"goodness|strong=\"H2896\",  \nthat|strong=\"H3588\"those|strong=\"H6213\"who|strong=\"H3068\"hate|strong=\"H8130\"me|strong=\"H7200\"may|strong=\"H3068\"see|strong=\"H7200\"it|strong=\"H3588\", and|strong=\"H3068\"be|strong=\"H3068\"shamed,  \nbecause|strong=\"H3588\"you|strong=\"H3588\", LORD|strong=\"H3068\", have|strong=\"H3068\"helped|strong=\"H5826\"me|strong=\"H7200\", and|strong=\"H3068\"comforted|strong=\"H5162\"me|strong=\"H7200\".   \n"}]}
