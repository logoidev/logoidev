{"verses":[{"number":1,"text":"Blessed|strong=\"H1288\"be|strong=\"H3027\"the|strong=\"H3068\"LORD|strong=\"H3068\", my|strong=\"H3068\"rock|strong=\"H6697\",  \nwho|strong=\"H3068\"trains|strong=\"H3925\"my|strong=\"H3068\"hands|strong=\"H3027\"to|strong=\"H3068\"war|strong=\"H4421\",  \nand|strong=\"H3068\"my|strong=\"H3068\"fingers to|strong=\"H3068\"battle|strong=\"H4421\"—   \n"},{"number":2,"text":"my|strong=\"H8478\"loving kindness|strong=\"H2617\", my|strong=\"H8478\"fortress|strong=\"H4686\",  \nmy|strong=\"H8478\"high tower|strong=\"H4869\", my|strong=\"H8478\"deliverer|strong=\"H6403\",  \nmy|strong=\"H8478\"shield|strong=\"H4043\", and|strong=\"H5971\"he|strong=\"H5971\"in|strong=\"H5971\"whom|strong=\"H5971\"I|strong=\"H8478\"take|strong=\"H2620\"refuge|strong=\"H2620\",  \nwho|strong=\"H5971\"subdues|strong=\"H7286\"my|strong=\"H8478\"people|strong=\"H5971\"under|strong=\"H8478\"me|strong=\"H4686\".   \n"},{"number":3,"text":"LORD|strong=\"H3068\", what|strong=\"H4100\"is|strong=\"H3068\"man|strong=\"H1121\", that|strong=\"H3045\"you|strong=\"H3045\"care for|strong=\"H3068\"him|strong=\"H3045\"?  \nOr|strong=\"H1121\"the|strong=\"H3068\"son|strong=\"H1121\"of|strong=\"H1121\"man|strong=\"H1121\", that|strong=\"H3045\"you|strong=\"H3045\"think|strong=\"H2803\"of|strong=\"H1121\"him|strong=\"H3045\"?   \n"},{"number":4,"text":"Man|strong=\"H5674\"is|strong=\"H3117\"like|strong=\"H1819\"a|strong=\"H3068\"breath|strong=\"H1892\".  \nHis|strong=\"H5674\"days|strong=\"H3117\"are|strong=\"H3117\"like|strong=\"H1819\"a|strong=\"H3068\"shadow|strong=\"H6738\"that|strong=\"H3117\"passes|strong=\"H5674\"away|strong=\"H5674\".   \n"},{"number":5,"text":"Part your|strong=\"H3068\"heavens|strong=\"H8064\", LORD|strong=\"H3068\", and|strong=\"H3068\"come|strong=\"H3381\"down|strong=\"H3381\".  \nTouch|strong=\"H5060\"the|strong=\"H3068\"mountains|strong=\"H2022\", and|strong=\"H3068\"they|strong=\"H3068\"will|strong=\"H3068\"smoke|strong=\"H6225\".   \n"},{"number":6,"text":"Throw|strong=\"H7971\"out|strong=\"H7971\"lightning|strong=\"H1300\", and|strong=\"H7971\"scatter|strong=\"H6327\"them|strong=\"H7971\".  \nSend|strong=\"H7971\"out|strong=\"H7971\"your|strong=\"H7971\"arrows|strong=\"H2671\", and|strong=\"H7971\"rout them|strong=\"H7971\".   \n"},{"number":7,"text":"Stretch|strong=\"H7971\"out|strong=\"H7971\"your|strong=\"H7971\"hand|strong=\"H3027\"from|strong=\"H3027\"above|strong=\"H4791\",  \nrescue|strong=\"H5337\"me|strong=\"H7971\", and|strong=\"H1121\"deliver|strong=\"H5337\"me|strong=\"H7971\"out|strong=\"H7971\"of|strong=\"H1121\"great|strong=\"H7227\"waters|strong=\"H4325\",  \nout|strong=\"H7971\"of|strong=\"H1121\"the|strong=\"H7971\"hands|strong=\"H3027\"of|strong=\"H1121\"foreigners|strong=\"H1121\",   \n"},{"number":8,"text":"whose mouths|strong=\"H6310\"speak|strong=\"H1696\"deceit|strong=\"H8267\",  \nwhose right|strong=\"H3225\"hand|strong=\"H3225\"is|strong=\"H6310\"a|strong=\"H3068\"right|strong=\"H3225\"hand|strong=\"H3225\"of|strong=\"H6310\"falsehood|strong=\"H8267\".   \n"},{"number":9,"text":"I|strong=\"H7891\"will|strong=\"H7892\"sing|strong=\"H7891\"a|strong=\"H3068\"new|strong=\"H2319\"song|strong=\"H7892\"to|strong=\"H2167\"you|strong=\"H2167\", God.  \nOn|strong=\"H5035\"a|strong=\"H3068\"ten-stringed|strong=\"H6218\"lyre, I|strong=\"H7891\"will|strong=\"H7892\"sing|strong=\"H7891\"praises|strong=\"H2167\"to|strong=\"H2167\"you|strong=\"H2167\".   \n"},{"number":10,"text":"You|strong=\"H5414\"are|strong=\"H5650\"he|strong=\"H1732\"who|strong=\"H5650\"gives|strong=\"H5414\"salvation|strong=\"H8668\"to|strong=\"H5414\"kings|strong=\"H4428\",  \nwho|strong=\"H5650\"rescues|strong=\"H6475\"David|strong=\"H1732\", his|strong=\"H5414\"servant|strong=\"H5650\", from|strong=\"H7451\"the|strong=\"H5414\"deadly|strong=\"H7451\"sword|strong=\"H2719\".   \n"},{"number":11,"text":"Rescue|strong=\"H5337\"me|strong=\"H1696\", and|strong=\"H1121\"deliver|strong=\"H5337\"me|strong=\"H1696\"out|strong=\"H5337\"of|strong=\"H1121\"the|strong=\"H3027\"hands|strong=\"H3027\"of|strong=\"H1121\"foreigners|strong=\"H1121\",  \nwhose|strong=\"H1121\"mouths|strong=\"H6310\"speak|strong=\"H1696\"deceit|strong=\"H8267\",  \nwhose|strong=\"H1121\"right|strong=\"H3225\"hand|strong=\"H3027\"is|strong=\"H3027\"a|strong=\"H3068\"right|strong=\"H3225\"hand|strong=\"H3027\"of|strong=\"H1121\"falsehood|strong=\"H8267\".   \n"},{"number":12,"text":"Then|strong=\"H1121\"our sons|strong=\"H1121\"will|strong=\"H1121\"be|strong=\"H1121\"like|strong=\"H1121\"well-nurtured plants|strong=\"H5195\",  \nour daughters|strong=\"H1323\"like|strong=\"H1121\"pillars|strong=\"H2106\"carved|strong=\"H2404\"to|strong=\"H1121\"adorn a|strong=\"H3068\"palace|strong=\"H1964\".   \n"},{"number":13,"text":"Our barns are|strong=\"H4392\"full|strong=\"H4392\", filled|strong=\"H4392\"with|strong=\"H6629\"all kinds|strong=\"H2177\"of|strong=\"H4392\"provision.  \nOur sheep|strong=\"H6629\"produce thousands|strong=\"H7231\"and|strong=\"H6629\"ten thousands|strong=\"H7231\"in|strong=\"H6629\"our fields|strong=\"H2351\".   \n"},{"number":14,"text":"Our|strong=\"H3318\"oxen will pull|strong=\"H3318\"heavy loads.  \nThere is no breaking|strong=\"H6556\"in|strong=\"H3318\", and|strong=\"H3318\"no going|strong=\"H3318\"away|strong=\"H3318\",  \nand|strong=\"H3318\"no outcry|strong=\"H6682\"in|strong=\"H3318\"our|strong=\"H3318\"streets|strong=\"H7339\".   \n"},{"number":15,"text":"Happy are|strong=\"H5971\"the|strong=\"H3068\"people|strong=\"H5971\"who|strong=\"H5971\"are|strong=\"H5971\"in|strong=\"H3068\"such|strong=\"H3602\"a|strong=\"H3068\"situation.  \nHappy are|strong=\"H5971\"the|strong=\"H3068\"people|strong=\"H5971\"whose God|strong=\"H3068\"is|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\".   \n"}]}
