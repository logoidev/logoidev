{"verses":[{"number":1,"text":"To|strong=\"H3068\"you|strong=\"H5315\", LORD|strong=\"H3068\", I|strong=\"H5315\"lift|strong=\"H5375\"up|strong=\"H5375\"my|strong=\"H3068\"soul|strong=\"H5315\".   \n"},{"number":2,"text":"My God, I have trusted in you.  \nDon’t let|strong=\"H5970\"me be shamed.  \nDon’t let|strong=\"H5970\"my enemies triumph|strong=\"H5970\"over me.   \n"},{"number":3,"text":"Yes|strong=\"H1571\", no|strong=\"H3808\"one|strong=\"H3605\"who|strong=\"H3605\"waits|strong=\"H6960\"for|strong=\"H6960\"you|strong=\"H3605\"will|strong=\"H1571\"be|strong=\"H3808\"shamed.  \nThey|strong=\"H3808\"will|strong=\"H1571\"be|strong=\"H3808\"shamed who|strong=\"H3605\"deal treacherously without|strong=\"H3808\"cause|strong=\"H7387\".   \n"},{"number":4,"text":"Show|strong=\"H3045\"me|strong=\"H3925\"your|strong=\"H3068\"ways|strong=\"H1870\", LORD|strong=\"H3068\".  \nTeach|strong=\"H3925\"me|strong=\"H3925\"your|strong=\"H3068\"paths|strong=\"H1870\".   \n"},{"number":5,"text":"Guide|strong=\"H1869\"me|strong=\"H3925\"in|strong=\"H3117\"your|strong=\"H3605\"truth, and|strong=\"H3117\"teach|strong=\"H3925\"me|strong=\"H3925\",  \nfor|strong=\"H3588\"you|strong=\"H3588\"are|strong=\"H3117\"the|strong=\"H3605\"God of|strong=\"H3117\"my|strong=\"H3605\"salvation|strong=\"H3468\".  \nI|strong=\"H3588\"wait|strong=\"H6960\"for|strong=\"H3588\"you|strong=\"H3588\"all|strong=\"H3605\"day|strong=\"H3117\"long|strong=\"H3117\".   \n"},{"number":6,"text":"LORD|strong=\"H3068\", remember|strong=\"H2142\"your|strong=\"H3068\"tender mercies|strong=\"H7356\"and|strong=\"H3068\"your|strong=\"H3068\"loving kindness|strong=\"H2617\",  \nfor|strong=\"H3588\"they|strong=\"H1992\"are|strong=\"H1992\"from|strong=\"H3068\"old|strong=\"H5769\"times|strong=\"H5769\".   \n"},{"number":7,"text":"Don’t remember|strong=\"H2142\"the|strong=\"H3068\"sins|strong=\"H2403\"of|strong=\"H3068\"my|strong=\"H3068\"youth|strong=\"H5271\", nor my|strong=\"H3068\"transgressions|strong=\"H6588\".  \nRemember|strong=\"H2142\"me|strong=\"H5271\"according to|strong=\"H3068\"your|strong=\"H3068\"loving kindness|strong=\"H2617\",  \nfor|strong=\"H3068\"your|strong=\"H3068\"goodness|strong=\"H2898\"’ sake|strong=\"H4616\", LORD|strong=\"H3068\".   \n"},{"number":8,"text":"Good|strong=\"H2896\"and|strong=\"H3068\"upright|strong=\"H3477\"is|strong=\"H3068\"the|strong=\"H5921\"LORD|strong=\"H3068\",  \ntherefore|strong=\"H3651\"he|strong=\"H3651\"will|strong=\"H3068\"instruct|strong=\"H3384\"sinners|strong=\"H2400\"in|strong=\"H5921\"the|strong=\"H5921\"way|strong=\"H1870\".   \n"},{"number":9,"text":"He will|strong=\"H6035\"guide|strong=\"H1869\"the|strong=\"H1870\"humble|strong=\"H6035\"in|strong=\"H1870\"justice|strong=\"H4941\".  \nHe will|strong=\"H6035\"teach|strong=\"H3925\"the|strong=\"H1870\"humble|strong=\"H6035\"his|strong=\"H1869\"way|strong=\"H1870\".   \n"},{"number":10,"text":"All|strong=\"H3605\"the|strong=\"H3605\"paths of|strong=\"H3068\"the|strong=\"H3605\"LORD|strong=\"H3068\"are|strong=\"H3068\"loving kindness|strong=\"H2617\"and|strong=\"H3068\"truth  \nto|strong=\"H3068\"such|strong=\"H3605\"as|strong=\"H3068\"keep|strong=\"H5341\"his|strong=\"H3605\"covenant|strong=\"H1285\"and|strong=\"H3068\"his|strong=\"H3605\"testimonies|strong=\"H5713\".   \n"},{"number":11,"text":"For|strong=\"H3588\"your|strong=\"H3068\"name|strong=\"H8034\"’s sake|strong=\"H4616\", LORD|strong=\"H3068\",  \npardon|strong=\"H5545\"my|strong=\"H3068\"iniquity|strong=\"H5771\", for|strong=\"H3588\"it|strong=\"H1931\"is|strong=\"H3068\"great|strong=\"H7227\".   \n"},{"number":12,"text":"What|strong=\"H4310\"man|strong=\"H2088\"is|strong=\"H3068\"he|strong=\"H3068\"who|strong=\"H4310\"fears|strong=\"H3373\"the|strong=\"H3068\"LORD|strong=\"H3068\"?  \nHe|strong=\"H3068\"shall|strong=\"H3068\"instruct|strong=\"H3384\"him|strong=\"H3384\"in|strong=\"H3068\"the|strong=\"H3068\"way|strong=\"H1870\"that|strong=\"H3068\"he|strong=\"H3068\"shall|strong=\"H3068\"choose.   \n"},{"number":13,"text":"His|strong=\"H3423\"soul|strong=\"H5315\"will|strong=\"H5315\"dwell|strong=\"H3885\"at|strong=\"H5315\"ease|strong=\"H2896\".  \nHis|strong=\"H3423\"offspring|strong=\"H2233\"will|strong=\"H5315\"inherit|strong=\"H3423\"the|strong=\"H3423\"land.   \n"},{"number":14,"text":"The|strong=\"H3068\"friendship|strong=\"H5475\"of|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\"is|strong=\"H3068\"with|strong=\"H3068\"those who|strong=\"H3068\"fear|strong=\"H3373\"him|strong=\"H3045\".  \nHe|strong=\"H3068\"will|strong=\"H3068\"show|strong=\"H3045\"them|strong=\"H3068\"his|strong=\"H3068\"covenant|strong=\"H1285\".   \n"},{"number":15,"text":"My|strong=\"H3068\"eyes|strong=\"H5869\"are|strong=\"H5869\"ever|strong=\"H8548\"on|strong=\"H3068\"the|strong=\"H3588\"LORD|strong=\"H3068\",  \nfor|strong=\"H3588\"he|strong=\"H1931\"will|strong=\"H3068\"pluck|strong=\"H3318\"my|strong=\"H3068\"feet|strong=\"H7272\"out|strong=\"H3318\"of|strong=\"H3068\"the|strong=\"H3588\"net|strong=\"H7568\".   \n"},{"number":16,"text":"Turn|strong=\"H6437\"to|strong=\"H6437\"me|strong=\"H2603\", and|strong=\"H6041\"have|strong=\"H3588\"mercy|strong=\"H2603\"on|strong=\"H6437\"me|strong=\"H2603\",  \nfor|strong=\"H3588\"I|strong=\"H3588\"am desolate|strong=\"H3173\"and|strong=\"H6041\"afflicted|strong=\"H6041\".   \n"},{"number":17,"text":"The|strong=\"H3318\"troubles|strong=\"H6869\"of|strong=\"H3318\"my|strong=\"H3318\"heart|strong=\"H3824\"are|strong=\"H3824\"enlarged|strong=\"H7337\".  \nOh bring|strong=\"H3318\"me|strong=\"H3318\"out|strong=\"H3318\"of|strong=\"H3318\"my|strong=\"H3318\"distresses|strong=\"H4691\".   \n"},{"number":18,"text":"Consider|strong=\"H7200\"my|strong=\"H3605\"affliction|strong=\"H6040\"and|strong=\"H7200\"my|strong=\"H3605\"travail|strong=\"H5999\".  \nForgive|strong=\"H5375\"all|strong=\"H3605\"my|strong=\"H3605\"sins|strong=\"H2403\".   \n"},{"number":19,"text":"Consider|strong=\"H7200\"my|strong=\"H7200\"enemies|strong=\"H8130\", for|strong=\"H3588