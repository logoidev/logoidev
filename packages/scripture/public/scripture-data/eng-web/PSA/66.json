{"verses":[{"number":1,"text":"Make a|strong=\"H3068\"joyful shout|strong=\"H7321\"to|strong=\"H3605\"God, all|strong=\"H3605\"the|strong=\"H3605\"earth!   \n"},{"number":2,"text":"Sing|strong=\"H2167\"to|strong=\"H8034\"the|strong=\"H7760\"glory|strong=\"H3519\"of|strong=\"H8034\"his|strong=\"H7760\"name|strong=\"H8034\"!  \nOffer glory|strong=\"H3519\"and|strong=\"H8034\"praise|strong=\"H8416\"!   \n"},{"number":3,"text":"Tell God, “How|strong=\"H4100\"awesome|strong=\"H3372\"are|strong=\"H4100\"your|strong=\"H3372\"deeds|strong=\"H4639\"!  \nThrough the|strong=\"H3372\"greatness|strong=\"H7230\"of|strong=\"H7230\"your|strong=\"H3372\"power|strong=\"H5797\", your|strong=\"H3372\"enemies submit|strong=\"H3584\"themselves to|strong=\"H3372\"you|strong=\"H4100\".   \n"},{"number":4,"text":"All|strong=\"H3605\"the|strong=\"H3605\"earth will|strong=\"H8034\"worship|strong=\"H7812\"you|strong=\"H3605\",  \nand|strong=\"H8034\"will|strong=\"H8034\"sing|strong=\"H2167\"to|strong=\"H8034\"you|strong=\"H3605\";  \nthey|strong=\"H3605\"will|strong=\"H8034\"sing|strong=\"H2167\"to|strong=\"H8034\"your|strong=\"H3605\"name|strong=\"H8034\".” \\+w Selah|strong=\"H5542\"\\+w*."},{"number":5,"text":"Come|strong=\"H3212\", and|strong=\"H1121\"see|strong=\"H7200\"God’s deeds|strong=\"H5949\"—  \nawesome|strong=\"H3372\"work on|strong=\"H5921\"behalf|strong=\"H5921\"of|strong=\"H1121\"the|strong=\"H5921\"children|strong=\"H1121\"of|strong=\"H1121\"men|strong=\"H1121\".   \n"},{"number":6,"text":"He|strong=\"H8033\"turned|strong=\"H2015\"the|strong=\"H5674\"sea|strong=\"H3220\"into|strong=\"H2015\"dry|strong=\"H3004\"land|strong=\"H3004\".  \nThey|strong=\"H8033\"went|strong=\"H5674\"through|strong=\"H5674\"the|strong=\"H5674\"river|strong=\"H5104\"on|strong=\"H5674\"foot|strong=\"H7272\".  \nThere|strong=\"H8033\", we|strong=\"H3068\"rejoiced|strong=\"H8055\"in|strong=\"H8055\"him|strong=\"H8055\".   \n"},{"number":7,"text":"He rules|strong=\"H4910\"by|strong=\"H5869\"his|strong=\"H7311\"might|strong=\"H1369\"forever|strong=\"H5769\".  \nHis|strong=\"H7311\"eyes|strong=\"H5869\"watch|strong=\"H6822\"the|strong=\"H7311\"nations|strong=\"H1471\".  \nDon’t let the|strong=\"H7311\"rebellious|strong=\"H5637\"rise|strong=\"H7311\"up|strong=\"H7311\"against|strong=\"H1471\"him|strong=\"H5869\". \\+w Selah|strong=\"H5542\"\\+w*."},{"number":8,"text":"Praise|strong=\"H8416\"our|strong=\"H1288\"God, you|strong=\"H1288\"peoples|strong=\"H5971\"!  \nMake|strong=\"H8085\"the|strong=\"H8085\"sound|strong=\"H6963\"of|strong=\"H6963\"his|strong=\"H8085\"praise|strong=\"H8416\"heard|strong=\"H8085\",   \n"},{"number":9,"text":"who|strong=\"H5315\"preserves our|strong=\"H5414\"life|strong=\"H5315\"among|strong=\"H3808\"the|strong=\"H5414\"living|strong=\"H2416\",  \nand|strong=\"H5315\"doesn’t allow|strong=\"H5414\"our|strong=\"H5414\"feet|strong=\"H7272\"to|strong=\"H5414\"be|strong=\"H3808\"moved|strong=\"H4132\".   \n"},{"number":10,"text":"For|strong=\"H3588\"you|strong=\"H3588\", God, have|strong=\"H3588\"tested|strong=\"H6884\"us|strong=\"H3588\".  \nYou|strong=\"H3588\"have|strong=\"H3588\"refined|strong=\"H6884\"us|strong=\"H3588\", as|strong=\"H3588\"silver|strong=\"H3701\"is|strong=\"H3701\"refined|strong=\"H6884\".   \n"},{"number":11,"text":"You|strong=\"H7760\"brought|strong=\"H7760\"us|strong=\"H7760\"into|strong=\"H7760\"prison.  \nYou|strong=\"H7760\"laid|strong=\"H7760\"a|strong=\"H3068\"burden|strong=\"H4157\"on|strong=\"H7760\"our|strong=\"H7760\"backs.   \n"},{"number":12,"text":"You|strong=\"H4325\"allowed men|strong=\"H7218\"to|strong=\"H3318\"ride|strong=\"H7392\"over|strong=\"H7218\"our|strong=\"H3318\"heads|strong=\"H7218\".  \nWe went|strong=\"H3318\"through|strong=\"H3318\"fire and|strong=\"H7218\"through|strong=\"H3318\"water|strong=\"H4325\",  \nbut|strong=\"H4325\"you|strong=\"H4325\"brought|strong=\"H3318\"us to|strong=\"H3318\"the|strong=\"H3318\"place|strong=\"H7218\"of|strong=\"H7218\"abundance|strong=\"H7310\".   \n"},{"number":13,"text":"I|strong=\"H1004\"will|strong=\"H1004\"come into your|strong=\"H7999\"temple|strong=\"H1004\"with|strong=\"H1004\"burnt|strong=\"H5930\"offerings|strong=\"H5930\".  \nI|strong=\"H1004\"will|strong=\"H1004\"pay|strong=\"H7999\"my|strong=\"H7999\"vows|strong=\"H5088\"to|strong=\"H1004\"you|strong=\"H1004\",  \n"},{"number":14,"text":"which my|strong=\"H1696\"lips|strong=\"H8193\"promised|strong=\"H1696\",  \nand|strong=\"H6310\"my|strong=\"H1696\"mouth|strong=\"H6310\"spoke|strong=\"H1696\", when|strong=\"H1696\"I|strong=\"H6862\"was|strong=\"H6310\"in|strong=\"H1696\"distress|strong=\"H6862\".   \n"},{"number":15,"text":"I|strong=\"H6213\"will|strong=\"H6213\"offer|strong=\"H5927\"to|strong=\"H5927\"you|strong=\"H6213\"burnt|strong=\"H5930\"offerings|strong=\"H5930\"of|strong=\"H6213\"fat|strong=\"H4220\"animals,  \nwith|strong=\"H5973\"the|strong=\"H6213\"offering|strong=\"H5930\"of|strong=\"H6213\"rams|strong=\"H6260\",  \nI|strong=\"H6213\"will|strong=\"H6213\"offer|strong=\"H5927\"bulls|strong=\"H1241\"with|strong=\"H5973\"goats|strong=\"H6260\". \\+w Selah|strong=\"H5542\"\\+w*."},{"number":16,"text":"Come|strong=\"H3212\"and|strong=\"H3212\"hear|strong=\"H8085\", all|strong=\"H3605\"you|strong=\"H3605\"who|strong=\"H3605\"fear|strong=\"H3373\"God.  \nI|strong=\"H5315\"will|strong=\"H5315\"declare|strong=\"H5608\"what|strong=\"H6213\"he|strong=\"H6213\"has|strong=\"H5315\"done|strong=\"H6213\"for|strong=\"H6213\"my|strong=\"H8085\"soul|strong=\"H5315\".   \n"},{"number":17,"text":"I|strong=\"H8478\"cried|strong=\"H7121\"to|strong=\"H7121\"him|strong=\"H7121\"with|strong=\"H6310\"my|strong=\"H8478\"mouth|strong=\"H6310\".  \nHe|strong=\"H7121\"was|strong=\"H6310\"extolled with|strong=\"H6310\"my|strong=\"H8478\"tongue|strong=\"H3956\".   \n"},{"number":18,"text":"If|strong=\"H7200\"I|strong=\"H7200\"cherished sin in|strong=\"H8085\"my|strong=\"H8085\"heart|strong=\"H3820\",  \nthe|strong=\"H8085\"Lord wouldn’t have|strong=\"H7200\"listened|strong=\"H8085\".   \n"},{"number":19,"text":"But|strong=\"H8085\"most certainly|strong=\"H8085\", God has listened|strong=\"H8085\".  \nHe has heard|strong=\"H8085\"the|strong=\"H8085\"voice|strong=\"H6963\"of|strong=\"H6963\"my|strong=\"H8085\"prayer|strong=\"H8605\".   \n"},{"number":20,"text":"Blessed|strong=\"H1288\"be|strong=\"H3808\"God|strong=\"H3808\", who|strong=\"H5493\"has not|strong=\"H3808\"turned|strong=\"H5493\"away|strong=\"H5493\"my|strong=\"H5493\"prayer|strong=\"H8605\",  \nnor|strong=\"H3808\"his|strong=\"H5493\"loving kindness|strong=\"H2617\"from|strong=\"H5493\"me|strong=\"H1288\".   \n"}]}
