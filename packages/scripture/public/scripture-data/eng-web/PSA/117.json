{"verses":[{"number":1,"text":"Praise|strong=\"H1984\"the|strong=\"H3605\"LORD|strong=\"H3068\", all|strong=\"H3605\"you|strong=\"H3605\"nations|strong=\"H1471\"!  \nExtol|strong=\"H7623\"him|strong=\"H3605\", all|strong=\"H3605\"you|strong=\"H3605\"peoples!   \n"},{"number":2,"text":"For|strong=\"H3588\"his|strong=\"H3068\"loving kindness|strong=\"H2617\"is|strong=\"H3068\"great|strong=\"H1396\"toward|strong=\"H5921\"us|strong=\"H5921\".  \nThe|strong=\"H5921\"LORD|strong=\"H3068\"’s faithfulness|strong=\"H2617\"endures|strong=\"H5769\"forever|strong=\"H5769\".  \nPraise|strong=\"H1984\"the|strong=\"H5921\"LORD|strong=\"H3068\"!   \n"}]}
