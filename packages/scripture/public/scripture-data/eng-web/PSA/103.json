{"verses":[{"number":1,"text":"Praise|strong=\"H1288\"the|strong=\"H3605\"LORD|strong=\"H3068\", my|strong=\"H3605\"soul|strong=\"H5315\"!  \nAll|strong=\"H3605\"that|strong=\"H3605\"is|strong=\"H3068\"within|strong=\"H7130\"me|strong=\"H5315\", praise|strong=\"H1288\"his|strong=\"H3605\"holy|strong=\"H6944\"name|strong=\"H8034\"!   \n"},{"number":2,"text":"Praise|strong=\"H1288\"the|strong=\"H3605\"LORD|strong=\"H3068\", my|strong=\"H3605\"soul|strong=\"H5315\",  \nand|strong=\"H3068\"don’t forget|strong=\"H7911\"all|strong=\"H3605\"his|strong=\"H3605\"benefits|strong=\"H1576\",   \n"},{"number":3,"text":"who|strong=\"H3605\"forgives all|strong=\"H3605\"your|strong=\"H3605\"sins|strong=\"H5771\",  \nwho|strong=\"H3605\"heals|strong=\"H7495\"all|strong=\"H3605\"your|strong=\"H3605\"diseases|strong=\"H8463\",   \n"},{"number":4,"text":"who|strong=\"H2416\"redeems|strong=\"H1350\"your|strong=\"H1350\"life|strong=\"H2416\"from|strong=\"H2416\"destruction|strong=\"H7845\",  \nwho|strong=\"H2416\"crowns|strong=\"H5849\"you|strong=\"H7356\"with|strong=\"H2416\"loving kindness|strong=\"H2617\"and|strong=\"H2617\"tender mercies|strong=\"H7356\",   \n"},{"number":5,"text":"who|strong=\"H2896\"satisfies|strong=\"H7646\"your|strong=\"H7646\"desire with|strong=\"H7646\"good|strong=\"H2896\"things|strong=\"H2896\",  \nso that|strong=\"H5404\"your|strong=\"H7646\"youth|strong=\"H5271\"is|strong=\"H2896\"renewed|strong=\"H2318\"like|strong=\"H2896\"the|strong=\"H2318\"eagle|strong=\"H5404\"’s.   \n"},{"number":6,"text":"The|strong=\"H3605\"LORD|strong=\"H3068\"executes|strong=\"H6213\"righteous|strong=\"H6666\"acts|strong=\"H6213\",  \nand|strong=\"H3068\"justice|strong=\"H4941\"for|strong=\"H6213\"all|strong=\"H3605\"who|strong=\"H3605\"are|strong=\"H3068\"oppressed|strong=\"H6231\".   \n"},{"number":7,"text":"He|strong=\"H4872\"made|strong=\"H3045\"known|strong=\"H3045\"his|strong=\"H3045\"ways|strong=\"H1870\"to|strong=\"H3478\"Moses|strong=\"H4872\",  \nhis|strong=\"H3045\"deeds|strong=\"H5949\"to|strong=\"H3478\"the|strong=\"H3045\"children|strong=\"H1121\"of|strong=\"H1121\"Israel|strong=\"H3478\".   \n"},{"number":8,"text":"The|strong=\"H3068\"LORD|strong=\"H3068\"is|strong=\"H3068\"merciful|strong=\"H7349\"and|strong=\"H3068\"gracious|strong=\"H2587\",  \nslow to|strong=\"H3068\"anger, and|strong=\"H3068\"abundant|strong=\"H7227\"in|strong=\"H3068\"loving kindness|strong=\"H2617\".   \n"},{"number":9,"text":"He|strong=\"H3808\"will|strong=\"H3808\"not|strong=\"H3808\"always|strong=\"H5769\"accuse|strong=\"H7378\";  \nneither|strong=\"H3808\"will|strong=\"H3808\"he|strong=\"H3808\"stay angry|strong=\"H5201\"forever|strong=\"H5769\".   \n"},{"number":10,"text":"He|strong=\"H6213\"has|strong=\"H6213\"not|strong=\"H3808\"dealt|strong=\"H6213\"with|strong=\"H6213\"us|strong=\"H5921\"according|strong=\"H5921\"to|strong=\"H5921\"our|strong=\"H5921\"sins|strong=\"H2399\",  \nnor|strong=\"H3808\"repaid|strong=\"H1580\"us|strong=\"H5921\"for|strong=\"H5921\"our|strong=\"H5921\"iniquities|strong=\"H5771\".   \n"},{"number":11,"text":"For|strong=\"H3588\"as|strong=\"H3588\"the|strong=\"H5921\"heavens|strong=\"H8064\"are|strong=\"H8064\"high|strong=\"H1361\"above|strong=\"H5921\"the|strong=\"H5921\"earth|strong=\"H8064\",  \nso|strong=\"H3588\"great|strong=\"H1396\"is|strong=\"H2617\"his|strong=\"H5921\"loving kindness|strong=\"H2617\"toward|strong=\"H5921\"those|strong=\"H5921\"who|strong=\"H3588\"fear|strong=\"H3373\"him|strong=\"H5921\".   \n"},{"number":12,"text":"As|strong=\"H6588\"far|strong=\"H7368\"as|strong=\"H6588\"the|strong=\"H4480\"east|strong=\"H4217\"is|strong=\"H6588\"from|strong=\"H4480\"the|strong=\"H4480\"west|strong=\"H4628\",  \nso|strong=\"H4480\"far|strong=\"H7368\"has he|strong=\"H4480\"removed|strong=\"H7368\"our|strong=\"H4480\"transgressions|strong=\"H6588\"from|strong=\"H4480\"us|strong=\"H4480\".   \n"},{"number":13,"text":"Like|strong=\"H1121\"a|strong=\"H3068\"father|strong=\"H1121\"has|strong=\"H3068\"compassion|st