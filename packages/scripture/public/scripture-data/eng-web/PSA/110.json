{"verses":[{"number":1,"text":"The|strong=\"H5002\"LORD|strong=\"H3068\"says|strong=\"H5002\"to|strong=\"H5704\"my|strong=\"H3068\"Lord|strong=\"H3068\", “Sit|strong=\"H3427\"at|strong=\"H3427\"my|strong=\"H3068\"right|strong=\"H3225\"hand|strong=\"H3225\",  \nuntil|strong=\"H5704\"I|strong=\"H5704\"make|strong=\"H7896\"your|strong=\"H3068\"enemies your|strong=\"H3068\"footstool|strong=\"H1916\"for|strong=\"H5704\"your|strong=\"H3068\"feet|strong=\"H7272\".”   \n"},{"number":2,"text":"The|strong=\"H3068\"LORD|strong=\"H3068\"will|strong=\"H3068\"send|strong=\"H7971\"out|strong=\"H7971\"the|strong=\"H3068\"rod|strong=\"H4294\"of|strong=\"H3068\"your|strong=\"H3068\"strength|strong=\"H5797\"out|strong=\"H7971\"of|strong=\"H3068\"Zion|strong=\"H6726\".  \nRule|strong=\"H7287\"among|strong=\"H7130\"your|strong=\"H3068\"enemies.   \n"},{"number":3,"text":"Your|strong=\"H3117\"people|strong=\"H5971\"offer themselves willingly|strong=\"H5071\"in|strong=\"H3117\"the|strong=\"H3117\"day|strong=\"H3117\"of|strong=\"H3117\"your|strong=\"H3117\"power|strong=\"H2428\", in|strong=\"H3117\"holy|strong=\"H6944\"array|strong=\"H1926\".  \nOut of|strong=\"H3117\"the|strong=\"H3117\"womb|strong=\"H7358\"of|strong=\"H3117\"the|strong=\"H3117\"morning|strong=\"H4891\", you|strong=\"H3117\"have|strong=\"H5971\"the|strong=\"H3117\"dew|strong=\"H2919\"of|strong=\"H3117\"your|strong=\"H3117\"youth|strong=\"H3208\".   \n"},{"number":4,"text":"The|strong=\"H5921\"LORD|strong=\"H3068\"has|strong=\"H3068\"sworn|strong=\"H7650\", and|strong=\"H3068\"will|strong=\"H3068\"not|strong=\"H3808\"change|strong=\"H5162\"his|strong=\"H3068\"mind|strong=\"H5162\":  \n“You|strong=\"H5921\"are|strong=\"H3068\"a|strong=\"H3068\"priest|strong=\"H3548\"forever|strong=\"H5769\"in|strong=\"H5921\"the|strong=\"H5921\"order|strong=\"H1700\"of|strong=\"H3068\"Melchizedek|strong=\"H4442\".”   \n"},{"number":5,"text":"The|strong=\"H5921\"Lord|strong=\"H3225\"is|strong=\"H3117\"at|strong=\"H5921\"your|strong=\"H5921\"right|strong=\"H3225\"hand|strong=\"H3225\".  \nHe|strong=\"H3117\"will|strong=\"H4428\"crush|strong=\"H4272\"kings|strong=\"H4428\"in|strong=\"H5921\"the|strong=\"H5921\"day|strong=\"H3117\"of|strong=\"H4428\"his|strong=\"H5921\"wrath.   \n"},{"number":6,"text":"He|strong=\"H5921\"will|strong=\"H1471\"judge|strong=\"H1777\"among|strong=\"H5921\"the|strong=\"H5921\"nations|strong=\"H1471\".  \nHe|strong=\"H5921\"will|strong=\"H1471\"heap up|strong=\"H5921\"dead|strong=\"H1472\"bodies|strong=\"H1472\".  \nHe|strong=\"H5921\"will|strong=\"H1471\"crush|strong=\"H4272\"the|strong=\"H5921\"ruler of|strong=\"H7218\"the|strong=\"H5921\"whole earth.   \n"},{"number":7,"text":"He|strong=\"H3651\"will|strong=\"H5158\"drink|strong=\"H8354\"of|strong=\"H7218\"the|strong=\"H5921\"brook|strong=\"H5158\"on|strong=\"H5921\"the|strong=\"H5921\"way|strong=\"H1870\";  \ntherefore|strong=\"H3651\"he|strong=\"H3651\"will|strong=\"H5158\"lift|strong=\"H7311\"up|strong=\"H7311\"his|strong=\"H5921\"head|strong=\"H7218\".   \n"}]}
