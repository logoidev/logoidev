{"verses":[{"number":1,"text":"LORD|strong=\"H3068\", remember|strong=\"H2142\"David|strong=\"H1732\"and|strong=\"H3068\"all|strong=\"H3605\"his|strong=\"H3605\"affliction|strong=\"H6031\",   \n"},{"number":2,"text":"how he|strong=\"H3068\"swore|strong=\"H7650\"to|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\",  \nand|strong=\"H3068\"vowed|strong=\"H5087\"to|strong=\"H3068\"the|strong=\"H3068\"Mighty One|strong=\"H3068\"of|strong=\"H3068\"Jacob|strong=\"H3290\":   \n"},{"number":3,"text":"“Surely|strong=\"H5927\"I|strong=\"H5921\"will|strong=\"H1004\"not|strong=\"H5927\"come|strong=\"H5927\"into|strong=\"H5927\"the|strong=\"H5921\"structure of|strong=\"H1004\"my|strong=\"H5921\"house|strong=\"H1004\",  \nnor go|strong=\"H5927\"up|strong=\"H5927\"into|strong=\"H5927\"my|strong=\"H5921\"bed|strong=\"H3326\";   \n"},{"number":4,"text":"I|strong=\"H5414\"will|strong=\"H5869\"not|strong=\"H5414\"give|strong=\"H5414\"sleep|strong=\"H8153\"to|strong=\"H5414\"my|strong=\"H5414\"eyes|strong=\"H5869\",  \nor slumber|strong=\"H8572\"to|strong=\"H5414\"my|strong=\"H5414\"eyelids|strong=\"H6079\",   \n"},{"number":5,"text":"until|strong=\"H5704\"I|strong=\"H5704\"find|strong=\"H4672\"out|strong=\"H4672\"a|strong=\"H3068\"place|strong=\"H4725\"for|strong=\"H5704\"the|strong=\"H3068\"LORD|strong=\"H3068\",  \na|strong=\"H3068\"dwelling|strong=\"H4908\"for|strong=\"H5704\"the|strong=\"H3068\"Mighty One|strong=\"H3068\"of|strong=\"H3068\"Jacob|strong=\"H3290\".”   \n"},{"number":6,"text":"Behold|strong=\"H2009\", we|strong=\"H3068\"heard|strong=\"H8085\"of|strong=\"H7704\"it|strong=\"H4672\"in|strong=\"H8085\"Ephrathah.  \nWe|strong=\"H8085\"found|strong=\"H4672\"it|strong=\"H4672\"in|strong=\"H8085\"the|strong=\"H8085\"field|strong=\"H7704\"of|strong=\"H7704\"Jaar|strong=\"H3293\".   \n"},{"number":7,"text":"“We will|strong=\"H7272\"go|strong=\"H7272\"into his|strong=\"H7812\"dwelling|strong=\"H4908\"place|strong=\"H4908\".  \nWe will|strong=\"H7272\"worship|strong=\"H7812\"at|strong=\"H4908\"his|strong=\"H7812\"footstool|strong=\"H1916\".”   \n"},{"number":8,"text":"Arise|strong=\"H6965\", LORD|strong=\"H3068\", into|strong=\"H5797\"your|strong=\"H3068\"resting|strong=\"H4496\"place|strong=\"H4496\",  \nyou|strong=\"H6965\", and|strong=\"H6965\"the|strong=\"H3068\"ark of|strong=\"H3068\"your|strong=\"H3068\"strength|strong=\"H5797\".   \n"},{"number":9,"text":"Let your priests|strong=\"H3548\"be|strong=\"H3548\"clothed|strong=\"H3847\"with|strong=\"H3847\"righteousness|strong=\"H6664\".  \nLet your saints|strong=\"H2623\"shout|strong=\"H7442\"for|strong=\"H7442\"joy|strong=\"H7442\"!   \n"},{"number":10,"text":"For|strong=\"H6440\"your|strong=\"H6440\"servant|strong=\"H5650\"David|strong=\"H1732\"’s sake|strong=\"H5668\",  \ndon’t turn|strong=\"H7725\"away|strong=\"H7725\"the|strong=\"H6440\"face|strong=\"H6440\"of|strong=\"H6440\"your|strong=\"H6440\"anointed|strong=\"H4899\"one.   \n"},{"number":11,"text":"The|strong=\"H3068\"LORD|strong=\"H3068\"has|strong=\"H3068\"sworn|strong=\"H7650\"to|strong=\"H7725\"David|strong=\"H1732\"in|strong=\"H3068\"truth|strong=\"H3808\".  \nHe|strong=\"H3068\"will|strong=\"H3068\"not|strong=\"H3808\"turn|strong=\"H7725\"from|strong=\"H4480\"it|strong=\"H7725\":  \n“I|strong=\"H3808\"will|strong=\"H3068\"set|strong=\"H7896\"the|strong=\"H3068\"fruit|strong=\"H6529\"of|strong=\"H3068\"your|strong=\"H3068\"body on|strong=\"H3068\"your|strong=\"H3068\"throne|strong=\"H3678\".   \n"},{"number":12,"text":"If|strong=\"H1121\"your|strong=\"H8104\"children|strong=\"H1121\"will|strong=\"H1571\"keep|strong=\"H8104\"my|strong=\"H8104\"covenant|strong=\"H1285\",  \nmy|strong=\"H8104\"testimony|strong=\"H5713\"that|strong=\"H1121\"I|strong=\"H1571\"will|strong=\"H1571\"teach|strong=\"H3925\"them|strong=\"H3925\",  \ntheir|strong=\"H3925\"children|strong=\"H1121\"also|strong=\"H1571\"will|strong=\"H1571\"sit|strong=\"H3427\"on|strong=\"H3427\"your|strong=\"H8104\"throne|strong=\"H3678\"forever|strong=\"H5703\"more|strong=\"H1571\".”   \n"},{"number":13,"text":"For|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"has|strong=\"H3068\"chosen Zion|strong=\"H6726\".  \nHe|strong=\"H3588\"has|strong=\"H3068\"desired it|strong=\"H3588\"for|strong=\"H3588\"his|strong=\"H3068\"habitation|strong=\"H4186\".   \n"},{"number":14,"text":"“This|strong=\"H2063\"is|strong=\"H3427\"my|strong=\"H3588\"resting|strong=\"H4496\"place|strong=\"H4496\"forever|strong=\"H5703\".  \nI|strong=\"H3588\"will|strong=\"H3588\"live|strong=\"H3427\"here|strong=\"H6311\", for|strong=\"H3588\"I|strong=\"H3588\"have|strong=\"H3588\"desired it|strong=\"H3588\".   \n"},{"number":15,"text":"I|strong=\"H1288\"will abundantly|strong=\"H1288\"bless|strong=\"H1288\"her|strong=\"H7646\"provision|strong=\"H6718\".  \nI|strong=\"H1288\"will satisfy|strong=\"H7646\"her|strong=\"H7646\"poor with|strong=\"H7646\"bread|strong=\"H3899\".   \n"},{"number":16,"text":"I will|strong=\"H2623\"also clothe|strong=\"H3847\"her|strong=\"H3847\"priests|strong=\"H3548\"with|strong=\"H3847\"salvation|strong=\"H3468\".  \nHer|strong=\"H3847\"saints|strong=\"H2623\"will|strong=\"H2623\"shout|strong=\"H7442\"aloud|strong=\"H7442\"for|strong=\"H7442\"joy|strong=\"H7442\".   \n"},{"number":17,"text":"I|strong=\"H6779\"will|strong=\"H5216\"make|strong=\"H6779\"the|strong=\"H8033\"horn|strong=\"H7161\"of|strong=\"H7161\"David|strong=\"H1732\"to|strong=\"H1732\"bud|strong=\"H6779\"there|strong=\"H8033\".  \nI|strong=\"H6779\"have|strong=\"H1732\"ordained|strong=\"H6186\"a|strong=\"H3068\"lamp|strong=\"H5216\"for|strong=\"H8033\"my|strong=\"H1732\"anointed|strong=\"H4899\".   \n"},{"number":18,"text":"I|strong=\"H5921\"will clothe|strong=\"H3847\"his|strong=\"H5921\"enemies with|strong=\"H3847\"shame|strong=\"H1322\",  \nbut|strong=\"H5921\"on|strong=\"H5921\"himself, his|strong=\"H5921\"crown|strong=\"H5145\"will shine|strong=\"H6692\".”   \n"}]}
