H3318\"is|strong=\"H7563\"judged|strong=\"H8199\", let|strong=\"H1961\"him|strong=\"H3318\"come|strong=\"H1961\"out|strong=\"H3318\"guilty|strong=\"H7563\".  \nLet|strong=\"H1961\"his|strong=\"H1961\"prayer|strong=\"H8605\"be|strong=\"H1961\"turned|strong=\"H1961\"into|strong=\"H8199\"sin|strong=\"H2401\".   \n"},{"number":8,"text":"Let|strong=\"H1961\"his|strong=\"H3947\"days|strong=\"H3117\"be|strong=\"H1961\"few|strong=\"H4592\".  \nLet|strong=\"H1961\"another take|strong=\"H3947\"his|strong=\"H3947\"office|strong=\"H6486\".   \n"},{"number":9,"text":"Let|strong=\"H1961\"his|strong=\"H1961\"children|strong=\"H1121\"be|strong=\"H1961\"fatherless|strong=\"H3490\",  \nand|strong=\"H1121\"his|strong=\"H1961\"wife a|strong=\"H3068\"widow.   \n"},{"number":10,"text":"Let his|strong=\"H5128\"children|strong=\"H1121\"be|strong=\"H1121\"wandering beggars.  \nLet them|strong=\"H1121\"be|strong=\"H1121\"sought|strong=\"H1875\"from|strong=\"H1121\"their|strong=\"H5128\"ruins|strong=\"H2723\".   \n"},{"number":11,"text":"Let the|strong=\"H3605\"creditor|strong=\"H5383\"seize|strong=\"H3605\"all|strong=\"H3605\"that|strong=\"H3605\"he|strong=\"H3605\"has|strong=\"H3605\".  \nLet strangers|strong=\"H2114\"plunder the|strong=\"H3605\"fruit|strong=\"H3018\"of|strong=\"H3605\"his|strong=\"H3605\"labor|strong=\"H3018\".   \n"},{"number":12,"text":"Let|strong=\"H1961\"there|strong=\"H1961\"be|strong=\"H1961\"no|strong=\"H1961\"one|strong=\"H1961\"to|strong=\"H1961\"extend|strong=\"H1961\"kindness|strong=\"H2617\"to|strong=\"H1961\"him|strong=\"H2603\",  \nneither let|strong=\"H1961\"there|strong=\"H1961\"be|strong=\"H1961\"anyone to|strong=\"H1961\"have|strong=\"H1961\"pity|strong=\"H2603\"on|strong=\"H1961\"his|strong=\"H1961\"fatherless|strong=\"H3490\"children|strong=\"H3490\".   \n"},{"number":13,"text":"Let|strong=\"H1961\"his|strong=\"H1961\"posterity|strong=\"H1755\"be|strong=\"H1961\"cut|strong=\"H3772\"off|strong=\"H3772\".  \nIn|strong=\"H8034\"the|strong=\"H3772\"generation|strong=\"H1755\"following let|strong=\"H1961\"their|strong=\"H1961\"name|strong=\"H8034\"be|strong=\"H1961\"blotted|strong=\"H4229\"out|strong=\"H4229\".   \n"},{"number":14,"text":"Let|strong=\"H2142\"the|strong=\"H3068\"iniquity|strong=\"H5771\"of|strong=\"H3068\"his|strong=\"H3068\"fathers be|strong=\"H3068\"remembered|strong=\"H2142\"by|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\".  \nDon’t let|strong=\"H2142\"the|strong=\"H3068\"sin|strong=\"H2403\"of|strong=\"H3068\"his|strong=\"H3068\"mother be|strong=\"H3068\"blotted|strong=\"H4229\"out|strong=\"H4229\".   \n"},{"number":15,"text":"Let|strong=\"H1961\"them|strong=\"H1961\"be|strong=\"H1961\"before|strong=\"H5048\"the|strong=\"H3068\"LORD|strong=\"H3068\"continually|strong=\"H8548\",  \nthat|strong=\"H3068\"he|strong=\"H3068\"may|strong=\"H1961\"cut|strong=\"H3772\"off|strong=\"H3772\"their|strong=\"H3068\"memory|strong=\"H2143\"from|strong=\"H3772\"the|strong=\"H3068\"earth;   \n"},{"number":16,"text":"because|strong=\"H3282\"he|strong=\"H6213\"didn’t remember|strong=\"H2142\"to|strong=\"H4191\"show|strong=\"H6213\"kindness|strong=\"H2617\",  \nbut|strong=\"H3808\"persecuted|strong=\"H7291\"the|strong=\"H6213\"poor|strong=\"H6041\"and|strong=\"H6041\"needy|strong=\"H6041\"man|strong=\"H4191\",  \nthe|strong=\"H6213\"broken|strong=\"H3512\"in|strong=\"H6213\"heart|strong=\"H3824\", to|strong=\"H4191\"kill|strong=\"H4191\"them|strong=\"H6213\".   \n"},{"number":17,"text":"Yes, he|strong=\"H4480\"loved cursing|strong=\"H7045\", and|strong=\"H1293\"it|strong=\"H3808\"came to|strong=\"H2654\"him|strong=\"H4480\".  \nHe|strong=\"H4480\"didn’t delight|strong=\"H2654\"in|strong=\"H2654\"blessing|strong=\"H1293\", and|strong=\"H1293\"it|strong=\"H3808\"was|strong=\"H3808\"far|strong=\"H7368\"from|strong=\"H4480\"him|strong=\"H4480\".   \n"},{"number":18,"text":"He|strong=\"H7130\"clothed|strong=\"H3847\"himself|strong=\"H4325\"also with|strong=\"H3847\"cursing|strong=\"H7045\"as|strong=\"H4325\"with|strong=\"H3847\"his|strong=\"H7130\"garment|strong=\"H4055\".  \nIt|strong=\"H7130\"came|strong=\"H3847\"into|strong=\"H4325\"his|strong=\"H7130\"inward|strong=\"H7130\"parts|strong=\"H7130\"like|strong=\"H7130\"water|strong=\"H4325\",  \nlike|strong=\"H7130\"oil|strong=\"H8081\"into|strong=\"H4325\"his|strong=\"H7130\"bones|strong=\"H6106\".   \n"},{"number":19,"text":"Let|strong=\"H1961\"it|strong=\"H1961\"be|strong=\"H1961\"to|strong=\"H1961\"him|strong=\"H1961\"as|strong=\"H1961\"the|strong=\"H1961\"clothing with|strong=\"H2296\"which he covers|strong=\"H5844\"himself|strong=\"H5844\",  \nfor|strong=\"H1961\"the|strong=\"H1961\"belt|strong=\"H4206\"that|strong=\"H1961\"is|strong=\"H1961\"always|strong=\"H8548\"around him|strong=\"H1961\".   \n"},{"number":20,"text":"This|strong=\"H2063\"is|strong=\"H3068\"the|strong=\"H5921\"reward|strong=\"H6468\"of|strong=\"H3068\"my|strong=\"H3068\"adversaries|strong=\"H7853\"from|strong=\"H5921\"the|strong=\"H5921\"LORD|strong=\"H3068\",  \nof|strong=\"H3068\"those|strong=\"H5921\"who|strong=\"H3068\"speak|strong=\"H1696\"evil|strong=\"H7451\"against|strong=\"H5921\"my|strong=\"H3068\"soul|strong=\"H5315\".   \n"},{"number":21,"text":"But|strong=\"H3588\"deal|strong=\"H6213\"with|strong=\"H6213\"me|strong=\"H6213\", GOD|strong=\"H3068\"the|strong=\"H3588\"Lord|strong=\"H3069\", for|strong=\"H3588\"your|strong=\"H6213\"name|strong=\"H8034\"’s sake|strong=\"H4616\",  \nbecause|strong=\"H3588\"your|strong=\"H6213\"loving|strong=\"H2896\"kindness|strong=\"H2617\"is|strong=\"H2617\"good|strong=\"H2896\", deliver|strong=\"H5337\"me|strong=\"H6213\";   \n"},{"number":22,"text":"for|strong=\"H3588\"I|strong=\"H3588\"am poor|strong=\"H6041\"and|strong=\"H6041\"needy|strong=\"H6041\".  \nMy|strong=\"H2490\"heart|strong=\"H3820\"is|strong=\"H3820\"wounded|strong=\"H2490\"within|strong=\"H7130\"me|strong=\"H3588\".   \n"},{"number":23,"text":"I|strong=\"H1980\"fade away|strong=\"H1980\"like|strong=\"H1980\"an evening shadow|strong=\"H6738\".  \nI|strong=\"H1980\"am|strong=\"H1980\"shaken|strong=\"H5287\"off|strong=\"H5287\"like|strong=\"H1980\"a|strong=\"H3068\"locust.   \n"},{"number":24,"text":"My|strong=\"H1320\"knees|strong=\"H1290\"are|strong=\"H1290\"weak|strong=\"H3782\"through|strong=\"H3782\"fasting|strong=\"H6685\".  \nMy|strong=\"H1320\"body|strong=\"H1320\"is|strong=\"H1320\"thin and|strong=\"H8081\"lacks fat|strong=\"H8081\".   \n"},{"number":25,"text":"I|strong=\"H7200\"have|strong=\"H1961\"also|strong=\"H1992\"become|strong=\"H1961\"a|strong=\"H3068\"reproach|strong=\"H2781\"to|strong=\"H1961\"them|strong=\"H1992\".  \nWhen|strong=\"H1961\"they|strong=\"H1992\"see|strong=\"H7200\"me|strong=\"H7200\", they|strong=\"H1992\"shake|strong=\"H5128\"their|strong=\"H1992\"head|strong=\"H7218\".   \n"},{"number":26,"text":"Help|strong=\"H5826\"me|strong=\"H3467\", LORD|strong=\"H3068\", my|strong=\"H3068\"God|strong=\"H3068\".  \nSave|strong=\"H3467\"me|strong=\"H3467\"according to|strong=\"H3068\"your|strong=\"H3068\"loving kindness|strong=\"H2617\";   \n"},{"number":27,"text":"that|strong=\"H3588\"they|strong=\"H3588\"may|strong=\"H3068\"know|strong=\"H3045\"that|strong=\"H3588\"this|strong=\"H2063\"is|strong=\"H3068\"your|strong=\"H3068\"hand|strong=\"H3027\";  \nthat|strong=\"H3588\"you|strong=\"H3588\", LORD|strong=\"H3068\", have|strong=\"H3068\"done|strong=\"H6213\"it|strong=\"H3588\".   \n"},{"number":28,"text":"They|strong=\"H1992\"may|strong=\"H1992\"curse|strong=\"H7043\", but|strong=\"H1992\"you|strong=\"H1288\"bless|strong=\"H1288\".  \nWhen|strong=\"H6965\"they|strong=\"H1992\"arise|strong=\"H6965\", they|strong=\"H1992\"will|strong=\"H5650\"be|strong=\"H1288\"shamed,  \nbut|strong=\"H1992\"your|strong=\"H6965\"servant|strong=\"H5650\"shall|strong=\"H5650\"rejoice|strong=\"H8055\".   \n"},{"number":29,"text":"Let my adversaries|strong=\"H7853\"be|strong=\"H7853\"clothed|strong=\"H3847\"with|strong=\"H3847\"dishonor|strong=\"H3639\".  \nLet them|strong=\"H3847\"cover|strong=\"H5844\"themselves with|strong=\"H3847\"their|strong=\"H5844\"own shame|strong=\"H1322\"as with|strong=\"H3847\"a|strong=\"H3068\"robe|strong=\"H4598\".   \n"},{"number":30,"text":"I|strong=\"H3068\"will|strong=\"H3068\"give|strong=\"H3034\"great|strong=\"H7227\"thanks|strong=\"H3034\"to|strong=\"H3068\"the|strong=\"H8432\"LORD|strong=\"H3068\"with|strong=\"H3068\"my|strong=\"H3068\"mouth|strong=\"H6310\".  \nYes, I|strong=\"H3068\"will|strong=\"H3068\"praise|strong=\"H1984\"him|strong=\"H8432\"among|strong=\"H8432\"the|strong=\"H8432\"multitude|strong=\"H7227\".   \n"},{"number":31,"text":"For|strong=\"H3588\"he|strong=\"H3588\"will|strong=\"H5315\"stand|strong=\"H5975\"at|strong=\"H5975\"the|strong=\"H3588\"right|strong=\"H3225\"hand|strong=\"H3225\"of|strong=\"H5315\"the|strong=\"H3588\"needy,  \nto|strong=\"H5315\"save|strong=\"H3467\"him|strong=\"H5975\"from|strong=\"H5315\"those|strong=\"H3467\"who|strong=\"H5315\"judge|strong=\"H8199\"his|strong=\"H3588\"soul|strong=\"H5315\".   \n"}]}
