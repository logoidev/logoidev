H3605\"who|strong=\"H4310\"robs|strong=\"H1497\"him|strong=\"H3605\"?”   \n"},{"number":11,"text":"Unrighteous|strong=\"H2555\"witnesses|strong=\"H5707\"rise|strong=\"H6965\"up|strong=\"H6965\".  \nThey|strong=\"H3808\"ask|strong=\"H7592\"me|strong=\"H7592\"about|strong=\"H3045\"things|strong=\"H7592\"that|strong=\"H3045\"I|strong=\"H3045\"don’t know|strong=\"H3045\"about|strong=\"H3045\".   \n"},{"number":12,"text":"They|strong=\"H5315\"reward|strong=\"H7999\"me|strong=\"H5315\"evil|strong=\"H7451\"for|strong=\"H8478\"good|strong=\"H2896\",  \nto|strong=\"H5315\"the|strong=\"H8478\"bereaving of|strong=\"H8478\"my|strong=\"H8478\"soul|strong=\"H5315\".   \n"},{"number":13,"text":"But|strong=\"H7725\"as|strong=\"H5315\"for|strong=\"H5921\"me|strong=\"H5315\", when|strong=\"H7725\"they|strong=\"H5921\"were|strong=\"H5315\"sick|strong=\"H2470\", my|strong=\"H5921\"clothing|strong=\"H3830\"was|strong=\"H5315\"sackcloth|strong=\"H8242\".  \nI|strong=\"H5921\"afflicted|strong=\"H6031\"my|strong=\"H5921\"soul|strong=\"H5315\"with|strong=\"H5921\"fasting|strong=\"H6685\".  \nMy|strong=\"H5921\"prayer|strong=\"H8605\"returned|strong=\"H7725\"into|strong=\"H7725\"my|strong=\"H5921\"own|strong=\"H5315\"bosom|strong=\"H2436\".   \n"},{"number":14,"text":"I|strong=\"H1980\"behaved|strong=\"H1980\"myself|strong=\"H1980\"as|strong=\"H1980\"though it|strong=\"H1980\"had been|strong=\"H7817\"my|strong=\"H1980\"friend|strong=\"H7453\"or|strong=\"H7453\"my|strong=\"H1980\"brother|strong=\"H7453\".  \nI|strong=\"H1980\"bowed|strong=\"H7817\"down|strong=\"H7817\"mourning|strong=\"H6937\", as|strong=\"H1980\"one|strong=\"H7453\"who|strong=\"H1980\"mourns his|strong=\"H1980\"mother.   \n"},{"number":15,"text":"But|strong=\"H3808\"in|strong=\"H5921\"my|strong=\"H5921\"adversity|strong=\"H6761\", they|strong=\"H3808\"rejoiced|strong=\"H8055\", and|strong=\"H3045\"gathered themselves|strong=\"H3045\"together|strong=\"H5921\".  \nThe|strong=\"H5921\"attackers gathered themselves|strong=\"H3045\"together|strong=\"H5921\"against|strong=\"H5921\"me|strong=\"H5921\", and|strong=\"H3045\"I|strong=\"H5921\"didn’t know|strong=\"H3045\"it|strong=\"H5921\".  \nThey|strong=\"H3808\"tore|strong=\"H7167\"at|strong=\"H5921\"me|strong=\"H5921\", and|strong=\"H3045\"didn’t cease|strong=\"H1826\".   \n"},{"number":16,"text":"Like|strong=\"H5921\"the|strong=\"H5921\"profane mockers|strong=\"H3934\"in|strong=\"H5921\"feasts|strong=\"H4580\",  \nthey|strong=\"H5921\"gnashed|strong=\"H2786\"their|strong=\"H5921\"teeth|strong=\"H8127\"at|strong=\"H5921\"me|strong=\"H5921\".   \n"},{"number":17,"text":"Lord, how|strong=\"H4100\"long|strong=\"H4100\"will|strong=\"H5315\"you|strong=\"H7725\"look|strong=\"H7200\"on|strong=\"H7200\"?  \nRescue|strong=\"H7725\"my|strong=\"H7200\"soul|strong=\"H5315\"from|strong=\"H7725\"their|strong=\"H7725\"destruction|strong=\"H7722\",  \nmy|strong=\"H7200\"precious life|strong=\"H5315\"from|strong=\"H7725\"the|strong=\"H7200\"lions|strong=\"H3715\".   \n"},{"number":18,"text":"I|strong=\"H1984\"will|strong=\"H5971\"give|strong=\"H3034\"you|strong=\"H3034\"thanks|strong=\"H3034\"in|strong=\"H7227\"the|strong=\"H1984\"great|strong=\"H7227\"assembly|strong=\"H6951\".  \nI|strong=\"H1984\"will|strong=\"H5971\"praise|strong=\"H1984\"you|strong=\"H3034\"among|strong=\"H5971\"many|strong=\"H7227\"people|strong=\"H5971\".   \n"},{"number":19,"text":"Don’t let|strong=\"H8055\"those|strong=\"H8130\"who|strong=\"H8130\"are|strong=\"H5869\"my|strong=\"H8267\"enemies|strong=\"H8130\"wrongfully|strong=\"H8267\"rejoice|strong=\"H8055\"over|strong=\"H5869\"me|strong=\"H8130\";  \nneither let|strong=\"H8055\"those|strong=\"H8130\"who|strong=\"H8130\"hate|strong=\"H8130\"me|strong=\"H8130\"without|strong=\"H2600\"a|strong=\"H3068\"cause|strong=\"H2600\"wink|strong=\"H7169\"their eyes|strong=\"H5869\".   \n"},{"number":20,"text":"For|strong=\"H3588\"they|strong=\"H3588\"don’t speak|strong=\"H1696\"peace|strong=\"H7965\",  \nbut|strong=\"H3588\"they|strong=\"H3588\"devise|strong=\"H2803\"deceitful|strong=\"H4820\"words|strong=\"H1697\"against|strong=\"H5921\"those|strong=\"H5921\"who|strong=\"H3588\"are|strong=\"H1697\"quiet|strong=\"H7282\"in|strong=\"H5921\"the|strong=\"H5921\"land.   \n"},{"number":21,"text":"Yes|strong=\"H7200\", they|strong=\"H5921\"opened|strong=\"H7337\"their|strong=\"H7200\"mouth|strong=\"H6310\"wide|strong=\"H7337\"against|strong=\"H5921\"me|strong=\"H7200\".  \nThey|strong=\"H5921\"said|strong=\"H6310\", “Aha|strong=\"H1889\"! Aha|strong=\"H1889\"! Our|strong=\"H7200\"eye|strong=\"H5869\"has|strong=\"H5869\"seen|strong=\"H7200\"it|strong=\"H5921\"!”   \n"},{"number":22,"text":"You|strong=\"H4480\"have|strong=\"H3068\"seen|strong=\"H7200\"it|strong=\"H7200\", LORD|strong=\"H3068\". Don’t keep|strong=\"H2790\"silent|strong=\"H2790\".  \nLord|strong=\"H3068\", don’t be|strong=\"H3068\"far|strong=\"H7368\"from|strong=\"H4480\"me|strong=\"H7200\".   \n"},{"number":23,"text":"Wake|strong=\"H6974\"up|strong=\"H5782\"! Rise up|strong=\"H5782\"to|strong=\"H4941\"defend|strong=\"H7379\"me|strong=\"H4941\", my|strong=\"H5782\"God!  \nMy|strong=\"H5782\"Lord, contend|strong=\"H7379\"for|strong=\"H4941\"me|strong=\"H4941\"!   \n"},{"number":24,"text":"Vindicate|strong=\"H8199\"me|strong=\"H8055\", LORD|strong=\"H3068\"my|strong=\"H3068\"God|strong=\"H3068\", according to|strong=\"H3068\"your|strong=\"H3068\"righteousness|strong=\"H6664\".  \nDon’t let|strong=\"H8055\"them|strong=\"H8055\"gloat|strong=\"H8055\"over|strong=\"H3068\"me|strong=\"H8055\".   \n"},{"number":25,"text":"Don’t let|strong=\"H5315\"them|strong=\"H1104\"say in|strong=\"H5315\"their|strong=\"H1104\"heart|strong=\"H3820\", “Aha|strong=\"H1889\"! That|strong=\"H5315\"’s the|strong=\"H1104\"way we|strong=\"H3068\"want|strong=\"H5315\"it|strong=\"H5315\"!”  \nDon’t let|strong=\"H5315\"them|strong=\"H1104\"say, “We|strong=\"H5315\"have swallowed|strong=\"H1104\"him|strong=\"H5315\"up|strong=\"H1104\"!”   \n"},{"number":26,"text":"Let|strong=\"H8056\"them|strong=\"H5921\"be|strong=\"H7451\"disappointed and|strong=\"H1431\"confounded|strong=\"H2659\"together|strong=\"H3162\"who|strong=\"H3639\"rejoice|strong=\"H8056\"at|strong=\"H5921\"my|strong=\"H5921\"calamity|strong=\"H7451\".  \nLet|strong=\"H8056\"them|strong=\"H5921\"be|strong=\"H7451\"clothed|strong=\"H3847\"with|strong=\"H3847\"shame|strong=\"H1322\"and|strong=\"H1431\"dishonor|strong=\"H3639\"who|strong=\"H3639\"magnify|strong=\"H1431\"themselves|strong=\"H1431\"against|strong=\"H5921\"me|strong=\"H5921\".   \n"},{"number":27,"text":"Let|strong=\"H8055\"those who|strong=\"H3068\"favor|strong=\"H7965\"my|strong=\"H3068\"righteous|strong=\"H6664\"cause|strong=\"H6664\"shout|strong=\"H7442\"for|strong=\"H7442\"joy|strong=\"H7442\"and|strong=\"H3068\"be|strong=\"H3068\"glad|strong=\"H8055\".  \nYes, let|strong=\"H8055\"them|strong=\"H8055\"say continually|strong=\"H8548\", “May|strong=\"H3068\"the|strong=\"H3068\"LORD|strong=\"H3068\"be|strong=\"H3068\"magnified|strong=\"H1431\",  \nwho|strong=\"H3068\"has|strong=\"H3068\"pleasure|strong=\"H2655\"in|strong=\"H3068\"the|strong=\"H3068\"prosperity|strong=\"H7965\"of|strong=\"H3068\"his|strong=\"H3068\"servant|strong=\"H5650\"!”   \n"},{"number":28,"text":"My|strong=\"H3605\"tongue|strong=\"H3956\"shall|strong=\"H3117\"talk|strong=\"H1897\"about|strong=\"H3117\"your|strong=\"H3605\"righteousness|strong=\"H6664\"and|strong=\"H3117\"about|strong=\"H3117\"your|strong=\"H3605\"praise|strong=\"H8416\"all|strong=\"H3605\"day|strong=\"H3117\"long|strong=\"H3117\".   \n"}]}
