{"verses":[{"number":1,"text":"LORD|strong=\"H3068\", who|strong=\"H4310\"shall|strong=\"H3068\"dwell|strong=\"H7931\"in|strong=\"H3068\"your|strong=\"H3068\"sanctuary|strong=\"H6944\"?  \nWho|strong=\"H4310\"shall|strong=\"H3068\"live|strong=\"H7931\"on|strong=\"H3068\"your|strong=\"H3068\"holy|strong=\"H6944\"hill|strong=\"H2022\"?   \n"},{"number":2,"text":"He|strong=\"H1980\"who|strong=\"H6664\"walks|strong=\"H1980\"blamelessly|strong=\"H8549\"and|strong=\"H1980\"does|strong=\"H6466\"what|strong=\"H6664\"is|strong=\"H6664\"right|strong=\"H6664\",  \nand|strong=\"H1980\"speaks|strong=\"H1696\"truth in|strong=\"H1980\"his|strong=\"H1980\"heart|strong=\"H3824\";   \n"},{"number":3,"text":"he|strong=\"H6213\"who|strong=\"H7138\"doesn’t slander|strong=\"H7270\"with|strong=\"H6213\"his|strong=\"H5375\"tongue|strong=\"H3956\",  \nnor|strong=\"H3808\"does|strong=\"H6213\"evil|strong=\"H7451\"to|strong=\"H6213\"his|strong=\"H5375\"friend|strong=\"H7453\",  \nnor|strong=\"H3808\"casts slurs against|strong=\"H5921\"his|strong=\"H5375\"fellow|strong=\"H7453\"man|strong=\"H7451\";   \n"},{"number":4,"text":"in|strong=\"H3068\"whose eyes|strong=\"H5869\"a|strong=\"H3068\"vile man is|strong=\"H3068\"despised|strong=\"H3988\",  \nbut|strong=\"H3808\"who|strong=\"H3068\"honors|strong=\"H3513\"those who|strong=\"H3068\"fear|strong=\"H3373\"the|strong=\"H3068\"LORD|strong=\"H3068\";  \nhe|strong=\"H3068\"who|strong=\"H3068\"keeps an|strong=\"H7650\"oath|strong=\"H7650\"even|strong=\"H3808\"when|strong=\"H3068\"it|strong=\"H3808\"hurts, and|strong=\"H3068\"doesn’t change|strong=\"H4171\";   \n"},{"number":5,"text":"he|strong=\"H6213\"who|strong=\"H6213\"doesn’t lend|strong=\"H5414\"out|strong=\"H5414\"his|strong=\"H5414\"money|strong=\"H3701\"for|strong=\"H5921\"usury|strong=\"H5392\",  \nnor|strong=\"H3808\"take|strong=\"H3947\"a|strong=\"H3068\"bribe|strong=\"H7810\"against|strong=\"H5921\"the|strong=\"H5921\"innocent|strong=\"H5355\".  \nHe|strong=\"H6213\"who|strong=\"H6213\"do