{"verses":[{"number":1,"text":"When|strong=\"H3318\"Israel|strong=\"H3478\"went|strong=\"H3318\"out|strong=\"H3318\"of|strong=\"H1004\"Egypt|strong=\"H4714\",  \nthe|strong=\"H3318\"house|strong=\"H1004\"of|strong=\"H1004\"Jacob|strong=\"H3290\"from|strong=\"H3318\"a|strong=\"H3068\"people|strong=\"H5971\"of|strong=\"H1004\"foreign language|strong=\"H3937\",   \n"},{"number":2,"text":"Judah|strong=\"H3063\"became|strong=\"H1961\"his|strong=\"H3478\"sanctuary|strong=\"H6944\",  \nIsrael|strong=\"H3478\"his|strong=\"H3478\"dominion|strong=\"H4475\".   \n"},{"number":3,"text":"The|strong=\"H7200\"sea|strong=\"H3220\"saw|strong=\"H7200\"it|strong=\"H7200\", and|strong=\"H7200\"fled|strong=\"H5127\".  \nThe|strong=\"H7200\"Jordan|strong=\"H3383\"was|strong=\"H3220\"driven|strong=\"H5437\"back|strong=\"H5437\".   \n"},{"number":4,"text":"The|strong=\"H1121\"mountains|strong=\"H2022\"skipped|strong=\"H7540\"like|strong=\"H7540\"rams,  \nthe|strong=\"H1121\"little hills|strong=\"H1389\"like|strong=\"H7540\"lambs|strong=\"H1121\".   \n"},{"number":5,"text":"What|strong=\"H4100\"was|strong=\"H3220\"it|strong=\"H3588\", you|strong=\"H3588\"sea|strong=\"H3220\", that|strong=\"H3588\"you|strong=\"H3588\"fled|strong=\"H5127\"?  \nYou|strong=\"H3588\"Jordan|strong=\"H3383\", that|strong=\"H3588\"you|strong=\"H3588\"turned|strong=\"H5437\"back|strong=\"H5437\"?   \n"},{"number":6,"text":"You|strong=\"H2022\"mountains|strong=\"H2022\", that|strong=\"H1121\"you|strong=\"H2022\"skipped|strong=\"H7540\"like|strong=\"H7540\"rams?  \nYou|strong=\"H2022\"little hills|strong=\"H1389\", like|strong=\"H7540\"lambs|strong=\"H1121\"?   \n"},{"number":7,"text":"Tremble|strong=\"H2342\", you|strong=\"H6440\"earth, at|strong=\"H6440\"the|strong=\"H6440\"presence|strong=\"H6440\"of|strong=\"H6440\"the|strong=\"H6440\"Lord,  \nat|strong=\"H6440\"the|strong=\"H6440\"presence|strong=\"H6440\"of|strong=\"H6440\"the|strong=\"H6440\"God of|strong=\"H6440\"Jacob|strong=\"H3290\",   \n"},{"number":8,"text":"who|strong=\"H6697\"turned|strong=\"H2015\"the|strong=\"H2015\"rock|strong=\"H6697\"into|strong=\"H2015\"a|strong=\"H3068\"pool|strong=\"H4325\"of|strong=\"H4325\"water|strong=\"H4325\",  \nthe|strong=\"H2015\"flint|strong=\"H2496\"into|strong=\"H2015\"a|strong=\"H3068\"spring|strong=\"H4599\"of|strong=\"H4325\"waters|strong=\"H4325\".   \n"}]}
