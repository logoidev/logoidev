l|strong=\"H3068\"bless|strong=\"H1288\"those|strong=\"H5973\"who|strong=\"H3068\"fear|strong=\"H3373\"the|strong=\"H3068\"LORD|strong=\"H3068\",  \nboth small|strong=\"H6996\"and|strong=\"H3068\"great|strong=\"H1419\".   \n"},{"number":14,"text":"May|strong=\"H3068\"the|strong=\"H5921\"LORD|strong=\"H3068\"increase|strong=\"H3254\"you|strong=\"H5921\"more|strong=\"H3254\"and|strong=\"H1121\"more|strong=\"H3254\",  \nyou|strong=\"H5921\"and|strong=\"H1121\"your|strong=\"H3068\"children|strong=\"H1121\".   \n"},{"number":15,"text":"Blessed|strong=\"H1288\"are|strong=\"H8064\"you|strong=\"H6213\"by|strong=\"H3068\"the|strong=\"H6213\"LORD|strong=\"H3068\",  \nwho|strong=\"H3068\"made|strong=\"H6213\"heaven|strong=\"H8064\"and|strong=\"H3068\"earth|strong=\"H8064\".   \n"},{"number":16,"text":"The|strong=\"H5414\"heavens|strong=\"H8064\"are|strong=\"H1121\"the|strong=\"H5414\"LORD|strong=\"H3068\"’s heavens|strong=\"H8064\",  \nbut|strong=\"H3068\"he|strong=\"H3068\"has|strong=\"H3068\"given|strong=\"H5414\"the|strong=\"H5414\"earth|strong=\"H8064\"to|strong=\"H3068\"the|strong=\"H5414\"children|strong=\"H1121\"of|strong=\"H1121\"men|strong=\"H1121\".   \n"},{"number":17,"text":"The|strong=\"H3605\"dead|strong=\"H4191\"don’t praise|strong=\"H1984\"the|strong=\"H3605\"LORD|strong=\"H3068\",  \nnor|strong=\"H3808\"any|strong=\"H3605\"who|strong=\"H3605\"go|strong=\"H3381\"down|strong=\"H3381\"into|strong=\"H3381\"silence|strong=\"H1745\",   \n"},{"number":18,"text":"but|strong=\"H6258\"we|strong=\"H3068\"will|strong=\"H5704\"bless|strong=\"H1288\"the|strong=\"H1288\"LORD|strong=\"H3068\",  \nfrom|strong=\"H5704\"this|strong=\"H6258\"time|strong=\"H6258\"forward and|strong=\"H5769\"forever|strong=\"H5769\"more|strong=\"H5704\".  \nPraise|strong=\"H1984\"the|strong=\"H1288\"LORD|strong=\"H3068\"!   \n"}]}
