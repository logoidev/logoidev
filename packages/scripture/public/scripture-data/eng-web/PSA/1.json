{"verses":[{"number":1,"text":"Blessed is|strong=\"H1870\"the|strong=\"H1870\"man|strong=\"H7563\"who|strong=\"H3427\"doesn’t walk|strong=\"H1980\"in|strong=\"H3427\"the|strong=\"H1870\"counsel|strong=\"H6098\"of|strong=\"H3427\"the|strong=\"H1870\"wicked|strong=\"H7563\",  \nnor|strong=\"H3808\"stand|strong=\"H5975\"on|strong=\"H1980\"the|strong=\"H1870\"path|strong=\"H1870\"of|strong=\"H3427\"sinners|strong=\"H2400\",  \nnor|strong=\"H3808\"sit|strong=\"H3427\"in|strong=\"H3427\"the|strong=\"H1870\"seat|strong=\"H4186\"of|strong=\"H3427\"scoffers;   \n"},{"number":2,"text":"but|strong=\"H3588\"his|strong=\"H3068\"delight|strong=\"H2656\"is|strong=\"H3068\"in|strong=\"H3068\"the|strong=\"H3588\"LORD|strong=\"H3068\"’s law|strong=\"H8451\".  \nOn|strong=\"H3068\"his|strong=\"H3068\"law|strong=\"H8451\"he|strong=\"H3588\"meditates|strong=\"H1897\"day|strong=\"H3119\"and|strong=\"H3068\"night|strong=\"H3915\".   \n"},{"number":3,"text":"He|strong=\"H6213\"will|strong=\"H1961\"be|strong=\"H1961\"like|strong=\"H1961\"a|strong=\"H3068\"tree|strong=\"H6086\"planted|strong=\"H8362\"by|strong=\"H5921\"the|strong=\"H3605\"streams|strong=\"H6388\"of|strong=\"H4325\"water|strong=\"H4325\",  \nthat|strong=\"H3605\"produces|strong=\"H5414\"its|strong=\"H3605\"fruit|strong=\"H6529\"in|strong=\"H5921\"its|strong=\"H3605\"season|strong=\"H6256\",  \nwhose|strong=\"H3605\"leaf|strong=\"H5929\"also|strong=\"H6213\"does|strong=\"H6213\"not|strong=\"H3808\"wither|strong=\"H5034\".  \nWhatever|strong=\"H3605\"he|strong=\"H6213\"does|strong=\"H6213\"shall|strong=\"H3808\"prosper|strong=\"H6743\".   \n"},{"number":4,"text":"The|strong=\"H3588\"wicked|strong=\"H7563\"are|strong=\"H7563\"not|strong=\"H3808\"so|strong=\"H3651\",  \nbut|strong=\"H3588\"are|strong=\"H7563\"like|strong=\"H3651\"the|strong=\"H3588\"chaff|strong=\"H4671\"which|strong=\"H7307\"the|strong=\"H3588\"wind|strong=\"H7307\"drives|strong=\"H5086\"away|strong=\"H5086\".   \n"},{"number":5,"text":"Therefore|strong=\"H3651\"the|strong=\"H5921\"wicked|strong=\"H7563\"shall|strong=\"H5712\"not|strong=\"H3808\"stand|strong=\"H6965\"in|strong=\"H5921\"the|strong=\"H5921\"judgment|strong=\"H4941\",  \nnor|strong=\"H3808\"sinners|strong=\"H2400\"in|strong=\"H5921\"the|strong=\"H5921\"congregation|strong=\"H5712\"of|strong=\"H5921\"the|strong=\"H5921\"righteous|strong=\"H6662\".   \n"},{"number":6,"text":"For|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"knows|strong=\"H3045\"the|strong=\"H3588\"way|strong=\"H1870\"of|strong=\"H3068\"the|strong=\"H3588\"righteous|strong=\"H6662\",  \nbut|strong=\"H3588\"the|strong=\"H3588\"way|strong=\"H1870\"of|strong=\"H3068\"the|strong=\"H3588\"wicked|strong=\"H7563\"shall|strong=\"H3068\"perish.   \n"}]}
