rong=\"H3117\"are|strong=\"H3117\"spent|strong=\"H3615\"without|strong=\"H4480\"hope|strong=\"H8615\".   \n"},{"number":7,"text":"Oh remember|strong=\"H2142\"that|strong=\"H3588\"my|strong=\"H7200\"life|strong=\"H2416\"is|strong=\"H2896\"a|strong=\"H3068\"breath|strong=\"H7307\".  \nMy|strong=\"H7200\"eye|strong=\"H5869\"will|strong=\"H5869\"no|strong=\"H3808\"more|strong=\"H3808\"see|strong=\"H7200\"good|strong=\"H2896\".   \n"},{"number":8,"text":"The|strong=\"H3808\"eye|strong=\"H5869\"of|strong=\"H5869\"him|strong=\"H5869\"who|strong=\"H7210\"sees|strong=\"H7210\"me|strong=\"H5869\"will|strong=\"H5869\"see|strong=\"H5869\"me|strong=\"H5869\"no|strong=\"H3808\"more|strong=\"H3808\".  \nYour|strong=\"H3808\"eyes|strong=\"H5869\"will|strong=\"H5869\"be|strong=\"H3808\"on|strong=\"H5869\"me|strong=\"H5869\", but|strong=\"H3808\"I|strong=\"H3808\"will|strong=\"H5869\"not|strong=\"H3808\"be|strong=\"H3808\".   \n"},{"number":9,"text":"As|strong=\"H3651\"the|strong=\"H5927\"cloud|strong=\"H6051\"is|strong=\"H3651\"consumed|strong=\"H3615\"and|strong=\"H3212\"vanishes|strong=\"H3615\"away|strong=\"H3212\",  \nso|strong=\"H3651\"he|strong=\"H3651\"who|strong=\"H3808\"goes|strong=\"H5927\"down|strong=\"H3381\"to|strong=\"H3381\"Sheol|strong=\"H7585\"will|strong=\"H3808\"come|strong=\"H5927\"up|strong=\"H5927\"no|strong=\"H3808\"more|strong=\"H3651\".   \n"},{"number":10,"text":"He|strong=\"H1004\"will|strong=\"H1004\"return|strong=\"H7725\"no|strong=\"H3808\"more|strong=\"H5750\"to|strong=\"H7725\"his|strong=\"H7725\"house|strong=\"H1004\",  \nneither|strong=\"H3808\"will|strong=\"H1004\"his|strong=\"H7725\"place|strong=\"H4725\"know|strong=\"H5234\"him|strong=\"H7725\"any|strong=\"H5750\"more|strong=\"H5750\".   \n"},{"number":11,"text":"“Therefore|strong=\"H1571\"I|strong=\"H5315\"will|strong=\"H1571\"not|strong=\"H3808\"keep|strong=\"H2820\"silent|strong=\"H6310\".  \nI|strong=\"H5315\"will|strong=\"H1571\"speak|strong=\"H1696\"in|strong=\"H5315\"the|strong=\"H1696\"an