{"verses":[{"number":1,"text":"Job again|strong=\"H3254\"took|strong=\"H5375\"up|strong=\"H5375\"his|strong=\"H5375\"parable|strong=\"H4912\", and|strong=\"H3254\"said,   \n"},{"number":2,"text":"“As|strong=\"H5315\"God lives|strong=\"H5315\", who|strong=\"H5315\"has|strong=\"H5315\"taken|strong=\"H5493\"away|strong=\"H5493\"my|strong=\"H5493\"right|strong=\"H4941\",  \nthe|strong=\"H5493\"Almighty|strong=\"H7706\", who|strong=\"H5315\"has|strong=\"H5315\"made|strong=\"H4843\"my|strong=\"H5493\"soul|strong=\"H5315\"bitter|strong=\"H4843\""},{"number":3,"text":"(for|strong=\"H3588\"the|strong=\"H3605\"length of|strong=\"H7307\"my|strong=\"H3605\"life|strong=\"H5750\"is|strong=\"H3605\"still|strong=\"H5750\"in|strong=\"H5750\"me|strong=\"H3588\",  \nand|strong=\"H7307\"the|strong=\"H3605\"spirit|strong=\"H7307\"of|strong=\"H7307\"God is|strong=\"H3605\"in|strong=\"H5750\"my|strong=\"H3605\"nostrils);   \n"},{"number":4,"text":"surely my|strong=\"H1696\"lips|strong=\"H8193\"will|strong=\"H3956\"not|strong=\"H1696\"speak|strong=\"H1696\"unrighteousness|strong=\"H5766\",  \nneither will|strong=\"H3956\"my|strong=\"H1696\"tongue|strong=\"H3956\"utter|strong=\"H1696\"deceit|strong=\"H7423\".   \n"},{"number":5,"text":"Far|strong=\"H5704\"be|strong=\"H3808\"it|strong=\"H2486\"from|strong=\"H4480\"me|strong=\"H4480\"that|strong=\"H4480\"I|strong=\"H5704\"should justify|strong=\"H6663\"you|strong=\"H5704\".  \nUntil|strong=\"H5704\"I|strong=\"H5704\"die|strong=\"H1478\"I|strong=\"H5704\"will|strong=\"H3808\"not|strong=\"H3808\"put|strong=\"H5493\"away|strong=\"H5493\"my|strong=\"H5493\"integrity|strong=\"H8538\"from|strong=\"H4480\"me|strong=\"H4480\".   \n"},{"number":6,"text":"I|strong=\"H3117\"hold|strong=\"H2388\"fast|strong=\"H2388\"to|strong=\"H3117\"my|strong=\"H2388\"righteousness|strong=\"H6666\", and|strong=\"H3117\"will|strong=\"H3808\"not|strong=\"H3808\"let|strong=\"H7503\"it|strong=\"H3117\"go|strong=\"H7503\".  \nMy|strong=\"H2388\"heart|strong=\"H3824\"will|strong=\"H3808\"not|strong=\"H3808\"reproach|strong=\"H2778\"me|strong=\"H2388\"so|strong=\"H3808\"long|strong=\"H3117\"as|strong=\"H3117\"I|strong=\"H3117\"live|strong=\"H3117\".   \n"},{"number":7,"text":"“Let|strong=\"H1961\"my|strong=\"H6965\"enemy be|strong=\"H1961\"as|strong=\"H1961\"the|strong=\"H6965\"wicked|strong=\"H7563\".  \nLet|strong=\"H1961\"him|strong=\"H1961\"who|strong=\"H7563\"rises|strong=\"H6965\"up|strong=\"H6965\"against|strong=\"H6965\"me|strong=\"H1961\"be|strong=\"H1961\"as|strong=\"H1961\"the|strong=\"H6965\"unrighteous|strong=\"H5767\".   \n"},{"number":8,"text":"For|strong=\"H3588\"what|strong=\"H4100\"is|strong=\"H4100\"the|strong=\"H3588\"hope|strong=\"H8615\"of|strong=\"H5315\"the|strong=\"H3588\"godless|strong=\"H2611\", when|strong=\"H3588\"he|strong=\"H3588\"is|strong=\"H4100\"cut|strong=\"H1214\"off|strong=\"H1214\",  \nwhen|strong=\"H3588\"God takes|strong=\"H1214\"away|strong=\"H7953\"his|strong=\"H3588\"life|strong=\"H5315\"?   \n"},{"number":9,"text":"Will|strong=\"H8085\"God hear|strong=\"H8085\"his|strong=\"H8085\"cry|strong=\"H6818\"when|strong=\"H3588\"trouble|strong=\"H6869\"comes on|strong=\"H5921\"him|strong=\"H5921\"?   \n"},{"number":10,"text":"Will|strong=\"H7121\"he|strong=\"H3605\"delight|strong=\"H6026\"himself|strong=\"H7121\"in|strong=\"H5921\"the|strong=\"H3605\"Almighty|strong=\"H7706\",  \nand|strong=\"H6256\"call|strong=\"H7121\"on|strong=\"H5921\"God at|strong=\"H5921\"all|strong=\"H3605\"times|strong=\"H6256\"?   \n"},{"number":11,"text":"I|strong=\"H3808\"will|strong=\"H3027\"teach|strong=\"H3384\"you|strong=\"H5973\"about|strong=\"H3027\"the|strong=\"H3027\"hand|strong=\"H3027\"of|strong=\"H3027\"God|strong=\"H3808\".  \nI|strong=\"H3808\"will|strong=\"H3027\"not|strong=\"H3808\"conceal|strong=\"H3582\"that|strong=\"H3027\"which is|strong=\"H3027\"with|strong=\"H5973\"the|strong=\"H3027\"Almighty|strong=\"H7706\".   \n"},{"number":12,"text":"Behold|strong=\"H2005\", all|strong=\"H3605\"of|strong=\"H3605\"you|strong=\"H3605\"have|strong=\"H3605\"seen|strong=\"H2372\"it|strong=\"H2088\"yourselves|strong=\"H3605\";  \nwhy|strong=\"H4100\"then|strong=\"H2088\"have|strong=\"H3605\"you|strong=\"H3605\"become altogether|strong=\"H3605\"vain|strong=\"H1892\"?   \n"},{"number":13,"text":"“This|strong=\"H2088\"is|strong=\"H2088\"the|strong=\"H3947\"portion|strong=\"H2506\"of|strong=\"H5159\"a|strong=\"H3068\"wicked|strong=\"H7563\"man|strong=\"H7563\"with|strong=\"H5973\"God,  \nthe|strong=\"H3947\"heritage|strong=\"H5159\"of|strong=\"H5159\"oppressors|strong=\"H6184\", which|strong=\"H2088\"they|strong=\"H3947\"receive|strong=\"H3947\"from|strong=\"H3947\"the|strong=\"H3947\"Almighty|strong=\"H7706\".   \n"},{"number":14,"text":"If|strong=\"H1121\"his|strong=\"H3808\"children|strong=\"H1121\"are|strong=\"H1121\"multiplied|strong=\"H7235\", it|strong=\"H3808\"is|strong=\"H1121\"for|strong=\"H1121\"the|strong=\"H3808\"sword|strong=\"H2719\".  \nHis|strong=\"H3808\"offspring|strong=\"H6631\"will|strong=\"H2719\"not|strong=\"H3808\"be|strong=\"H3808\"satisfied|strong=\"H7646\"with|strong=\"H7646\"bread|strong=\"H3899\".   \n"},{"number":15,"text":"Those who|strong=\"H8300\"remain|strong=\"H8300\"of|strong=\"H4194\"him|strong=\"H6912\"will|strong=\"H3808\"be|strong=\"H3808\"buried|strong=\"H6912\"in|strong=\"H6912\"death|strong=\"H4194\".  \nHis|strong=\"H3808\"widows will|strong=\"H3808\"make no|strong=\"H3808\"lamentation|strong=\"H1058\".   \n"},{"number":16,"text":"Though he|strong=\"H3701\"heap|strong=\"H6651\"up|strong=\"H6651\"silver|strong=\"H3701\"as|strong=\"H3701\"the|strong=\"H3559\"dust|strong=\"H6083\",  \nand|strong=\"H3701\"prepare|strong=\"H3559\"clothing as|strong=\"H3701\"the|strong=\"H3559\"clay|strong=\"H2563\";   \n"},{"number":17,"text":"he|strong=\"H3701\"may prepare|strong=\"H3559\"it|strong=\"H3559\", but|strong=\"H6662\"the|strong=\"H3559\"just|strong=\"H6662\"will|strong=\"H6662\"put|strong=\"H3847\"it|strong=\"H3559\"on|strong=\"H3847\",  \nand|strong=\"H3701\"the|strong=\"H3559\"innocent|strong=\"H5355\"will|strong=\"H6662\"divide|strong=\"H2505\"the|strong=\"H3559\"silver|strong=\"H3701\".   \n"},{"number":18,"text":"He|strong=\"H6213\"builds|strong=\"H1129\"his|strong=\"H6213\"house|strong=\"H1004\"as|strong=\"H6213\"the|strong=\"H6213\"moth|strong=\"H6211\",  \nas|strong=\"H6213\"a|strong=\"H3068\"booth|strong=\"H5521\"which|strong=\"H1004\"the|strong=\"H6213\"watchman|strong=\"H5341\"makes|strong=\"H6213\".   \n"},{"number":19,"text":"He|strong=\"H3808\"lies|strong=\"H7901\"down|strong=\"H7901\"rich|strong=\"H6223\", but|strong=\"H3808\"he|strong=\"H3808\"will|strong=\"H5869\"not|strong=\"H3808\"do|strong=\"H5869\"so|strong=\"H3808\"again.  \nHe|strong=\"H3808\"opens|strong=\"H6491\"his|strong=\"H3808\"eyes|strong=\"H5869\", and|strong=\"H5869\"he|strong=\"H3808\"is|strong=\"H5869\"not|strong=\"H3808\".   \n"},{"number":20,"text":"Terrors|strong=\"H1091\"overtake|strong=\"H5381\"him|strong=\"H5381\"like waters|strong=\"H4325\".  \nA|strong=\"H3068\"storm|strong=\"H5492\"steals|strong=\"H1589\"him|strong=\"H5381\"away|strong=\"H1589\"in|strong=\"H4325\"the|strong=\"H3915\"night|strong=\"H3915\".   \n"},{"number":21,"text":"The|strong=\"H5375\"east|strong=\"H6921\"wind|strong=\"H6921\"carries|strong=\"H5375\"him|strong=\"H5375\"away|strong=\"H5375\", and|strong=\"H3212\"he|strong=\"H3212\"departs.  \nIt|strong=\"H5375\"sweeps him|strong=\"H5375\"out|strong=\"H3212\"of|strong=\"H4725\"his|strong=\"H5375\"place|strong=\"H4725\".   \n"},{"number":22,"text":"For|strong=\"H5921\"it|strong=\"H5921\"hurls at|strong=\"H5921\"him|strong=\"H5921\", and|strong=\"H3027\"does|strong=\"H3808\"not|strong=\"H3808\"spare|strong=\"H2550\",  \nas|strong=\"H5921\"he|strong=\"H3027\"flees|strong=\"H1272\"away|strong=\"H7993\"from|strong=\"H5921\"his|strong=\"H5921\"hand|strong=\"H3027\".   \n"},{"number":23,"text":"Men will|strong=\"H4725\"clap|strong=\"H5606\"their|strong=\"H5921\"hands|strong=\"H3709\"at|strong=\"H5921\"him|strong=\"H5921\",  \nand|strong=\"H4725\"will|strong=\"H4725\"hiss|strong=\"H8319\"him|strong=\"H5921\"out|strong=\"H5921\"of|strong=\"H3709\"his|strong=\"H5921\"place|strong=\"H4725\".   \n"}]}
