{"verses":[{"number":1,"text":"Then|strong=\"H6030\"Bildad|strong=\"H1085\"the|strong=\"H6030\"Shuhite|strong=\"H7747\"answered|strong=\"H6030\",   \n"},{"number":2,"text":"“Dominion|strong=\"H4910\"and|strong=\"H6213\"fear|strong=\"H6343\"are|strong=\"H6213\"with|strong=\"H5973\"him|strong=\"H6213\".  \nHe|strong=\"H6213\"makes|strong=\"H6213\"peace|strong=\"H7965\"in|strong=\"H6213\"his|strong=\"H6213\"high|strong=\"H4791\"places|strong=\"H4791\".   \n"},{"number":3,"text":"Can|strong=\"H4310\"his|strong=\"H5921\"armies|strong=\"H3808\"be|strong=\"H3426\"counted|strong=\"H4557\"?  \nOn|strong=\"H5921\"whom|strong=\"H4310\"does|strong=\"H3808\"his|strong=\"H5921\"light not|strong=\"H3808\"arise|strong=\"H6965\"?   \n"},{"number":4,"text":"How|strong=\"H4100\"then|strong=\"H4100\"can|strong=\"H4100\"man be just|strong=\"H6663\"with|strong=\"H5973\"God?  \nOr how|strong=\"H4100\"can|strong=\"H4100\"he|strong=\"H4100\"who|strong=\"H4100\"is|strong=\"H4100\"born|strong=\"H3205\"of|strong=\"H3205\"a|strong=\"H3068\"woman|strong=\"H3205\"be clean|strong=\"H2135\"?   \n"},{"number":5,"text":"Behold|strong=\"H2005\", even|strong=\"H5704\"the|strong=\"H5704\"moon|strong=\"H3394\"has|strong=\"H5869\"no|strong=\"H3808\"brightness,  \nand|strong=\"H5869\"the|strong=\"H5704\"stars|strong=\"H3556\"are|strong=\"H5869\"not|strong=\"H3808\"pure|strong=\"H2141\"in|strong=\"H5869\"his|strong=\"H3808\"sight|strong=\"H5869\";   \n"},{"number":6,"text":"How|strong=\"H3588\"much less|strong=\"H3588\"man|strong=\"H1121\", who|strong=\"H1121\"is|strong=\"H1121\"a|strong=\"H3068\"worm|strong=\"H7415\",  \nand|strong=\"H1121\"the|strong=\"H3588\"son|strong=\"H1121\"of|strong=\"H1121\"man|strong=\"H1121\", who|strong=\"H1121\"is|strong=\"H1121\"a|strong=\"H3068\"worm|strong=\"H7415\"!”   \n"}]}
