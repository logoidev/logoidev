{"verses":[{"number":1,"text":"Moreover the|strong=\"H3068\"LORD|strong=\"H3068\"answered|strong=\"H6030\"Job,   \n"},{"number":2,"text":"“Shall he who|strong=\"H7706\"argues contend|strong=\"H7378\"with|strong=\"H5973\"the|strong=\"H5973\"Almighty|strong=\"H7706\"?  \nHe who|strong=\"H7706\"argues with|strong=\"H5973\"God, let him|strong=\"H5973\"answer|strong=\"H6030\"it|strong=\"H5973\".”   \n"},{"number":3,"text":"Then|strong=\"H6030\"Job answered|strong=\"H6030\"the|strong=\"H3068\"LORD|strong=\"H3068\",   \n"},{"number":4,"text":"“Behold|strong=\"H2005\", I|strong=\"H2005\"am|strong=\"H2005\"of|strong=\"H3027\"small|strong=\"H7043\"account. What|strong=\"H4100\"will|strong=\"H3027\"I|strong=\"H2005\"answer|strong=\"H7725\"you|strong=\"H7725\"?  \nI|strong=\"H2005\"lay|strong=\"H7760\"my|strong=\"H7760\"hand|strong=\"H3027\"on|strong=\"H7760\"my|strong=\"H7760\"mouth|strong=\"H6310\".   \n"},{"number":5,"text":"I|strong=\"H3808\"have|strong=\"H1696\"spoken|strong=\"H1696\"once|strong=\"H3254\", and|strong=\"H6030\"I|strong=\"H3808\"will|strong=\"H3808\"not|strong=\"H3808\"answer|strong=\"H6030\";  \nYes, twice|strong=\"H8147\", but|strong=\"H3808\"I|strong=\"H3808\"will|strong=\"H3808\"proceed|strong=\"H3254\"no|strong=\"H3808\"further|strong=\"H3254\".”   \n"},{"number":6,"text":"Then|strong=\"H6030\"the|strong=\"H3068\"LORD|strong=\"H3068\"answered|strong=\"H6030\"Job out|strong=\"H4480\"of|strong=\"H3068\"the|strong=\"H3068\"whirlwind|strong=\"H5591\":   \n"},{"number":7,"text":"“Now|strong=\"H4994\"brace yourself|strong=\"H3045\"like a|strong=\"H3068\"man|strong=\"H1397\".  \nI|strong=\"H3045\"will|strong=\"H1397\"question|strong=\"H7592\"you|strong=\"H3045\", and|strong=\"H3045\"you|strong=\"H3045\"will|strong=\"H1397\"answer|strong=\"H3045\"me|strong=\"H4994\".   \n"},{"number":8,"text":"Will|strong=\"H4616\"you|strong=\"H6663\"even annul|strong=\"H6565\"my|strong=\"H6565\"judgment|strong=\"H4941\"?  \nWill|strong=\"H4616\"you|strong=\"H6663\"condemn|strong=\"H7561\"me|strong=\"H4941\", that|strong=\"H4616\"you|strong=\"H6663\"may|strong=\"H4616\"be justified|strong=\"H6663\"?   \n"},{"number":9,"text":"Or|strong=\"H2220\"do you|strong=\"H3644\"have|strong=\"H2220\"an|strong=\"H3644\"arm|strong=\"H2220\"like|strong=\"H3644\"God?  \nCan|strong=\"H2220\"you|strong=\"H3644\"thunder|strong=\"H6963\"with|strong=\"H6963\"a|strong=\"H3068\"voice|strong=\"H6963\"like|strong=\"H3644\"him|strong=\"H6963\"?   \n"},{"number":10,"text":"“Now|strong=\"H4994\"deck|strong=\"H5710\"yourself|strong=\"H3847\"with|strong=\"H3847\"excellency|strong=\"H1347\"and|strong=\"H1935\"dignity|strong=\"H1363\".  \nArray|strong=\"H3847\"yourself|strong=\"H3847\"with|strong=\"H3847\"honor|strong=\"H1935\"and|strong=\"H1935\"majesty|strong=\"H1926\".   \n"},{"number":11,"text":"Pour|strong=\"H6327\"out|strong=\"H7200\"the|strong=\"H3605\"fury|strong=\"H5678\"of|strong=\"H3605\"your|strong=\"H3605\"anger|strong=\"H5678\".  \nLook|strong=\"H7200\"at|strong=\"H7200\"everyone|strong=\"H3605\"who|strong=\"H3605\"is|strong=\"H3605\"proud|strong=\"H1343\", and|strong=\"H7200\"bring|strong=\"H8213\"him|strong=\"H7200\"low|strong=\"H8213\".   \n"},{"number":12,"text":"Look|strong=\"H7200\"at|strong=\"H7200\"everyone|strong=\"H3605\"who|strong=\"H3605\"is|strong=\"H7563\"proud|strong=\"H1343\", and|strong=\"H7200\"humble|strong=\"H3665\"him|strong=\"H7200\".  \nCrush|strong=\"H1915\"the|strong=\"H3605\"wicked|strong=\"H7563\"in|strong=\"H7200\"their|strong=\"H3605\"place|strong=\"H8478\".   \n"},{"number":13,"text":"Hide|strong=\"H2934\"them|strong=\"H6440\"in|strong=\"H6440\"the|strong=\"H6440\"dust|strong=\"H6083\"together|strong=\"H3162\".  \nBind|strong=\"H2280\"their|strong=\"H6440\"faces|strong=\"H6440\"in|strong=\"H6440\"the|strong=\"H6440\"hidden|strong=\"H2934\"place.   \n"},{"number":14,"text":"Then|strong=\"H1571\"I|strong=\"H3588\"will|strong=\"H1571\"also|strong=\"H1571\"admit to|strong=\"H3588\"you|strong=\"H3588\"that|strong=\"H3588\"your|strong=\"H3588\"own right|strong=\"H3225\"hand|strong=\"H3225\"can|strong=\"H3225\"save|strong=\"H3467\"you|strong=\"H3588\".   \n"},{"number":15,"text":"“See|strong=\"H2009\"now|strong=\"H4994\"behemoth, which|strong=\"H2682\"I|strong=\"H2009\"made|strong=\"H6213\"as|strong=\"H6213\"well|strong=\"H5973\"as|strong=\"H6213\"you|strong=\"H6213\".  \nHe|strong=\"H6213\"eats grass|strong=\"H2682\"as|strong=\"H6213\"an|strong=\"H6213\"ox|strong=\"H1241\".   \n"},{"number":16,"text":"Look|strong=\"H2009\"now|strong=\"H4994\", his|strong=\"H2009\"strength|strong=\"H3581\"is|strong=\"H2009\"in|strong=\"H4994\"his|strong=\"H2009\"thighs.  \nHis|strong=\"H2009\"force|strong=\"H3581\"is|strong=\"H2009\"in|strong=\"H4994\"the|strong=\"H2009\"muscles|strong=\"H8306\"of|strong=\"H3581\"his|strong=\"H2009\"belly.   \n"},{"number":17,"text":"He|strong=\"H2654\"moves his|strong=\"H2654\"tail|strong=\"H2180\"like|strong=\"H3644\"a|strong=\"H3068\"cedar.  \nThe|strong=\"H3644\"sinews|strong=\"H1517\"of|strong=\"H3644\"his|strong=\"H2654\"thighs|strong=\"H6344\"are|strong=\"H6344\"knit|strong=\"H8276\"together|strong=\"H8276\".   \n"},{"number":18,"text":"His bones|strong=\"H6106\"are|strong=\"H6106\"like tubes of|strong=\"H6106\"bronze|strong=\"H5154\".  \nHis limbs|strong=\"H1634\"are|strong=\"H6106\"like bars|strong=\"H4300\"of|strong=\"H6106\"iron|strong=\"H1270\".   \n"},{"number":19,"text":"He|strong=\"H1931\"is|strong=\"H1931\"the|strong=\"H6213\"chief|strong=\"H7225\"of|strong=\"H1870\"the|strong=\"H6213\"ways|strong=\"H1870\"of|strong=\"H1870\"God.  \nHe|strong=\"H1931\"who|strong=\"H1931\"made|strong=\"H6213\"him|strong=\"H6213\"gives him|strong=\"H6213\"his|strong=\"H6213\"sword|strong=\"H2719\".   \n"},{"number":20,"text":"Surely|strong=\"H3588\"the|strong=\"H3605\"mountains|strong=\"H2022\"produce food for|strong=\"H3588\"him|strong=\"H3605\",  \nwhere|strong=\"H8033\"all|strong=\"H3605\"the|strong=\"H3605\"animals|strong=\"H2416\"of|strong=\"H2022\"the|strong=\"H3605\"field|strong=\"H7704\"play|strong=\"H7832\".   \n"},{"number":21,"text":"He|strong=\"H8478\"lies|strong=\"H7901\"under|strong=\"H8478\"the|strong=\"H8478\"lotus|strong=\"H6628\"trees|strong=\"H6628\",  \nin|strong=\"H7901\"the|strong=\"H8478\"covert|strong=\"H5643\"of|strong=\"H8478\"the|strong=\"H8478\"reed|strong=\"H7070\", and|strong=\"H7901\"the|strong=\"H8478\"marsh|strong=\"H1207\".   \n"},{"number":22,"text":"The|strong=\"H5437\"lotuses cover|strong=\"H5526\"him|strong=\"H5526\"with|strong=\"H5158\"their|strong=\"H5437\"shade.  \nThe|strong=\"H5437\"willows|strong=\"H6155\"of|strong=\"H5158\"the|strong=\"H5437\"brook|strong=\"H5158\"surround|strong=\"H5437\"him|strong=\"H5526\".   \n"},{"number":23,"text":"Behold|strong=\"H2005\", if|strong=\"H3588\"a|strong=\"H3068\"river|strong=\"H5104\"overflows, he|strong=\"H3588\"doesn’t tremble|strong=\"H2648\".  \nHe|strong=\"H3588\"is|strong=\"H6310\"confident, though|strong=\"H3588\"the|strong=\"H3588\"Jordan|strong=\"H3383\"swells even|strong=\"H3588\"to|strong=\"H6310\"his|strong=\"H3588\"mouth|strong=\"H6310\".   \n"},{"number":24,"text":"Shall|strong=\"H5869\"any|strong=\"H3947\"take|strong=\"H3947\"him|strong=\"H3947\"when he|strong=\"H3947\"is|strong=\"H5869\"on|strong=\"H5869\"the|strong=\"H3947\"watch|strong=\"H5869\",  \nor pierce|strong=\"H5344\"through|strong=\"H5344\"his|strong=\"H3947\"nose with|strong=\"H5869\"a|strong=\"H3068\"snare|strong=\"H4170\"?   \n"}]}
