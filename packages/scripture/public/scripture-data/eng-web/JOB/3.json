{"verses":[{"number":1,"text":"After|strong=\"H3117\"this|strong=\"H3651\"Job opened|strong=\"H6605\"his|strong=\"H7043\"mouth|strong=\"H6310\", and|strong=\"H3117\"cursed|strong=\"H7043\"the|strong=\"H3117\"day|strong=\"H3117\"of|strong=\"H3117\"his|strong=\"H7043\"birth.  \n"},{"number":2,"text":"Job answered|strong=\"H6030\":   \n"},{"number":3,"text":"“Let the|strong=\"H3205\"day|strong=\"H3117\"perish in|strong=\"H3117\"which|strong=\"H3117\"I|strong=\"H3117\"was|strong=\"H3117\"born|strong=\"H3205\",  \nthe|strong=\"H3205\"night|strong=\"H3915\"which|strong=\"H3117\"said, ‘There|strong=\"H3117\"is|strong=\"H3117\"a|strong=\"H3068\"boy|strong=\"H1397\"conceived.’   \n"},{"number":4,"text":"Let|strong=\"H1961\"that|strong=\"H3117\"day|strong=\"H3117\"be|strong=\"H1961\"darkness|strong=\"H2822\".  \nDon’t let|strong=\"H1961\"God from|strong=\"H5921\"above|strong=\"H4605\"seek|strong=\"H1875\"for|strong=\"H5921\"it|strong=\"H1931\",  \nneither let|strong=\"H1961\"the|strong=\"H5921\"light|strong=\"H5105\"shine|strong=\"H3313\"on|strong=\"H5921\"it|strong=\"H1931\".   \n"},{"number":5,"text":"Let|strong=\"H1350\"darkness|strong=\"H2822\"and|strong=\"H3117\"the|strong=\"H5921\"shadow|strong=\"H6757\"of|strong=\"H3117\"death|strong=\"H6757\"claim|strong=\"H1350\"it|strong=\"H5921\"for|strong=\"H5921\"their|strong=\"H5921\"own.  \nLet|strong=\"H1350\"a|strong=\"H3068\"cloud|strong=\"H6053\"dwell|strong=\"H7931\"on|strong=\"H5921\"it|strong=\"H5921\".  \nLet|strong=\"H1350\"all|strong=\"H5921\"that|strong=\"H3117\"makes the|strong=\"H5921\"day|strong=\"H3117\"black|strong=\"H6757\"terrify|strong=\"H1204\"it|strong=\"H5921\".   \n"},{"number":6,"text":"As|strong=\"H3117\"for|strong=\"H3117\"that|strong=\"H3117\"night|strong=\"H3915\", let thick darkness seize|strong=\"H3947\"on|strong=\"H3117\"it|strong=\"H1931\".  \nLet it|strong=\"H1931\"not|strong=\"H3947\"rejoice|strong=\"H2302\"among the|strong=\"H3947\"days|strong=\"H3117\"of|strong=\"H3117\"the|strong=\"H3947\"year|strong=\"H8141\".  \nLet it|strong=\"H1931\"not|strong=\"H3947\"come into|strong=\"H3947\"the|strong=\"H3947\"number|strong=\"H4557\"of|strong=\"H3117\"the|strong=\"H3947\"months|strong=\"H3391\".   \n"},{"number":7,"text":"Behold|strong=\"H2009\", let|strong=\"H1961\"that|strong=\"H1931\"night|strong=\"H3915\"be|strong=\"H1961\"barren|strong=\"H1565\".  \nLet|strong=\"H1961\"no|strong=\"H1961\"joyful|strong=\"H7445\"voice|strong=\"H7445\"come|strong=\"H1961\"therein.   \n"},{"number":8,"text":"Let them|strong=\"H3117\"curse|strong=\"H5344\"it|strong=\"H3117\"who curse|strong=\"H5344\"the|strong=\"H3117\"day|strong=\"H3117\",  \nwho are|strong=\"H3117\"ready|strong=\"H6264\"to|strong=\"H3117\"rouse|strong=\"H5782\"up|strong=\"H5782\"leviathan|strong=\"H3882\".   \n"},{"number":9,"text":"Let|strong=\"H6079\"the|strong=\"H7200\"stars|strong=\"H3556\"of|strong=\"H3556\"its twilight|strong=\"H5399\"be|strong=\"H6079\"dark|strong=\"H2821\".  \nLet|strong=\"H6079\"it|strong=\"H7200\"look|strong=\"H7200\"for|strong=\"H6960\"light|strong=\"H7837\", but|strong=\"H7200\"have|strong=\"H7200\"none,  \nneither let|strong=\"H6079\"it|strong=\"H7200\"see|strong=\"H7200\"the|strong=\"H7200\"eyelids|strong=\"H6079\"of|strong=\"H3556\"the|strong=\"H7200\"morning|strong=\"H7837\",   \n"},{"number":10,"text":"because|strong=\"H3588\"it|strong=\"H3588\"didn’t shut|strong=\"H5462\"up|strong=\"H5462\"the|strong=\"H3588\"doors|strong=\"H1817\"of|strong=\"H5869\"my|strong=\"H5641\"mother’s womb,  \nnor|strong=\"H3808\"did|strong=\"H3808\"it|strong=\"H3588\"hide|strong=\"H5641\"trouble|strong=\"H5999\"from|strong=\"H5869\"my|strong=\"H5641\"eyes|strong=\"H5869\".   \n"},{"number":11,"text":"“Why|strong=\"H4100\"didn’t I|strong=\"H3808\"die|strong=\"H4191\"from|strong=\"H3318\"the|strong=\"H3318\"womb|strong=\"H7358\"?  \nWhy|strong=\"H4100\"didn’t I|strong=\"H3808\"give up|strong=\"H3318\"the|strong=\"H3318\"spirit when|strong=\"H3318\"my|strong=\"H3318\"mother|strong=\"H7358\"bore me|strong=\"H3318\"?   \n"},{"number":12,"text":"Why|strong=\"H4100\"did|strong=\"H4100\"the|strong=\"H3588\"knees|strong=\"H1290\"receive|strong=\"H6923\"me|strong=\"H6923\"?  \nOr|strong=\"H3588\"why|strong=\"H4100\"the|strong=\"H3588\"breast|strong=\"H7699\", that|strong=\"H3588\"I|strong=\"H3588\"should|strong=\"H4100\"nurse|strong=\"H3243\"?   \n"},{"number":13,"text":"For|strong=\"H3588\"now|strong=\"H6258\"I|strong=\"H3588\"should|strong=\"H3588\"have|strong=\"H6258\"lain|strong=\"H7901\"down|strong=\"H7901\"and|strong=\"H8252\"been|strong=\"H8252\"quiet|strong=\"H8252\".  \nI|strong=\"H3588\"should|strong=\"H3588\"have|strong=\"H6258\"slept|strong=\"H7901\", then|strong=\"H6258\"I|strong=\"H3588\"would have|strong=\"H6258\"been|strong=\"H8252\"at|strong=\"H5117\"rest|strong=\"H5117\",   \n"},{"number":14,"text":"with|strong=\"H5973\"kings|strong=\"H4428\"and|strong=\"H4428\"counselors|strong=\"H3289\"of|strong=\"H4428\"the|strong=\"H1129\"earth,  \nwho|strong=\"H4428\"built|strong=\"H1129\"up|strong=\"H1129\"waste|strong=\"H2723\"places|strong=\"H2723\"for|strong=\"H4428\"themselves|strong=\"H1129\";   \n"},{"number":15,"text":"or|strong=\"H3701\"with|strong=\"H5973\"princes|strong=\"H8269\"who|strong=\"H1992\"had|strong=\"H8269\"gold|strong=\"H2091\",  \nwho|strong=\"H1992\"filled|strong=\"H4390\"their|strong=\"H1992\"houses|strong=\"H1004\"with|strong=\"H5973\"silver|strong=\"H3701\";   \n"},{"number":16,"text":"or|strong=\"H3808\"as|strong=\"H1961\"a|strong=\"H3068\"hidden|strong=\"H2934\"untimely|strong=\"H2934\"birth|strong=\"H5309\"I|strong=\"H7200\"had|strong=\"H1961\"not|strong=\"H3808\"been|strong=\"H1961\",  \nas|strong=\"H1961\"infants|strong=\"H5768\"who|strong=\"H3808\"never|strong=\"H3808\"saw|strong=\"H7200\"light.   \n"},{"number":17,"text":"There|strong=\"H8033\"the|strong=\"H8033\"wicked|strong=\"H7563\"cease|strong=\"H2308\"from|strong=\"H5117\"troubling|strong=\"H7267\".  \nThere|strong=\"H8033\"the|strong=\"H8033\"weary|strong=\"H3019\"are|strong=\"H7563\"at|strong=\"H8033\"rest|strong=\"H5117\".   \n"},{"number":18,"text":"There the|strong=\"H8085\"prisoners are|strong=\"H3808\"at|strong=\"H3808\"ease|strong=\"H7599\"together|strong=\"H3162\".  \nThey|strong=\"H3808\"don’t hear|strong=\"H8085\"the|strong=\"H8085\"voice|strong=\"H6963\"of|strong=\"H6963\"the|strong=\"H8085\"taskmaster|strong=\"H5065\".   \n"},{"number":19,"text":"The|strong=\"H5650\"small|strong=\"H6996\"and|strong=\"H1419\"the|strong=\"H5650\"great|strong=\"H1419\"are|strong=\"H5650\"there|strong=\"H8033\".  \nThe|strong=\"H5650\"servant|strong=\"H5650\"is|strong=\"H1931\"free|strong=\"H2670\"from|strong=\"H5650\"his|strong=\"H1931\"master.   \n"},{"number":20,"text":"“Why|strong=\"H4100\"is|strong=\"H4100\"light given|strong=\"H5414\"to|strong=\"H5414\"him|strong=\"H5414\"who|strong=\"H5315\"is|strong=\"H4100\"in|strong=\"H5315\"misery|strong=\"H6001\",  \nlife|strong=\"H5315\"to|strong=\"H5414\"the|strong=\"H5414\"bitter|strong=\"H4751\"in|strong=\"H5315\"soul|strong=\"H5315\",   \n"},{"number":21,"text":"who long|strong=\"H2442\"for|strong=\"H2442\"death|strong=\"H4194\", but it|strong=\"H2658\"doesn’t come;  \nand|strong=\"H4194\"dig|strong=\"H2658\"for|strong=\"H2442\"it|strong=\"H2658\"more than for|strong=\"H2442\"hidden|strong=\"H4301\"treasures|strong=\"H4301\",   \n"},{"number":22,"text":"who|strong=\"H4672\"rejoice|strong=\"H8055\"exceedingly|strong=\"H1524\",  \nand|strong=\"H8055\"are|strong=\"H6913\"glad|strong=\"H8055\", when|strong=\"H3588\"they|strong=\"H3588\"can find|strong=\"H4672\"the|strong=\"H3588\"grave|strong=\"H6913\"?   \n"},{"number":23,"text":"Why is|strong=\"H1870\"light given to|strong=\"H1870\"a|strong=\"H3068\"man|strong=\"H1397\"whose|strong=\"H1397\"way|strong=\"H1870\"is|strong=\"H1870\"hidden|strong=\"H5641\",  \nwhom|strong=\"H1397\"God has|strong=\"H1157\"hedged|strong=\"H5526\"in|strong=\"H1870\"?   \n"},{"number":24,"text":"For|strong=\"H3588\"my|strong=\"H3588\"sighing comes|strong=\"H6440\"before|strong=\"H6440\"I|strong=\"H3588\"eat|strong=\"H3899\".  \nMy|strong=\"H3588\"groanings are|strong=\"H4325\"poured|strong=\"H5413\"out|strong=\"H5413\"like|strong=\"H5413\"water|strong=\"H4325\".   \n"},{"number":25,"text":"For|strong=\"H3588\"the|strong=\"H3588\"thing|strong=\"H3588\"which|strong=\"H3588\"I|strong=\"H3588\"fear|strong=\"H6343\"comes on me|strong=\"H3588\",  \nthat|strong=\"H3588\"which|strong=\"H3588\"I|strong=\"H3588\"am afraid|strong=\"H6342\"of|strong=\"H6343\"comes to|strong=\"H3588\"me|strong=\"H3588\".   \n"},{"number":26,"text":"I|strong=\"H3808\"am not|strong=\"H3808\"at|strong=\"H3808\"ease|strong=\"H7951\", neither|strong=\"H3808\"am I|strong=\"H3808\"quiet|strong=\"H8252\", neither|strong=\"H3808\"do I|strong=\"H3808\"have|strong=\"H3808\"rest|strong=\"H5117\";  \nbut|strong=\"H3808\"trouble|strong=\"H7267\"comes.”   \n"}]}
