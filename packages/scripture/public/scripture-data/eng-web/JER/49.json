els|strong=\"H1581\"will|strong=\"H3068\"be|strong=\"H1961\"a|strong=\"H3068\"booty|strong=\"H7998\",  \nand|strong=\"H3068\"the|strong=\"H3605\"multitude|strong=\"H1995\"of|strong=\"H3068\"their|strong=\"H3605\"livestock|strong=\"H4735\"a|strong=\"H3068\"plunder|strong=\"H7998\".  \nI|strong=\"H3068\"will|strong=\"H3068\"scatter|strong=\"H2219\"to|strong=\"H3068\"all|strong=\"H3605\"winds|strong=\"H7307\"those|strong=\"H3605\"who|strong=\"H3605\"have|strong=\"H1961\"the|strong=\"H3605\"corners|strong=\"H6285\"of|strong=\"H3068\"their|strong=\"H3605\"beards cut|strong=\"H7112\"off|strong=\"H7112\";  \nand|strong=\"H3068\"I|strong=\"H3068\"will|strong=\"H3068\"bring|strong=\"H1961\"their|strong=\"H3605\"calamity from|strong=\"H6285\"every|strong=\"H3605\"side|strong=\"H6285\"of|strong=\"H3068\"them|strong=\"H1961\",”  \nsays|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\".   \n"},{"number":33,"text":"Hazor|strong=\"H2674\"will|strong=\"H1961\"be|strong=\"H1961\"a|strong=\"H3068\"dwelling|strong=\"H3427\"place|strong=\"H1961\"of|strong=\"H1121\"jackals|strong=\"H8577\",  \na|strong=\"H3068\"desolation|strong=\"H8077\"forever|strong=\"H5769\".  \nNo|strong=\"H3808\"man|strong=\"H1121\"will|strong=\"H1961\"dwell|strong=\"H3427\"there|strong=\"H8033\",  \nneither|strong=\"H3808\"will|strong=\"H1961\"any|strong=\"H1961\"son|strong=\"H1121\"of|strong=\"H1121\"man|strong=\"H1121\"live|strong=\"H3427\"therein|strong=\"H8033\".”   \n"},{"number":34,"text":"The|strong=\"H3068\"LORD|strong=\"H3068\"’s word|strong=\"H1697\"that|strong=\"H3068\"came|strong=\"H1961\"to|strong=\"H3068\"Jeremiah|strong=\"H3414\"the|strong=\"H3068\"prophet|strong=\"H5030\"concerning|strong=\"H1697\"Elam|strong=\"H5867\", in|strong=\"H3068\"the|strong=\"H3068\"beginning|strong=\"H7225\"of|strong=\"H4428\"the|strong=\"H3068\"reign|strong=\"H4438\"of|strong=\"H4428\"Zedekiah|strong=\"H6667\"king|strong=\"H4428\"of|strong=\"H4428\"Judah|strong=\"H3063\", saying|strong=\"H1697\",  \n"},{"number":35,"text":"“The|strong=\"H3541\"LORD|strong=\"H3068\"of|strong=\"H3068\"Armies|strong=\"H6635\"says|strong=\"H3541\":  \n‘Behold|strong=\"H2005\", I|strong=\"H2005\"will|strong=\"H3068\"break|strong=\"H7665\"the|strong=\"H3541\"bow|strong=\"H7198\"of|strong=\"H3068\"Elam|strong=\"H5867\",  \nthe|strong=\"H3541\"chief|strong=\"H7225\"of|strong=\"H3068\"their|strong=\"H3068\"might|strong=\"H1369\".   \n"},{"number":36,"text":"I|strong=\"H3808\"will|strong=\"H1961\"bring|strong=\"H5080\"on|strong=\"H1961\"Elam|strong=\"H5867\"the|strong=\"H3605\"four winds|strong=\"H7307\"from|strong=\"H1471\"the|strong=\"H3605\"four quarters|strong=\"H7098\"of|strong=\"H7307\"the|strong=\"H3605\"sky|strong=\"H8064\",  \nand|strong=\"H8064\"will|strong=\"H1961\"scatter|strong=\"H2219\"them|strong=\"H1961\"toward all|strong=\"H3605\"those|strong=\"H3605\"winds|strong=\"H7307\".  \nThere|strong=\"H8033\"will|strong=\"H1961\"be|strong=\"H1961\"no|strong=\"H3808\"nation|strong=\"H1471\"where|strong=\"H8033\"the|strong=\"H3605\"outcasts|strong=\"H5080\"of|strong=\"H7307\"Elam|strong=\"H5867\"will|strong=\"H1961\"not|strong=\"H3808\"come|strong=\"H1961\".   \n"},{"number":37,"text":"I|strong=\"H5704\"will|strong=\"H3068\"cause Elam|strong=\"H5867\"to|strong=\"H5704\"be|strong=\"H3068\"dismayed|strong=\"H2865\"before|strong=\"H6440\"their|strong=\"H3068\"enemies,  \nand|strong=\"H3068\"before|strong=\"H6440\"those|strong=\"H5921\"who|strong=\"H3068\"seek|strong=\"H1245\"their|strong=\"H3068\"life|strong=\"H5315\".  \nI|strong=\"H5704\"will|strong=\"H3068\"bring|strong=\"H7451\"evil|strong=\"H7451\"on|strong=\"H5921\"them|strong=\"H5921\", even|strong=\"H5704\"my|strong=\"H3068\"fierce|strong=\"H2740\"anger|strong=\"H6440\",’ says|strong=\"H5002\"the|strong=\"H6440\"LORD|strong=\"H3068\";  \n‘and|strong=\"H3068\"I|strong=\"H5704\"will|strong=\"H3068\"send|strong=\"H7971\"the|strong=\"H6440\"sword|strong=\"H2719\"after|strong=\"H5921\"them|strong=\"H5921\",  \nuntil|strong=\"H5704\"I|strong=\"H5704\"have|strong=\"H3068\"consumed|strong=\"H3615\"them|strong=\"H5921\".   \n"},{"number":38,"text":"I|strong=\"H7760\"will|strong=\"H3068\"set|strong=\"H7760\"my|strong=\"H3068\"throne|strong=\"H3678\"in|strong=\"H3068\"Elam|strong=\"H5867\",  \nand|strong=\"H3068\"will|strong=\"H3068\"destroy from|strong=\"H3068\"there|strong=\"H8033\"king|strong=\"H4428\"and|strong=\"H3068\"princes|strong=\"H8269\",’ says|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\".   \n"},{"number":39,"text":"‘But|strong=\"H1961\"it|strong=\"H7725\"will|strong=\"H3068\"happen|strong=\"H1961\"in|strong=\"H3068\"the|strong=\"H5002\"latter days|strong=\"H3117\"that|strong=\"H3117\"I|strong=\"H3117\"will|strong=\"H3068\"reverse|strong=\"H7725\"the|strong=\"H5002\"captivity|strong=\"H7622\"of|strong=\"H3068\"Elam|strong=\"H5867\",’ says|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\".”   \n"}]}
