e|strong=\"H1210\".   \n"},{"number":33,"text":"Gladness|strong=\"H8057\"and|strong=\"H8057\"joy|strong=\"H8057\"is|strong=\"H4124\"taken away|strong=\"H7673\"from|strong=\"H7673\"the|strong=\"H3808\"fruitful|strong=\"H3759\"field|strong=\"H3759\"and|strong=\"H8057\"from|strong=\"H7673\"the|strong=\"H3808\"land|strong=\"H3759\"of|strong=\"H3196\"Moab|strong=\"H4124\".  \nI|strong=\"H3808\"have|strong=\"H3808\"caused wine|strong=\"H3196\"to|strong=\"H3808\"cease|strong=\"H7673\"from|strong=\"H7673\"the|strong=\"H3808\"wine|strong=\"H3196\"presses|strong=\"H3342\".  \nNo|strong=\"H3808\"one|strong=\"H3808\"will|strong=\"H3808\"tread|strong=\"H1869\"with|strong=\"H1869\"shouting|strong=\"H1959\".  \nThe|strong=\"H3808\"shouting|strong=\"H1959\"will|strong=\"H3808\"be|strong=\"H3808\"no|strong=\"H3808\"shouting|strong=\"H1959\".   \n"},{"number":34,"text":"From|strong=\"H5704\"the|strong=\"H3588\"cry|strong=\"H2201\"of|strong=\"H6963\"Heshbon|strong=\"H2809\"even|strong=\"H1571\"to|strong=\"H5704\"Elealeh,  \neven|strong=\"H1571\"to|strong=\"H5704\"Jahaz|strong=\"H3096\"they|strong=\"H3588\"have|strong=\"H1961\"uttered|strong=\"H5414\"their|strong=\"H5414\"voice|strong=\"H6963\",  \nfrom|strong=\"H5704\"Zoar|strong=\"H6820\"even|strong=\"H1571\"to|strong=\"H5704\"Horonaim|strong=\"H2773\", to|strong=\"H5704\"Eglath Shelishiyah;  \nfor|strong=\"H3588\"the|strong=\"H3588\"waters|strong=\"H4325\"of|strong=\"H6963\"Nimrim|strong=\"H5249\"will|strong=\"H1961\"also|strong=\"H1571\"become|strong=\"H1961\"desolate|strong=\"H4923\".   \n"},{"number":35,"text":"Moreover I|strong=\"H3068\"will|strong=\"H3068\"cause to|strong=\"H3068\"cease|strong=\"H7673\"in|strong=\"H3068\"Moab|strong=\"H4124\",” says|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\",  \n“him|strong=\"H5927\"who|strong=\"H3068\"offers|strong=\"H5927\"in|strong=\"H3068\"the|strong=\"H5002\"high|strong=\"H1116\"place|strong=\"H1116\",  \nand|strong=\"H3068\"him|strong=\"H5927\"who|strong=\"H3068\"burns|strong=\"H6999\"incense|strong=\"H6999\"to|strong=\"H3068\"his|strong=\"H3068\"gods.   \n"},{"number":36,"text":"Therefore|strong=\"H3651\"my|strong=\"H5921\"heart|strong=\"H3820\"sounds for|strong=\"H5921\"Moab|strong=\"H4124\"like|strong=\"H3651\"flutes|strong=\"H2485\",  \nand|strong=\"H6213\"my|strong=\"H5921\"heart|strong=\"H3820\"sounds like|strong=\"H3651\"flutes|strong=\"H2485\"for|strong=\"H5921\"the|strong=\"H5921\"men|strong=\"H6213\"of|strong=\"H5921\"Kir Heres.  \nTherefore|strong=\"H3651\"the|strong=\"H5921\"abundance|strong=\"H3502\"that|strong=\"H3651\"he|strong=\"H3651\"has|strong=\"H3820\"gotten|strong=\"H6213\"has|strong=\"H3820\"perished.   \n"},{"number":37,"text":"For|strong=\"H3588\"every|strong=\"H3605\"head|strong=\"H7218\"is|strong=\"H3027\"bald|strong=\"H7144\",  \nand|strong=\"H3027\"every|strong=\"H3605\"beard|strong=\"H2206\"clipped|strong=\"H1639\".  \nThere|strong=\"H3605\"are|strong=\"H3027\"cuttings|strong=\"H1417\"on|strong=\"H5921\"all|strong=\"H3605\"the|strong=\"H3605\"hands|strong=\"H3027\",  \nand|strong=\"H3027\"sackcloth|strong=\"H8242\"on|strong=\"H5921\"the|strong=\"H3605\"waist|strong=\"H4975\".   \n"},{"number":38,"text":"On|strong=\"H5921\"all|strong=\"H3605\"the|strong=\"H3605\"housetops|strong=\"H1406\"of|strong=\"H3068\"Moab|strong=\"H4124\",  \nand|strong=\"H3068\"in|strong=\"H5921\"its|strong=\"H3605\"streets|strong=\"H7339\", there|strong=\"H3605\"is|strong=\"H3068\"lamentation|strong=\"H4553\"everywhere|strong=\"H3605\";  \nfor|strong=\"H3588\"I|strong=\"H3588\"have|strong=\"H3068\"broken|strong=\"H7665\"Moab|strong=\"H4124\"like|strong=\"H4124\"a|strong=\"H3068\"vessel|strong=\"H3627\"in|strong=\"H5921\"which|strong=\"H3068\"no|strong=\"H3605\"one|strong=\"H3605\"delights|strong=\"H2656\",” says|strong=\"H5002\"the|strong=\"H3605\"LORD|strong=\"H3068\".   \n"},{"number":39,"text":"“How it|strong=\"H5439\"is|strong=\"H3605\"broken|strong=\"H2865\"down|strong=\"H2865\"!  \nHow they|strong=\"H3605\"wail|strong=\"H3213\"!  \nHow Moab|strong=\"H4124\"has|strong=\"H1961\"turned|strong=\"H6437\"the|strong=\"H3605\"back|strong=\"H6437\"with|strong=\"H3605\"shame!  \nSo|strong=\"H1961\"will|strong=\"H1961\"Moab|strong=\"H4124\"become|strong=\"H1961\"a|strong=\"H3068\"derision|strong=\"H7814\"and|strong=\"H6437\"a|strong=\"H3068\"terror|strong=\"H4288\"to|strong=\"H1961\"all|strong=\"H3605\"who|strong=\"H3605\"are|strong=\"H1961\"around|strong=\"H5439\"him|strong=\"H3605\".”   \n"},{"number":40,"text":"For|strong=\"H3588\"the|strong=\"H3588\"LORD|strong=\"H3068\"says|strong=\"H3541\": “Behold|strong=\"H2009\", he|strong=\"H3588\"will|strong=\"H3068\"fly|strong=\"H1675\"as|strong=\"H3068\"an|strong=\"H3588\"eagle|strong=\"H5404\",  \nand|strong=\"H3068\"will|strong=\"H3068\"spread|strong=\"H6566\"out|strong=\"H6566\"his|strong=\"H3068\"wings|strong=\"H3671\"against|strong=\"H3068\"Moab|strong=\"H4124\".   \n"},{"number":41,"text":"Kerioth|strong=\"H7152\"is|strong=\"H1931\"taken|strong=\"H3920\",  \nand|strong=\"H3117\"the|strong=\"H3117\"strongholds|strong=\"H4679\"are|strong=\"H3117\"seized|strong=\"H8610\".  \nThe|strong=\"H3117\"heart|strong=\"H3820\"of|strong=\"H3117\"the|strong=\"H3117\"mighty|strong=\"H1368\"men|strong=\"H1368\"of|strong=\"H3117\"Moab|strong=\"H4124\"at|strong=\"H3117\"that|strong=\"H3117\"day|strong=\"H3117\"will|strong=\"H1961\"be|strong=\"H1961\"as|strong=\"H3117\"the|strong=\"H3117\"heart|strong=\"H3820\"of|strong=\"H3117\"a|strong=\"H3068\"woman in|strong=\"H3117\"her|strong=\"H1931\"pangs|strong=\"H6887\".   \n"},{"number":42,"text":"Moab|strong=\"H4124\"will|strong=\"H3068\"be|strong=\"H3068\"destroyed|strong=\"H8045\"from|strong=\"H5921\"being|strong=\"H5971\"a|strong=\"H3068\"people|strong=\"H5971\",  \nbecause|strong=\"H3588\"he|strong=\"H3588\"has|strong=\"H3068\"magnified|strong=\"H1431\"himself|strong=\"H1431\"against|strong=\"H5921\"the|strong=\"H5921\"LORD|strong=\"H3068\".   \n"},{"number":43,"text":"Terror|strong=\"H6343\", the|strong=\"H5002\"pit|strong=\"H6354\", and|strong=\"H3068\"the|strong=\"H5002\"snare|strong=\"H6341\"are|strong=\"H3068\"on|strong=\"H5921\"you|strong=\"H5921\",  \ninhabitant|strong=\"H3427\"of|strong=\"H3068\"Moab|strong=\"H4124\",” says|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\".   \n"},{"number":44,"text":"“He|strong=\"H3588\"who|strong=\"H3068\"flees from|strong=\"H4480\"the|strong=\"H6440\"terror|strong=\"H6343\"will|strong=\"H3068\"fall|strong=\"H5307\"into|strong=\"H5927\"the|strong=\"H6440\"pit|strong=\"H6354\";  \nand|strong=\"H3068\"he|strong=\"H3588\"who|strong=\"H3068\"gets up|strong=\"H5927\"out|strong=\"H4480\"of|strong=\"H3068\"the|strong=\"H6440\"pit|strong=\"H6354\"will|strong=\"H3068\"be|strong=\"H3068\"taken|strong=\"H3920\"in|strong=\"H8141\"the|strong=\"H6440\"snare|strong=\"H6341\",  \nfor|strong=\"H3588\"I|strong=\"H3588\"will|strong=\"H3068\"bring|strong=\"H5927\"on|strong=\"H5307\"him|strong=\"H6440\", even|strong=\"H3588\"on|strong=\"H5307\"Moab|strong=\"H4124\",  \nthe|strong=\"H6440\"year|strong=\"H8141\"of|strong=\"H3068\"their|strong=\"H3068\"visitation|strong=\"H6486\",” says|strong=\"H5002\"the|strong=\"H6440\"LORD|strong=\"H3068\".   \n"},{"number":45,"text":"“Those|strong=\"H1121\"who|strong=\"H1121\"fled|strong=\"H5127\"stand|strong=\"H5975\"without|strong=\"H3588\"strength|strong=\"H3581\"under the|strong=\"H3588\"shadow|strong=\"H6738\"of|strong=\"H1121\"Heshbon|strong=\"H2809\";  \nfor|strong=\"H3588\"a|strong=\"H3068\"fire has|strong=\"H3588\"gone|strong=\"H3318\"out|strong=\"H3318\"of|strong=\"H1121\"Heshbon|strong=\"H2809\",  \nand|strong=\"H1121\"a|strong=\"H3068\"flame|strong=\"H3852\"from|strong=\"H3318\"the|strong=\"H3588\"middle of|strong=\"H1121\"Sihon|strong=\"H5511\",  \nand|strong=\"H1121\"has|strong=\"H3588\"devoured the|strong=\"H3588\"corner|strong=\"H6285\"of|strong=\"H1121\"Moab|strong=\"H4124\",  \nand|strong=\"H1121\"the|strong=\"H3588\"crown|strong=\"H6936\"of|strong=\"H1121\"the|strong=\"H3588\"head|strong=\"H6936\"of|strong=\"H1121\"the|strong=\"H3588\"tumultuous|strong=\"H7588\"ones|strong=\"H1121\".   \n"},{"number":46,"text":"Woe to|strong=\"H1121\"you|strong=\"H3588\", O|strong=\"H3068\"Moab|strong=\"H4124\"!  \nThe|strong=\"H3588\"people|strong=\"H5971\"of|strong=\"H1121\"Chemosh|strong=\"H3645\"are|strong=\"H5971\"undone;  \nfor|strong=\"H3588\"your|strong=\"H3947\"sons|strong=\"H1121\"are|strong=\"H5971\"taken|strong=\"H3947\"away|strong=\"H3947\"captive|strong=\"H7628\",  \nand|strong=\"H1121\"your|strong=\"H3947\"daughters|strong=\"H1323\"into|strong=\"H1323\"captivity|strong=\"H7628\".   \n"},{"number":47,"text":"“Yet|strong=\"H5704\"I|strong=\"H3117\"will|strong=\"H3068\"reverse|strong=\"H7725\"the|strong=\"H5002\"captivity|strong=\"H7622\"of|strong=\"H3068\"Moab|strong=\"H4124\"in|strong=\"H3068\"the|strong=\"H5002\"latter days|strong=\"H3117\",”  \nsays|strong=\"H5002\"the|strong=\"H5002\"LORD|strong=\"H3068\".  \nThus|strong=\"H2008\"far|strong=\"H5704\"is|strong=\"H3068\"the|strong=\"H5002\"judgment|strong=\"H4941\"of|strong=\"H3068\"Moab|strong=\"H4124\".   \n"}]}
