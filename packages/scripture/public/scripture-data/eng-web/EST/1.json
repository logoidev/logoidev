"rule|strong=\"H8323\"his|strong=\"H3605\"own|strong=\"H1961\"house|strong=\"H1004\", speaking|strong=\"H1696\"in|strong=\"H1004\"the|strong=\"H3605\"language|strong=\"H3956\"of|strong=\"H4428\"his|strong=\"H3605\"own|strong=\"H1961\"people|strong=\"H5971\".   \n"}]}
