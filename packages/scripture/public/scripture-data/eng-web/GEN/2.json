ong=\"H1320\"of|strong=\"H6106\"my|strong=\"H3947\"flesh|strong=\"H1320\". She|strong=\"H3588\"will|strong=\"H1320\"be|strong=\"H1320\"called|strong=\"H7121\"‘woman,’ because|strong=\"H3588\"she|strong=\"H3588\"was|strong=\"H1320\"taken|strong=\"H3947\"out|strong=\"H3947\"of|strong=\"H6106\"Man|strong=\"H1320\".”  \n"},{"number":24,"text":"Therefore|strong=\"H3651\"a|strong=\"H3068\"man|strong=\"H1320\"will|strong=\"H1961\"leave|strong=\"H5800\"his|strong=\"H5921\"father and|strong=\"H1320\"his|strong=\"H5921\"mother, and|strong=\"H1320\"will|strong=\"H1961\"join with|strong=\"H5921\"his|strong=\"H5921\"wife, and|strong=\"H1320\"they|strong=\"H3651\"will|strong=\"H1961\"be|strong=\"H1961\"one|strong=\"H1961\"flesh|strong=\"H1320\".  \n"},{"number":25,"text":"The|strong=\"H1961\"man and|strong=\"H8147\"his|strong=\"H1961\"wife were|strong=\"H1961\"both|strong=\"H8147\"naked|strong=\"H6174\", and|strong=\"H8147\"they|strong=\"H3808\"were|strong=\"H1961\"not|strong=\"H3808\"ashamed.   \n"}]}
