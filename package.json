{
  "name": "logoi-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "blog": "pnpm --filter @logoi/blog",
    "scripture": "pnpm --filter @logoi/scripture",
    "scripture:start": "pnpm --filter @logoi/scripture start",
    "scripture:web": "pnpm --filter @logoi/scripture web",
    "scripture:build:web": "pnpm --filter @logoi/scripture build:web",
    "scripture:check": "pnpm --filter @logoi/scripture check",
    "scripture:test": "pnpm --filter @logoi/scripture test",
    "dev": "pnpm --filter @logoi/blog dev",
    "build": "pnpm --filter @logoi/blog build",
    "preview": "pnpm --filter @logoi/blog preview",
    "test": "pnpm --filter @logoi/blog test",
    "lint": "pnpm --filter @logoi/blog lint",
    "format": "pnpm --filter @logoi/blog format",
    "check": "pnpm --filter @logoi/blog check"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
